@model lern.Models.FavoritesViewModel
@{ Layout = "_AccountLayout"; ViewData["Title"] = "علاقه‌مندی‌ها"; }
<div id="favorites-page" class="p-6 bg-gray-50 dark:bg-background-dark">
            <!-- Page header -->
            <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
                <div>
                    <h2 class="text-2xl font-bold text-dark dark:text-light">لیست علاقه‌مندی‌ها</h2>
                    <p class="text-gray-600 dark:text-gray-400">محصولاتی که به لیست علاقه‌مندی‌های خود اضافه کرده‌اید</p>
                </div>
                <div class="mt-4 md:mt-0 flex space-x-3">
                    <button id="favorite-remove-selected" type="button" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-white dark:bg-gray-700 text-dark dark:text-light hover:bg-gray-100 dark:hover:bg-gray-600 border border-gray-200 dark:border-gray-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 me-2" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        حذف انتخاب شده‌ها
                    </button>
                    <button id="favorite-cart-all" type="button" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-primary text-white hover:bg-primary/90 dark:bg-primary-dark dark:hover:bg-primary/80 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 me-2" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd" />
                        </svg>
                        افزودن همه به سبد خرید
                    </button>
                </div>
            </div>

            <!-- Filters and sorting -->
            <div class="bg-white dark:bg-card-dark rounded-xl shadow-soft dark:shadow-soft-dark p-6 mb-6 border border-gray-100 dark:border-gray-700">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div class="md:col-span-2 relative">
                        <label for="filter-category" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">دسته‌بندی</label>
                        <select id="filter-category" class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent dark:bg-gray-700 dark:border-gray-600 dark:text-white appearance-none">
                            <option value="">همه دسته‌بندی‌ها</option>
                            @foreach (var category in Model.Categories) { <option value="@category.Key">@category.Value</option> }
</select>
                        <div class="absolute inset-y-0 top-1/3 end-3 flex items-center pointer-events-none">
                            <svg class="w-4 h-4 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="relative">
                        <label for="filter-price" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">محدوده قیمت</label>
                        <select id="filter-price" class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent dark:bg-gray-700 dark:border-gray-600 dark:text-white appearance-none">
                            <option value="">همه قیمت‌ها</option>
                            <option value="0-500000">زیر 500 هزار تومان</option>
                            <option value="500000-2000000">500 هزار تا 2 میلیون تومان</option>
                            <option value="2000000-5000000">2 تا 5 میلیون تومان</option>
                            <option value="5000000-">بالای 5 میلیون تومان</option>
                        </select>
                        <div class="absolute inset-y-0 top-1/3 end-3 flex items-center pointer-events-none">
                            <svg class="w-4 h-4 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="relative">
                        <label for="filter-sort" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">مرتب‌سازی</label>
                        <select id="filter-sort" class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent dark:bg-gray-700 dark:border-gray-600 dark:text-white appearance-none">
                            <option value="newest">جدیدترین</option>
                            <option value="oldest">قدیمی‌ترین</option>
                            <option value="price_asc">ارزان‌ترین</option>
                            <option value="price_desc">گران‌ترین</option>
                        </select>
                        <div class="absolute inset-y-0 top-1/3 end-3 flex items-center pointer-events-none">
                            <svg class="w-4 h-4 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- List of products -->
            <div class="bg-white dark:bg-card-dark rounded-xl shadow-soft dark:shadow-soft-dark p-6 mb-6 border border-gray-100 dark:border-gray-700">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                        <thead class="bg-gray-50 dark:bg-gray-800">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                <label class="inline-flex items-center">
                                    <input type="checkbox" class="form-checkbox h-5 w-5 text-primary dark:text-primary-dark rounded border-gray-300 dark:border-gray-600 focus:ring-primary dark:focus:ring-primary-dark"
                                           onchange="document.querySelectorAll('tbody input[type=checkbox]').forEach(cb => cb.checked = this.checked)">
                                </label>
                            </th>
                            <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">محصول</th>
                            <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">قیمت</th>
                            <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">وضعیت</th>
                            <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">عملیات</th>
                        </tr>
                        </thead>
                        <tbody class="bg-white dark:bg-card-dark divide-y divide-gray-200 dark:divide-gray-700">
@foreach (var product in Model.Products) { var price = product.HasMultipleOptions ? product.MinPrice : product.FinalPrice;
                        <tr data-cart-variant="@Model.CartOptions.GetValueOrDefault(product.Id)?.VariantId" data-cart-quantity="@Model.CartOptions.GetValueOrDefault(product.Id)?.Quantity" data-favorite-row="@product.Id" data-price="@(price?.ToString(System.Globalization.CultureInfo.InvariantCulture))" data-categories="@string.Join(',', Model.ProductCategories.GetValueOrDefault(product.Id) ?? Array.Empty<int>())">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <label class="inline-flex items-center">
                                    <input type="checkbox" data-favorite-select="@product.Id" aria-label="انتخاب @product.Name" class="form-checkbox h-5 w-5 text-primary dark:text-primary-dark rounded border-gray-300 dark:border-gray-600 focus:ring-primary dark:focus:ring-primary-dark">
                                </label>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0 h-16 w-16">
                                        <img class="h-16 w-16 rounded-md object-contain" src="@(product.PrimaryImageUrl ?? "/assets/images/logo.png")" alt="@product.Name">
                                    </div>
                                    <div class="ms-4">
                                        <div class="text-sm font-medium text-dark dark:text-light"><a href="/product/@product.Id">@product.Name</a></div>
                                        <div class="text-sm text-gray-500 dark:text-gray-400">@(product.HasMultipleOptions ? "دارای گزینه‌های مختلف" : "")</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-dark dark:text-light">@(price.HasValue ? price.Value.ToString("N0") + " تومان" : "تماس بگیرید")</div>
                                
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 py-1 text-xs rounded-full bg-success/10 text-success dark:text-success-dark">@(product.IsAvailable ? "موجود در انبار" : "ناموجود")</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                                <div class="flex space-x-3">
                                    <a href="/product/@product.Id" aria-label="انتخاب گزینه و خرید @product.Name" class="text-primary dark:text-primary-dark hover:text-primary/80 dark:hover:text-primary-dark/80">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                                        </svg>
                                    </a>
                                    <button type="button" data-favorite-id="@product.Id" aria-pressed="true" aria-label="حذف از علاقه‌مندی‌ها" class="text-danger dark:text-danger-dark hover:text-danger/80 dark:hover:text-danger-dark/80">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
}
</tbody></table></div>
<p id="favorite-empty" class="py-6 text-center" hidden>محصولی در این فهرست وجود ندارد.</p>
<div class="mt-6 flex flex-col md:flex-row items-center justify-between"><p id="favorite-page-info" class="text-sm text-gray-700 dark:text-gray-300"></p><div class="flex space-x-1"><button id="favorite-prev" class="px-3 py-1 border rounded-lg">قبلی</button><span id="favorite-page" class="px-3 py-1 rounded-lg bg-primary text-white"></span><button id="favorite-next" class="px-3 py-1 border rounded-lg">بعدی</button></div></div></div>            <!-- Suggested products -->
            <div class="bg-white dark:bg-card-dark rounded-xl shadow-soft dark:shadow-soft-dark overflow-hidden border border-gray-100 dark:border-gray-700">
                <div class="p-6 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
                    <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:start-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:start-4 after:bg-primary after:rounded-lg">محصولات پیشنهادی برای شما</h3>
                    <a href="/" class="text-sm font-medium text-primary hover:text-primary/90 dark:text-primary-dark dark:hover:text-primary/80 flex items-center">
                        مشاهده همه
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                        </svg>
                    </a>
                </div>
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6">
@foreach (var product in Model.Suggested) { var price = product.HasMultipleOptions ? product.MinPrice : product.FinalPrice;
                    <article class="bg-white product-box-item drop-shadow-md rounded-xl border border-gray-300 p-4 dark:bg-card-dark dark:border-white dark:border-1" itemscope="" itemtype="http://schema.org/Product">
                        <header class="flex items-center relative justify-between">
                            <div class="flex flex-col bg-white absolute top-1 start-0 p-1 rounded space-y-3  dark:bg-transparent">
                                <button type="button" data-favorite-id="@product.Id" class="hover:text-gray-400 relative group cursor-pointer" aria-label="افزودن به علاقه‌مندی‌ها">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"></path>
                                    </svg>
                                    <span class="absolute text-nowrap start-full ms-2 top-1/2 -translate-y-1/2 hidden group-hover:block bg-gray-900 text-white text-sm py-1 px-2 rounded-md shadow-lg">
                                    <span class="absolute end-full top-1/2 -translate-y-1/2 w-0 h-0 border-y-4 border-y-transparent border-e-4 border-e-gray-900"></span>
                                    افزودن به علاقه‌مندی‌ها
                                    </span>
                                </button>
                            </div>
                            
                        </header>
                        <figure class="flex image justify-center my-4">
                            <a href="/product/@product.Id" itemprop="url">
                                <img class="one-image" src="@(product.PrimaryImageUrl ?? "/assets/images/logo.png")" loading="lazy" alt="@product.Name">
                                
                            </a>
                        </figure>
                        <h3 class="text-base leading-8  line-clamp-2 mb-2">
                            <a href="/product/@product.Id" class="text-gray-800 dark:text-white" itemprop="name">@product.Name</a>
                        </h3>
                        <footer itemprop="offers" itemscope="" itemtype="http://schema.org/Offer">
                            
                            <meta itemprop="priceCurrency" content="IRR">
                            <div class="flex items-center justify-between">
                                <a href="/product/@product.Id" class="bg-primary-grad text-white p-3 rounded-lg transition" aria-label="مشاهده و خرید محصول">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"></path>
                                    </svg>
                                </a>
                                <div class="text-gray-700 flex flex-col items-center">
                                    
                                    <span class="text-xl font-bold dark:text-white" itemprop="price" >@(price?.ToString("N0") ?? "تماس بگیرید") <span class="text-xs">تومان</span></span>
                                </div>
                            </div>
                        </footer>
                    </article>
}
</div></div></div>
<script src="/assets/js/favorites-page.js" defer asp-append-version="true"></script>