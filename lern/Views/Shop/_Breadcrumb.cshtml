@model lern.Models.ShopViewModel
<nav id="shop-breadcrumb" class="category-breadcrumbs" aria-label="مسیر صفحه">
    <a href="/">صفحه اصلی</a><span aria-hidden="true">/</span>
    @if (Model.SelectedCategories.Count == 1 && Model.Breadcrumbs.Count > 0)
    {
        @foreach (var category in Model.Breadcrumbs)
        {
            if (category.Id == Model.Breadcrumbs.Last().Id)
            {
                <span aria-current="page">@category.Name</span>
            }
            else
            {
                <a href="/shop?category=@category.Id">@category.Name</a><span aria-hidden="true">/</span>
            }
        }
    }
    else if (Model.SelectedCategories.Count > 1)
    {
        <span aria-current="page">@string.Join("، ", Model.Categories.Where(c => Model.SelectedCategories.Contains(c.Id)).Select(c => c.Name))</span>
    }
    else
    {
        <span aria-current="page">محصولات</span>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <span aria-hidden="true">/</span><span>جستجوی «@Model.Query»</span>
    }
</nav>
