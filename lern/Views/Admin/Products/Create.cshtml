@model lern.Models.AdminProductCreateViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.IsEdit ? "ویرایش محصول" : "افزودن محصول";
}

<style>
    html:has(.product-editor-form), body.admin-shell:has(.product-editor-form) { overflow-x:hidden; }
    .product-description { min-height: 18rem; resize: vertical; line-height: 1.9; }
    .admin-field-grid textarea { width:100%; padding:.6rem .7rem; border:1px solid #d4deea; border-radius:.65rem; color:#334155; background:#f6f8fb; font:inherit; font-size:.78rem; }.dark .admin-field-grid textarea { color:#f8fafc; border-color:#475569; background:#172235; }
    .product-category-picker { display:flex; align-items:center; justify-content:space-between; gap:.75rem; width:100%; min-height:2.55rem; padding:.45rem .55rem .45rem .7rem; border:1px solid #d4deea; border-radius:.65rem; color:#334155; background:#f6f8fb; font:inherit; font-size:.78rem; text-align:right; cursor:pointer; }
    .product-category-picker span:first-child { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.product-category-picker .admin-secondary-button { min-height:1.7rem; padding:.3rem .55rem; }
    .product-category-dialog { position:fixed; inset:0; width:min(42rem, calc(100vw - 2rem)); max-height:calc(100vh - 2rem); margin:auto; padding:0; border:1px solid #dbe3ee; border-radius:1.1rem; color:#1e293b; background:#fff; box-shadow:0 24px 64px rgba(15,23,42,.28); }.product-category-dialog::backdrop { background:rgba(15,23,42,.62); backdrop-filter:blur(4px); }
    .product-category-dialog header,.product-category-dialog footer { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:1rem 1.25rem; border-bottom:1px solid #e2e8f0; }.product-category-dialog footer { justify-content:flex-end; border-top:1px solid #e2e8f0; border-bottom:0; background:#f8fafc; }.product-category-dialog main { max-height:min(28rem, calc(100vh - 13rem)); overflow:auto; padding:1rem 1.25rem; background:linear-gradient(160deg,#fff,#f8fafc); }
    .product-category-search { width:100%; min-height:2.55rem; padding:.6rem .7rem; border:1px solid #d4deea; border-radius:.65rem; color:#334155; background:#fff; font:inherit; }.product-category-options { display:grid; gap:.45rem; margin-top:1rem; }.product-category-option { display:flex; align-items:center; gap:.65rem; padding:.75rem; border:1px solid #e2e8f0; border-radius:.7rem; color:#334155; background:#fff; cursor:pointer; }.product-category-option.child { margin-right:1.5rem; }.product-category-option input { accent-color:#434ece; }.product-category-option small { margin-right:auto; color:#94a3b8; }.product-dialog-close { border:0; color:#64748b; background:transparent; font-size:1.5rem; cursor:pointer; }
    .seo-accordion { padding:0; overflow:hidden; }.seo-accordion summary { display:flex; align-items:center; gap:.7rem; padding:1.1rem 1.25rem; cursor:pointer; list-style:none; }.seo-accordion summary::-webkit-details-marker { display:none; }.seo-accordion summary::after { content:'⌄'; margin-right:auto; color:#94a3b8; font-size:1.1rem; transition:transform .2s; }.seo-accordion[open] summary::after { transform:rotate(180deg); }.seo-accordion-content { padding:0 1.25rem 1.25rem; }.seo-switches { display:flex; flex-wrap:wrap; gap:.65rem; grid-column:1/-1; }.seo-switch { display:inline-flex; align-items:center; gap:.45rem; padding:.35rem .6rem; border:1px solid #dbe4ee; border-radius:999px; color:#64748b; background:#f8fafc; font-size:.7rem; font-weight:700; cursor:pointer; }.seo-switch input { position:absolute; opacity:0; pointer-events:none; }.seo-switch span { position:relative; display:inline-block; width:1.8rem; height:1rem; border-radius:999px; background:#cbd5e1; transition:.2s; }.seo-switch span::after { content:''; position:absolute; top:.15rem; right:.15rem; width:.7rem; height:.7rem; border-radius:50%; background:#fff; box-shadow:0 1px 2px rgba(15,23,42,.2); transition:.2s; }.seo-switch input:checked + span { background:#434ece; }.seo-switch input:checked + span::after { right:.95rem; }.seo-switch:has(input:checked) { color:#3730a3; border-color:#c7d2fe; background:#eef0ff; }
    .dark .product-category-picker,.dark .product-category-search,.dark .product-category-option { color:#f8fafc; border-color:#475569; background:#172235; }.dark .product-category-dialog { color:#e2e8f0; border-color:#334155; background:#0f172a; }.dark .product-category-dialog main { background:#172235; }.dark .product-category-dialog footer { border-color:#334155; background:#111b2b; }

    /* Product editor: full-width cards with the guide first and the submit action last. */
    .product-editor-form .admin-form-grid { display:flex; flex-direction:column; gap:1.25rem; align-items:stretch; }
    .product-editor-form .admin-form-main,
    .product-editor-form .admin-form-side { display:contents; }
    .product-editor-form,
    .product-editor-form .admin-form-grid,
    .product-editor-form .admin-card { width:100%; min-width:0; max-width:100%; box-sizing:border-box; }
    .admin-main:has(.product-editor-form),
    .admin-content:has(.product-editor-form),
    .product-editor-form { overflow-x:hidden; overflow-x:clip; }
    .admin-content:has(.product-editor-form) { min-width:0; }
    .admin-page-heading:has(+ #ajax-message) > div { min-width:0; }
    .admin-page-heading:has(+ #ajax-message) h1,
    .admin-page-heading:has(+ #ajax-message) p { overflow-wrap:anywhere; }
    .product-editor-form * { min-width:0; max-width:100%; box-sizing:border-box; }
    .product-editor-form .admin-field-grid,
    .product-editor-form .admin-variant-row,
    .product-editor-form .admin-card-heading,
    .product-editor-form .admin-help-card { min-width:0; max-width:100%; }
    .product-editor-form .admin-card-heading > div,
    .product-editor-form .admin-help-card > * { min-width:0; }
    .product-editor-form .admin-card-heading p,
    .product-editor-form .admin-submit-card p,
    .product-editor-form .admin-help-card p { overflow-wrap:anywhere; }
    .product-editor-form .admin-form-side .admin-help-card { order:-1; }
    .product-editor-form .admin-form-side .admin-submit-card { order:999; position:static; }
    .product-editor-form .admin-card { width:100%; padding:1.5rem; border-radius:1.25rem; border-color:#d7e1ec; background:linear-gradient(145deg,#ffffff,#f8fbff); box-shadow:0 14px 32px rgba(15,23,42,.07); }
    .product-editor-form .admin-card:hover { transform:translateY(-1px); box-shadow:0 18px 38px rgba(15,23,42,.1); transition:transform .18s ease, box-shadow .18s ease; }
    .product-editor-form .admin-card-heading h2,
    .product-editor-form .admin-submit-card h2 { font-size:1.1rem; }
    .product-editor-form .admin-card-heading p,
    .product-editor-form .admin-submit-card p { font-size:.84rem; line-height:1.8; }
    .product-editor-form .admin-field-grid label,
    .product-editor-form .admin-switch { font-size:.84rem; }
    .product-editor-form .admin-field-grid input,
    .product-editor-form .admin-field-grid select,
    .product-editor-form .admin-field-grid textarea,
    .product-editor-form .product-category-picker { min-height:2.85rem; font-size:.88rem; }
    .product-editor-form .admin-field-grid textarea.product-description { min-height:20rem; height:20rem; }
    .product-editor-form .admin-primary-button,
    .product-editor-form .admin-secondary-button { min-height:2.85rem; font-size:.88rem; }
    .product-editor-form .admin-help-card { display:grid; grid-template-columns:auto 1fr; column-gap:.8rem; align-items:center; text-align:right; }
    .product-editor-form .admin-help-card .admin-help-icon { grid-row:span 2; margin:0; }
    .product-editor-form .admin-help-card h3 { font-size:1rem; }
    .product-editor-form .admin-help-card p { margin:.25rem 0 0; font-size:.84rem; line-height:1.9; }
    .dark .product-editor-form .admin-card { border-color:#334155; background:linear-gradient(145deg,#172235,#111b2b); box-shadow:0 14px 32px rgba(2,6,23,.24); }
    .primary-image-upload-field { gap:.55rem !important; }
    .primary-image-upload-box { display:flex; align-items:center; justify-content:center; gap:.85rem; width:100%; max-width:100%; min-height:7rem; padding:1rem; border:2px dashed #b9c8dd; border-radius:1rem; color:#64748b; background:linear-gradient(135deg,#f8fbff,#eef4fb); cursor:pointer; transition:.2s ease; }
    .primary-image-upload-box:hover { border-color:#434ece; color:#434ece; background:linear-gradient(135deg,#f0f3ff,#edf9ef); transform:translateY(-1px); }
    .primary-image-upload-box svg { width:2.5rem; height:2.5rem; flex:none; color:#434ece; }
    .primary-image-upload-box strong { display:block; color:#334155; font-size:.95rem; }
    .primary-image-upload-box span span { display:block; margin-top:.25rem; color:#94a3b8; font-size:.78rem; font-weight:600; }
    .primary-image-input { position:absolute; width:1px; height:1px; opacity:0; pointer-events:none; }
    .primary-image-preview { max-width:12rem; max-height:9rem; margin-top:.35rem; border:1px solid #dbe4ee; border-radius:.85rem; object-fit:cover; box-shadow:0 8px 18px rgba(15,23,42,.1); }
    .variant-image-upload-field { gap:.4rem !important; }
    .variant-image-upload-box { min-height:5.5rem; padding:.7rem; border-radius:.8rem; }
    .variant-image-upload-box svg { width:2rem; height:2rem; }
    .variant-image-upload-box strong { font-size:.84rem; }
    .variant-image-upload-box span span { font-size:.7rem; }
    .dark .primary-image-upload-box { border-color:#475569; color:#cbd5e1; background:linear-gradient(135deg,#172235,#111b2b); }
    .dark .primary-image-upload-box strong { color:#f8fafc; }
</style>

<div class="admin-page-heading">
    <div>
        <span class="admin-eyebrow">فروشگاه</span>
        <h1>@(Model.IsEdit ? "ویرایش محصول" : "افزودن محصول جدید")</h1>
        <p>@(Model.IsEdit ? "اطلاعات محصول، حالت‌های فروش، رنگ‌ها و تصاویر را ویرایش کنید." : "اطلاعات محصول، حالت‌های فروش، رنگ‌ها و تصاویر را وارد کنید.")</p>
    </div>
    <a class="admin-secondary-button" href="@Url.Action("Index", "Admin")">بازگشت به پیشخوان</a>
</div>

<div id="ajax-message" class="admin-alert" hidden></div>
<div class="admin-validation" asp-validation-summary="ModelOnly"></div>

<form id="product-form" class="product-editor-form" action="@(Model.IsEdit ? Url.Action("EditProduct", "Admin", new { id = Model.Id }) : Url.Action("CreateProduct", "Admin"))" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div class="admin-form-grid">
        <div class="admin-form-main">
            <section class="admin-card">
                <div class="admin-card-heading"><span class="admin-card-icon"><svg aria-hidden="true"><use href="#admin-i-box"/></svg></span><div><h2>اطلاعات پایه محصول</h2><p>نام و شناسه‌ی محصول را وارد کنید.</p></div></div>
                <div class="admin-field-grid">
                    <label>نام محصول<input asp-for="Name" placeholder="مثلاً کش سه سانت توپی" /></label>
                    <label>Slug انگلیسی<input asp-for="Slug" placeholder="three-cm-elastic" /></label>
                    <label class="full">توضیح کوتاه<input asp-for="ShortDescription" placeholder="توضیح مختصر محصول" /></label>
                    <label class="full">دسته‌بندی محصول
                        <button type="button" id="open-category-picker" class="product-category-picker" aria-haspopup="dialog"><span id="selected-category-summary">انتخاب دسته‌بندی</span><span class="admin-secondary-button">انتخاب</span></button>
                        <small>یک یا چند دسته‌بندی را برای نمایش محصول انتخاب کنید.</small>
                        <div id="selected-category-inputs"></div>
                    </label>
                    <label class="full">توضیحات کامل محصول
                        <textarea asp-for="Description" class="product-description" placeholder="این متن در تب «معرفی محصول» صفحهٔ محصول نمایش داده می‌شود."></textarea>
                    </label>
                    <label class="full primary-image-upload-field">تصویر اصلی محصول (نمایش در کارت محصول)
                        <span class="primary-image-upload-box">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.5"/><path d="m3 17 4.5-4.5 3.5 3.5 2.5-2.5L21 18"/><path d="M18 5v5m-2.5-2.5h5"/></svg>
                            <span><strong>انتخاب تصویر اصلی</strong><span>برای بارگذاری تصویر کلیک کنید</span></span>
                        </span>
                        <input asp-for="PrimaryImage" class="primary-image-input" type="file" accept=".jpg,.jpeg,.png,.webp" />
                        <small>مستقل از عکس Variantها؛ حداکثر ۵ مگابایت.</small>
                        @if (!string.IsNullOrWhiteSpace(Model.ExistingPrimaryImageUrl)){<img src="@Model.ExistingPrimaryImageUrl" alt="تصویر اصلی فعلی" class="primary-image-preview" />}
                    </label>
                </div>
            </section>

            <details class="admin-card seo-accordion">
                <summary><span class="admin-card-icon green"><svg aria-hidden="true"><use href="#admin-i-info"/></svg></span><div><h2>تنظیمات SEO</h2><p>اطلاعات نمایش محصول در موتورهای جست‌وجو.</p></div></summary>
                <div class="seo-accordion-content"><div class="admin-field-grid">
                    <label>عنوان سئو<input asp-for="MetaTitle" maxlength="200" placeholder="عنوان نمایش در نتایج جست‌وجو" /></label>
                    <label>آدرس Canonical<input asp-for="CanonicalUrl" maxlength="500" dir="ltr" placeholder="https://example.com/product/..." /></label>
                    <label class="full">توضیحات متا<textarea asp-for="MetaDescription" maxlength="500" rows="3" placeholder="خلاصه‌ای برای نتایج موتورهای جست‌وجو"></textarea></label>
                    <label class="full">کلمات کلیدی<input asp-for="MetaKeywords" maxlength="300" placeholder="مثال: کش، خیاطی، لوازم خرازی" /></label>
                    <div class="seo-switches"><label class="seo-switch"><input asp-for="IndexPage" /><span></span>ایندکس</label><label class="seo-switch"><input asp-for="FollowPage" /><span></span>دنبال‌کردن لینک‌ها</label></div>
                </div></div>
            </details>

            <section class="admin-card">
                <div class="admin-card-heading"><span class="admin-card-icon green"><svg aria-hidden="true"><use href="#admin-i-percent"/></svg></span><div><h2>تخفیف کلی محصول</h2><p>اختیاری؛ تخفیف هر Variant می‌تواند جداگانه باشد.</p></div></div>
                <div class="admin-field-grid">
                    <label>مقدار تخفیف<input asp-for="ProductDiscountValue" type="number" step="0.01" min="0" /></label>
                    <label>نوع تخفیف<select asp-for="ProductDiscountType"><option value="">بدون تخفیف</option><option value="1">درصدی</option><option value="2">مبلغی</option></select></label>
                </div>
            </section>

            <section class="admin-card">
                <div class="admin-card-heading"><span class="admin-card-icon purple"><svg aria-hidden="true"><use href="#admin-i-grid"/></svg></span><div><h2>حالت‌های فروش و Variantها</h2><p>هر ردیف یک حالت فروش، رنگ، قیمت، موجودی و تصویر دارد.</p></div></div>
                <div id="variants-list">
                    @for (var i = 0; i < Model.Variants.Count; i++)
                    {
                        <partial name="~/Views/Admin/Products/_VariantRow.cshtml" model="(Model.Variants[i], i)" />
                    }
                </div>
                <button type="button" id="add-variant" class="admin-secondary-button">＋ افزودن حالت فروش</button>
            </section>
        </div>
        <aside class="admin-form-side">
            <section class="admin-card admin-submit-card">
                <h2>انتشار محصول</h2>
                <p>پس از ثبت، محصول در دیتابیس ذخیره و تصویر آن در کارت محصول نمایش داده می‌شود.</p>
                <label class="admin-switch"><input asp-for="IsActive" /><span></span> محصول فعال باشد</label>
                <button type="submit" class="admin-primary-button admin-submit-button">ثبت محصول</button>
            </section>
            <section class="admin-card admin-help-card">
                <span class="admin-help-icon"><svg aria-hidden="true"><use href="#admin-i-info"/></svg></span>
                <h3>راهنما</h3>
                <p>قیمت را به تومان وارد کنید. برای هر رنگ یا نوع فروش، یک ردیف جدا بسازید.</p>
            </section>
        </aside>
    </div>
</form>

<dialog id="product-category-dialog" class="product-category-dialog">
    <form method="dialog">
        <header><div><p class="admin-eyebrow">دسته‌بندی محصول</p><h2 class="m-0 text-lg font-black">انتخاب دسته‌بندی‌ها</h2></div><button type="button" id="close-category-picker" class="product-dialog-close" aria-label="بستن">×</button></header>
        <main>
            <input id="category-search" class="product-category-search" type="search" placeholder="جست‌وجو در دسته‌بندی‌ها..." autocomplete="off" />
            <div id="product-category-options" class="product-category-options">
                @{ var rootCategories = Model.CategoryOptions.Where(x => x.ParentId is null).OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToList(); }
                @foreach (var category in rootCategories)
                {
                    var children = Model.CategoryOptions.Where(x => x.ParentId == category.Id).OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToList();
                    <label class="product-category-option" data-category-option data-name="@category.Name"><input type="checkbox" value="@category.Id" @(Model.CategoryIds.Contains(category.Id) ? "checked" : null) /><span>@category.Name</span><small>دسته اصلی</small></label>
                    @foreach (var child in children)
                    {
                        <label class="product-category-option child" data-category-option data-name="@child.Name"><input type="checkbox" value="@child.Id" @(Model.CategoryIds.Contains(child.Id) ? "checked" : null) /><span>↳ @child.Name</span></label>
                    }
                }
                @foreach (var category in Model.CategoryOptions.Where(x => x.ParentId is not null && !Model.CategoryOptions.Any(parent => parent.Id == x.ParentId)).OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
                {
                    <label class="product-category-option" data-category-option data-name="@category.Name"><input type="checkbox" value="@category.Id" @(Model.CategoryIds.Contains(category.Id) ? "checked" : null) /><span>@category.Name</span></label>
                }
            </div>
        </main>
        <footer><button type="button" id="cancel-category-picker" class="admin-secondary-button">انصراف</button><button type="button" id="confirm-category-picker" class="admin-primary-button">تأیید انتخاب</button></footer>
    </form>
</dialog>

<template id="variant-template">
    <partial name="~/Views/Admin/Products/_VariantRow.cshtml" model="(new lern.Models.AdminVariantInputViewModel(), -1)" />
</template>

@section Scripts {
<script>
(() => {
    const form = document.getElementById("product-form"), list = document.getElementById("variants-list");
    const template = document.getElementById("variant-template"), add = document.getElementById("add-variant");
    const message = document.getElementById("ajax-message"), submit = form.querySelector("button[type=submit]");
    const categoryDialog = document.getElementById("product-category-dialog");
    const categoryInputs = document.getElementById("selected-category-inputs");
    const categorySummary = document.getElementById("selected-category-summary");
    const categorySearch = document.getElementById("category-search");
    const categoryChecks = [...document.querySelectorAll("[data-category-option] input[type=checkbox]")];
    const syncCategories = () => {
        const selected = categoryChecks.filter(x => x.checked);
        categoryInputs.replaceChildren(...selected.map(x => {
            const input = document.createElement("input"); input.type = "hidden"; input.name = "CategoryIds"; input.value = x.value; return input;
        }));
        const names = selected.map(x => x.closest("[data-category-option]").querySelector("span").textContent.trim());
        categorySummary.textContent = names.length ? names.join("، ") : "انتخاب دسته‌بندی";
    };
    document.getElementById("open-category-picker").addEventListener("click", () => categoryDialog.showModal());
    ["close-category-picker", "cancel-category-picker", "confirm-category-picker"].forEach(id => document.getElementById(id).addEventListener("click", () => { syncCategories(); categoryDialog.close(); }));
    categorySearch.addEventListener("input", () => {
        const term = categorySearch.value.trim().toLocaleLowerCase("fa-IR");
        document.querySelectorAll("[data-category-option]").forEach(option => option.hidden = term && !option.dataset.name.toLocaleLowerCase("fa-IR").includes(term));
    });
    const reindex = () => [...list.querySelectorAll("[data-variant-row]")].forEach((row, i) => {
        row.querySelectorAll("input,select").forEach(x => x.name = x.name.replace(/Variants\[-?\d+\]/, `Variants[${i}]`));
        row.querySelector(".remove-variant").hidden = list.children.length === 1;
    });
    add.addEventListener("click", () => { list.insertAdjacentHTML("beforeend", template.innerHTML.replaceAll("Variants[-1]", `Variants[${list.children.length}]`)); reindex(); });
    list.addEventListener("click", e => {
        const removeButton = e.target.closest(".remove-variant");
        if (!removeButton) return;
        const row = removeButton.closest("[data-variant-row]");
        const title = row?.querySelector('input[name$=".SaleTitle"]')?.value?.trim() || "این ویژگی";
        if (!window.confirm(`آیا مطمئن هستید می‌خواهید «${title}» حذف شود؟\nبا ذخیرهٔ محصول، این ویژگی از دیتابیس نیز حذف خواهد شد.`)) return;
        row.remove();
        reindex();
    });
    form.addEventListener("submit", async e => {
        e.preventDefault(); message.hidden = true; submit.disabled = true;
        try {
            const r = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { "X-Requested-With": "XMLHttpRequest", "Accept": "application/json" } });
            const text = await r.text();
            let result = null;
            try { result = text ? JSON.parse(text) : null; }
            catch { throw new Error("ذخیرهٔ تغییرات انجام نشد. لطفاً دوباره تلاش کنید."); }
            if (result?.redirectUrl) { window.location.href = result.redirectUrl; return; }
            if (!r.ok || !result?.success) throw new Error(result?.message || "ثبت محصول انجام نشد.");
            message.className = "admin-alert success"; message.textContent = result.message; message.hidden = false; form.reset(); syncCategories();
        } catch (error) { message.className = "admin-alert error"; message.textContent = error.message; message.hidden = false; }
        finally { submit.disabled = false; }
    });
    if (@Model.IsEdit.ToString().ToLowerInvariant()) submit.textContent = "ذخیره تغییرات";
    syncCategories();
    reindex();
})();
</script>
}
