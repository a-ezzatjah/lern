@model lern.Models.AdminProductListViewModel
@using System.Globalization
@{ Layout = "_AdminLayout"; ViewData["Title"] = "لیست محصولات"; }
<style>
.products-page .admin-card{padding:1rem}.products-toolbar{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap}.products-search{display:flex;gap:.5rem;width:min(100%,24rem)}.products-search input{min-width:0;flex:1;min-height:2.4rem;padding:.5rem .7rem;border:1px solid #d4deea;border-radius:.6rem;background:#f6f8fb;font:inherit;font-size:.78rem}.products-page table{min-width:760px}.products-page td,.products-page th{padding:.6rem .7rem}.product-thumb{width:2.7rem;height:2.7rem;flex:0 0 2.7rem;border:1px solid #dbe4ee;border-radius:.6rem;object-fit:cover}.product-name{max-width:18rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.variant-details{margin:.25rem 0 .65rem;border:1px solid #dbe4ee;border-radius:.6rem;background:#f8fafc}.variant-details summary{padding:.6rem .7rem;font-size:.75rem}.variant-grid{padding:.7rem;gap:.6rem}.variant-box{padding:.6rem;border:1px solid #e2e8f0;border-radius:.5rem;background:#fff}.dark .products-search input,.dark .variant-details,.dark .variant-box{background:#111b2b;border-color:#26364c}
</style>
<div class="products-page">
<div class="admin-page-heading"><div><h2 class="text-2xl font-bold dark:text-white">مدیریت محصولات</h2><p class="text-gray-600 dark:text-gray-400">لیست محصولات، حالت‌های فروش و رنگ‌ها</p></div><a href="@Url.Action("CreateProductPage", "Admin")" class="admin-primary-button">＋ افزودن محصول</a></div>
<section class="admin-card overflow-hidden"><div class="products-toolbar border-b border-gray-200 pb-4 dark:border-gray-700"><h3 class="font-bold text-lg dark:text-white">لیست محصولات (@Model.Products.Count)</h3><form method="get" action="@Url.Action("Products", "Admin")" class="products-search"><input name="search" value="@Model.Search" placeholder="جستجوی نام یا slug..." /><button class="admin-primary-button" type="submit">جستجو</button></form></div>
@if(Model.Products.Count==0){<p class="py-12 text-center text-gray-500">محصولی پیدا نشد.</p>}else{<div class="mt-3 overflow-x-auto"><table class="w-full text-start"><thead class="bg-gray-50 dark:bg-gray-700"><tr><th>#</th><th>محصول</th><th>دسته‌بندی</th><th>قیمت</th><th>موجودی</th><th>وضعیت</th></tr></thead><tbody class="divide-y divide-gray-200 dark:divide-gray-700">
@foreach(var item in Model.Products.Select((value,index)=>(value,index))){var p=item.value;var image=p.ProductImages.OrderByDescending(x=>x.IsPrimary).ThenBy(x=>x.SortOrder).FirstOrDefault()?.ImageUrl;var variants=p.SaleOptions.SelectMany(x=>x.ProductVariants).ToList();var price=variants.Count==0?0:variants.Min(x=>x.Price);var stock=variants.Sum(x=>x.AvailableQuantity);<tr class="align-top hover:bg-gray-50 dark:hover:bg-gray-700/50"><td>@(item.index+1)</td><td><div class="flex min-w-[220px] items-center gap-3">@if(!string.IsNullOrWhiteSpace(image)){<img class="product-thumb" src="@image" alt="@p.Name" />}else{<span class="product-thumb grid place-items-center bg-gray-100 text-xs text-gray-400">کالا</span>}<div><div class="product-name font-medium dark:text-white" title="@p.Name">@p.Name</div><div class="text-xs text-gray-500">slug: @p.Slug</div><div class="text-xs text-gray-500">@p.SaleOptions.Count حالت فروش</div></div></div></td><td class="text-sm text-gray-500">@string.Join("، ",p.ProductCategories.Select(x=>x.Category?.Name).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct())</td><td class="whitespace-nowrap text-sm dark:text-white">@price.ToString("N0",CultureInfo.InvariantCulture) تومان</td><td class="whitespace-nowrap text-sm @(stock<=0?"text-red-600":"text-gray-500")">@stock</td><td><span class="rounded-full px-2 py-1 text-xs @(p.IsActive?"bg-green-100 text-green-700":"bg-gray-100 text-gray-600")">@(p.IsActive?"فعال":"غیرفعال")</span></td></tr><tr><td colspan="6" class="px-2 pb-2"><details class="variant-details"><summary class="cursor-pointer font-medium text-primary">مشاهده حالت‌های فروش، رنگ‌ها و تنوع‌ها</summary><div class="variant-grid grid md:grid-cols-2">@foreach(var option in p.SaleOptions){<div class="variant-box"><div class="font-semibold dark:text-white">@option.Title <span class="text-xs text-gray-500">(@option.SaleType)</span></div><div class="mt-2 flex flex-wrap gap-2">@foreach(var color in option.SaleOptionColors.DistinctBy(x=>x.Id)){<span class="rounded-full border px-2 py-1 text-xs" style="border-color:@(color.HexCode??"#d1d5db")">@color.Color</span>}</div><div class="mt-2 space-y-1">@foreach(var variant in option.ProductVariants){<div class="flex justify-between gap-2 text-xs text-gray-600 dark:text-gray-300"><span class="truncate">SKU: @variant.Sku</span><span class="whitespace-nowrap">@variant.Price.ToString("N0",CultureInfo.InvariantCulture) تومان · @variant.AvailableQuantity</span></div>}</div></div>}</div></details></td></tr>}
</tbody></table></div>}
</section></div>
