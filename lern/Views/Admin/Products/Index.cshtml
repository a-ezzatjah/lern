@model lern.Models.AdminProductListViewModel
@using System.Globalization
@{ Layout = "_AdminLayout"; ViewData["Title"] = "لیست محصولات"; }
<style>
.products-page .admin-card{padding:1rem}.products-toolbar{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap}.products-search{display:flex;gap:.5rem;width:min(100%,24rem)}.products-search input{min-width:0;flex:1;min-height:2.4rem;padding:.5rem .7rem;border:1px solid #d4deea;border-radius:.6rem;background:#f6f8fb;font:inherit;font-size:.78rem}.products-page table{min-width:840px}.products-page td,.products-page th{padding:.6rem .7rem}.product-thumb{width:2.7rem;height:2.7rem;flex:0 0 2.7rem;border:1px solid #dbe4ee;border-radius:.6rem;object-fit:cover}.product-name{max-width:18rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.product-edit-button{display:inline-flex;align-items:center;gap:.35rem;min-height:2rem;padding:.4rem .65rem;border:1px solid #cdd6ff;border-radius:.55rem;color:#434ece;background:#eef0ff;font-size:.72rem;font-weight:800;transition:.18s}.product-edit-button:hover{color:#fff;background:#434ece;box-shadow:0 5px 12px rgba(67,78,206,.22)}.product-edit-button svg{width:1rem;height:1rem;fill:none;stroke:currentColor;stroke-width:2}.variant-details{margin:.25rem 0 .65rem;border:1px solid #dbe4ee;border-radius:.6rem;background:#f8fafc}.variant-details summary{padding:.6rem .7rem;font-size:.75rem}.variant-grid{padding:.7rem;gap:.6rem}.variant-box{padding:.6rem;border:1px solid #e2e8f0;border-radius:.5rem;background:#fff}.dark .products-search input,.dark .variant-details,.dark .variant-box{background:#111b2b;border-color:#26364c}.dark .product-edit-button{border-color:#3b4a88;color:#b8c1ff;background:#1b2751}
</style>
<style>
.product-delete-button{display:inline-flex;align-items:center;gap:.35rem;min-height:2rem;margin-top:.35rem;padding:.4rem .65rem;border:1px solid #fecaca;border-radius:.55rem;color:#b91c1c;background:#fff1f2;font-size:.72rem;font-weight:800;transition:.18s}.product-delete-button:hover{color:#fff;background:#dc2626;box-shadow:0 5px 12px rgba(220,38,38,.18)}.dark .product-delete-button{border-color:#7f1d1d;color:#fca5a5;background:#3a1015}
</style>
<div class="products-page">
@Html.AntiForgeryToken()
<div class="admin-page-heading"><div><h2 class="text-2xl font-bold dark:text-white">مدیریت محصولات</h2><p class="text-gray-600 dark:text-gray-400">لیست محصولات، حالت‌های فروش و رنگ‌ها</p></div><a href="@Url.Action("CreateProductPage", "Admin")" class="admin-primary-button">＋ افزودن محصول</a></div>
<section class="admin-card overflow-hidden"><div class="products-toolbar border-b border-gray-200 pb-4 dark:border-gray-700"><h3 class="font-bold text-lg dark:text-white">لیست محصولات (@Model.Products.Count)</h3><form method="get" action="@Url.Action("Products", "Admin")" class="products-search"><input name="search" value="@Model.Search" placeholder="جستجوی نام یا slug..." /><button class="admin-primary-button" type="submit">جستجو</button></form></div>
@if(Model.Products.Count==0){<p class="py-12 text-center text-gray-500">محصولی پیدا نشد.</p>}else{<div class="mt-3 overflow-x-auto"><table class="w-full text-start"><thead class="bg-gray-50 dark:bg-gray-700"><tr><th>#</th><th>محصول</th><th>دسته‌بندی</th><th>قیمت</th><th>موجودی</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody class="divide-y divide-gray-200 dark:divide-gray-700">
@foreach(var item in Model.Products.Select((value,index)=>(value,index))){var p=item.value;var image=p.ProductImages.OrderByDescending(x=>x.IsPrimary).ThenBy(x=>x.SortOrder).FirstOrDefault()?.ImageUrl;var variants=p.SaleOptions.SelectMany(x=>x.ProductVariants).ToList();var price=variants.Count==0?0:variants.Min(x=>x.Price);var stock=variants.Sum(x=>x.AvailableQuantity);<tr class="align-top hover:bg-gray-50 dark:hover:bg-gray-700/50"><td>@(item.index+1)</td><td><div class="flex min-w-[220px] items-center gap-3">@if(!string.IsNullOrWhiteSpace(image)){<img class="product-thumb" src="@image" alt="@p.Name" />}else{<span class="product-thumb grid place-items-center bg-gray-100 text-xs text-gray-400">کالا</span>}<div><div class="product-name font-medium dark:text-white" title="@p.Name">@p.Name</div><div class="text-xs text-gray-500">slug: @p.Slug</div><div class="text-xs text-gray-500">@p.SaleOptions.Count حالت فروش</div></div></div></td><td class="text-sm text-gray-500">@string.Join("، ",p.ProductCategories.Select(x=>x.Category?.Name).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct())</td><td class="whitespace-nowrap text-sm dark:text-white">@price.ToString("N0",CultureInfo.InvariantCulture) تومان</td><td class="whitespace-nowrap text-sm @(stock<=0?"text-red-600":"text-gray-500")">@stock</td><td><span class="rounded-full px-2 py-1 text-xs @(p.IsActive?"bg-green-100 text-green-700":"bg-gray-100 text-gray-600")">@(p.IsActive?"فعال":"غیرفعال")</span></td><td><button type="button" class="product-edit-button" title="ویرایش محصول"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 20 4.2-1 10-10a2.1 2.1 0 0 0-3-3l-10 10L4 20Z"/><path d="m13.8 7.2 3 3"/></svg>ویرایش</button></td></tr><tr><td colspan="7" class="px-2 pb-2"><details class="variant-details"><summary class="cursor-pointer font-medium text-primary">مشاهده حالت‌های فروش، رنگ‌ها و تنوع‌ها</summary><div class="variant-grid grid md:grid-cols-2">@foreach(var option in p.SaleOptions){<div class="variant-box"><div class="font-semibold dark:text-white">@option.Title <span class="text-xs text-gray-500">(@option.SaleType)</span></div><div class="mt-2 flex flex-wrap gap-2">@foreach(var color in option.SaleOptionColors.DistinctBy(x=>x.Id)){<span class="rounded-full border px-2 py-1 text-xs" style="border-color:@(color.HexCode??"#d1d5db")">@color.Color</span>}</div><div class="mt-2 space-y-1">@foreach(var variant in option.ProductVariants){<div class="flex justify-between gap-2 text-xs text-gray-600 dark:text-gray-300"><span class="truncate">SKU: @variant.Sku</span><span class="whitespace-nowrap">@variant.Price.ToString("N0",CultureInfo.InvariantCulture) تومان · @variant.AvailableQuantity</span></div>}</div></div>}</div></details></td></tr>}
</tbody></table></div>}
@if (Model.TotalCount > 0)
{
    var firstItem = (Model.Page - 1) * Model.PageSize + 1;
    var lastItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
    <div class="mt-4 flex flex-col gap-3 border-t border-gray-200 pt-4 text-sm dark:border-gray-700 sm:flex-row sm:items-center sm:justify-between">
        <span class="text-gray-500">نمایش @firstItem تا @lastItem از @Model.TotalCount محصول</span>
        <nav class="flex items-center gap-1" aria-label="صفحه‌بندی محصولات">
            @if (Model.Page > 1)
            {
                <a class="admin-secondary-button !min-h-0 !px-3 !py-2" href="@Url.Action("Products", "Admin", new { search = Model.Search, page = Model.Page - 1 })">قبلی</a>
            }
            @for (var pageNumber = Math.Max(1, Model.Page - 2); pageNumber <= Math.Min(Model.TotalPages, Model.Page + 2); pageNumber++)
            {
                <a class="@(pageNumber == Model.Page ? "admin-primary-button" : "admin-secondary-button") !min-h-0 !px-3 !py-2" href="@Url.Action("Products", "Admin", new { search = Model.Search, page = pageNumber })">@pageNumber</a>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a class="admin-secondary-button !min-h-0 !px-3 !py-2" href="@Url.Action("Products", "Admin", new { search = Model.Search, page = Model.Page + 1 })">بعدی</a>
            }
        </nav>
    </div>
}
</section></div>
@section Scripts {
<script>
document.querySelectorAll('.product-edit-button').forEach(button => button.addEventListener('click', () => {
    const slug = [...button.closest('tr').querySelectorAll('.text-xs')].map(x => x.textContent.trim()).find(x => x.startsWith('slug:'));
    if (slug) window.location.href = `/Admin/Products/Edit?slug=${encodeURIComponent(slug.substring(5).trim())}`;
}));
document.querySelectorAll('.product-edit-button').forEach(editButton => {
    const removeButton = document.createElement('button');
    removeButton.type = 'button'; removeButton.className = 'product-delete-button'; removeButton.textContent = 'حذف محصول';
    editButton.parentElement.append(document.createElement('br'), removeButton);
    removeButton.addEventListener('click', async () => {
        const slug = [...editButton.closest('tr').querySelectorAll('.text-xs')].map(x => x.textContent.trim()).find(x => x.startsWith('slug:'));
        if (!slug || !confirm('آیا از حذف این محصول مطمئن هستید؟')) return;
        const body = new URLSearchParams({ slug: slug.substring(5).trim(), __RequestVerificationToken: document.querySelector('input[name="__RequestVerificationToken"]').value });
        const response = await fetch('/Admin/Products/Delete', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' }, body });
        const result = await response.json();
        if (!response.ok || !result.success) { alert(result.message || 'حذف محصول انجام نشد.'); return; }
        window.location.reload();
    });
});
</script>
}
