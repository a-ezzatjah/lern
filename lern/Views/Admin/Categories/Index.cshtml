@model lern.Models.AdminCategoryListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "دسته‌بندی‌ها";
}

<style>
    .category-page{color:#0f172a}.category-hero{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.25rem;padding:1.35rem 1.5rem;border:1px solid #e0e7ff;border-radius:1.35rem;background:linear-gradient(135deg,#fff 15%,#eef2ff 100%);box-shadow:0 12px 35px rgba(67,78,206,.08)}
    .category-hero h1{margin:0;font-size:1.55rem;font-weight:900}.category-hero p{margin:.35rem 0 0;color:#64748b;font-size:.86rem}.category-primary{display:inline-flex;align-items:center;gap:.5rem;min-height:2.8rem;padding:.7rem 1rem;border:0;border-radius:.85rem;color:#fff;background:linear-gradient(135deg,#434ece,#6366f1);font-weight:800;cursor:pointer;box-shadow:0 8px 20px rgba(67,78,206,.25)}
    .category-toolbar{display:flex;align-items:center;gap:.75rem;margin-bottom:1rem;padding:.8rem;border:1px solid #e2e8f0;border-radius:1rem;background:#fff}.category-search{flex:1;min-width:13rem;height:2.75rem;padding:0 1rem;border:1px solid #cbd5e1;border-radius:.75rem;color:#0f172a;background:#f8fafc;outline:none}.category-search:focus{border-color:#6366f1;box-shadow:0 0 0 3px rgba(99,102,241,.12);background:#fff}.category-toolbar button{height:2.6rem;padding:0 .85rem;border:1px solid #e2e8f0;border-radius:.7rem;color:#475569;background:#fff;font-weight:700;cursor:pointer}
    .category-tree{overflow:hidden;border:1px solid #e2e8f0;border-radius:1.1rem;background:#fff;box-shadow:0 10px 30px rgba(15,23,42,.05)}.category-tree-head{display:grid;grid-template-columns:minmax(18rem,1fr) 16rem 13rem;gap:1rem;padding:.8rem 1rem;color:#64748b;background:#f8fafc;border-bottom:1px solid #e2e8f0;font-size:.74rem;font-weight:800}.category-row{display:grid;grid-template-columns:auto auto minmax(12rem,1fr) 16rem 13rem;align-items:center;gap:.7rem;min-height:4.5rem;padding:.55rem 1rem .55rem calc(1rem + var(--tree-depth) * 1.55rem);border-bottom:1px solid #eef2f7;transition:.18s}.category-row:hover{background:#f8faff}.category-node:last-child>.category-row{border-bottom:0}
    .category-toggle{display:grid;width:1.8rem;height:1.8rem;place-items:center;border:0;border-radius:.5rem;color:#64748b;background:#f1f5f9;cursor:pointer;transition:.18s}.category-toggle svg{width:.95rem;transition:transform .18s}.category-toggle[aria-expanded=true] svg{transform:rotate(90deg)}.category-toggle.is-leaf{background:transparent;cursor:default}.category-icon{display:grid;width:2.45rem;height:2.45rem;place-items:center;border-radius:.75rem;color:#64748b;background:#f1f5f9}.category-icon.is-root{color:#4f46e5;background:#eef2ff}.category-icon svg{width:1.3rem}.category-main{min-width:0}.category-main strong,.category-main span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.category-main strong{font-size:.9rem}.category-main span{margin-top:.25rem;color:#94a3b8;direction:ltr;text-align:right;font-size:.74rem}
    .category-meta{display:flex;align-items:center;gap:.5rem;color:#64748b;font-size:.74rem}.category-count{padding:.3rem .55rem;border-radius:999px;color:#4338ca;background:#eef2ff}.category-actions{display:flex;justify-content:flex-end;gap:.4rem}.category-action{min-height:2.1rem;padding:.35rem .65rem;border:1px solid #e2e8f0;border-radius:.6rem;color:#475569;background:#fff;font-size:.72rem;font-weight:700;cursor:pointer}.category-action:hover{color:#4338ca;border-color:#c7d2fe;background:#eef2ff}.category-action.danger:hover{color:#dc2626;border-color:#fecaca;background:#fef2f2}.category-children{background:#f8fafc;border-right:4px solid #c7d2fe}.category-children>.category-node>.category-row{background:#f8fafc}.category-children>.category-node>.category-row:hover{background:#eef2ff}.category-children .category-children{background:#f1f5f9;border-right-color:#a5b4fc}.category-children .category-children>.category-node>.category-row{background:#f1f5f9}.category-node.is-open>.category-row{background:#eef2ff;box-shadow:inset -4px 0 #6366f1}.category-children.is-collapsed{display:none}.category-empty{padding:4rem 1rem;text-align:center;color:#64748b}[data-category-node].is-search-hidden{display:none}
    .category-dialog{position:fixed;inset:0;width:min(38rem,calc(100vw - 2rem));max-height:calc(100vh - 2rem);margin:auto;padding:0;overflow:auto;border:0;border-radius:1.35rem;color:#0f172a;background:#fff;box-shadow:0 30px 80px rgba(15,23,42,.35)}.category-dialog::backdrop{background:rgba(15,23,42,.65);backdrop-filter:blur(5px)}.dialog-head{display:flex;justify-content:space-between;gap:1rem;padding:1.35rem 1.5rem;color:#fff;background:linear-gradient(135deg,#312e81,#6366f1)}.dialog-head h2{margin:0;font-size:1.2rem}.dialog-head p{margin:.35rem 0 0;color:#c7d2fe;font-size:.8rem}.dialog-close{width:2.3rem;height:2.3rem;border:0;border-radius:50%;color:#fff;background:rgba(255,255,255,.15);font-size:1.4rem;cursor:pointer}
    .dialog-body{padding:1.4rem 1.5rem}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.field{display:block;color:#334155;font-size:.78rem;font-weight:800}.field.full{grid-column:1/-1}.field input{display:block;box-sizing:border-box;width:100%;height:3rem;margin-top:.45rem;padding:0 .85rem;border:1px solid #cbd5e1;border-radius:.75rem;color:#0f172a;background:#f8fafc;font:inherit;outline:none}.field input:focus{border-color:#6366f1;box-shadow:0 0 0 3px rgba(99,102,241,.12);background:#fff}.category-parent-summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:.45rem;padding:.85rem 1rem;border:1px solid #c7d2fe;border-radius:.8rem;color:#4338ca;background:#eef2ff}.category-parent-summary strong,.category-parent-summary span{display:block}.category-parent-summary span{color:#64748b;font-size:.72rem;font-weight:500}.form-hint{display:block;margin-top:.35rem;color:#94a3b8;font-size:.7rem;font-weight:500}.dialog-footer{display:flex;justify-content:flex-end;gap:.7rem;padding:1rem 1.5rem;border-top:1px solid #e2e8f0;background:#f8fafc}.dialog-footer button{min-height:2.7rem;padding:.65rem 1.1rem;border-radius:.75rem;font-weight:800;cursor:pointer}.dialog-cancel{border:1px solid #cbd5e1;color:#475569;background:#fff}.dialog-save{border:0;color:#fff;background:#4f46e5}.category-message{margin:0 0 1rem;padding:.75rem;border-radius:.7rem;color:#b91c1c;background:#fef2f2;font-size:.8rem}
    .dark .category-page{color:#f8fafc}.dark .category-hero,.dark .category-toolbar,.dark .category-tree{border-color:#334155;background:#0f172a}.dark .category-hero{background:linear-gradient(135deg,#0f172a,#1e1b4b)}.dark .category-tree-head,.dark .dialog-footer{border-color:#334155;background:#111827}.dark .category-row{border-color:#1e293b}.dark .category-row:hover{background:#172033}.dark .category-children,.dark .category-children>.category-node>.category-row{background:#111c2e}.dark .category-children .category-children,.dark .category-children .category-children>.category-node>.category-row{background:#172033}.dark .category-node.is-open>.category-row{background:#1e1b4b}.dark .category-search,.dark .field input{border-color:#475569;color:#f8fafc;background:#172033}.dark .category-dialog{color:#f8fafc;background:#0f172a}.dark .field{color:#e2e8f0}.dark .category-action,.dark .category-toolbar button{border-color:#475569;color:#cbd5e1;background:#172033}
    @@media(max-width:850px){.category-tree-head{display:none}.category-row{grid-template-columns:auto auto minmax(0,1fr);padding-right:calc(.7rem + var(--tree-depth) * .75rem)}.category-meta,.category-actions{grid-column:3}.category-actions{justify-content:flex-start;flex-wrap:wrap}.category-hero{align-items:flex-start;flex-direction:column}}@@media(max-width:560px){.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.category-toolbar{align-items:stretch;flex-wrap:wrap}.category-search{width:100%;flex-basis:100%}}
</style>

<div class="category-page">
    <header class="category-hero"><div><h1>مدیریت دسته‌بندی‌ها</h1><p>ساختار درختی فروشگاه را بسازید و زیرمجموعه‌ها را در هر سطح مدیریت کنید.</p></div><button id="new-category" class="category-primary" type="button"><span>＋</span> افزودن دسته جدید</button></header>
    <div class="hidden">@Html.AntiForgeryToken()</div>
    <div class="category-toolbar"><input id="category-search" class="category-search" type="search" placeholder="جست‌وجو در نام یا آدرس دسته..." autocomplete="off"/><button id="expand-all" type="button">باز کردن همه</button><button id="collapse-all" type="button">بستن همه</button><span class="text-xs text-slate-500">@Model.TotalCount دسته</span></div>
    <section class="category-tree">
        <div class="category-tree-head"><span>نام و مسیر دسته</span><span>اطلاعات</span><span class="text-left">عملیات</span></div>
        <div id="category-tree-body">
            @if (Model.Categories.Count == 0) { <div class="category-empty">هنوز دسته‌بندی‌ای ثبت نشده است.</div> }
            @foreach (var category in Model.Categories) { @await Html.PartialAsync("Categories/_CategoryTreeNode", category, new ViewDataDictionary(ViewData) { ["Depth"] = 0 }) }
        </div>
        <div id="search-empty" class="category-empty" hidden>دسته‌ای با این عبارت پیدا نشد.</div>
    </section>
</div>

<dialog id="category-dialog" class="category-dialog">
    <form id="category-form" method="dialog">
        <div class="dialog-head"><div><h2 id="dialog-title">افزودن دسته جدید</h2><p id="dialog-subtitle">اطلاعات دسته را وارد کنید.</p></div><button class="dialog-close" type="button" data-close>×</button></div>
        <div class="dialog-body"><p id="category-message" class="category-message" hidden></p><input id="category-id" type="hidden"/><div class="form-grid">
            <label class="field full">نام دسته‌بندی<input id="category-name" maxlength="100" required placeholder="مثلاً لپ‌تاپ و کامپیوتر"/><span class="form-hint">نامی واضح و کوتاه برای نمایش در فروشگاه</span></label>
            <label class="field">آدرس انگلیسی (Slug)<input id="category-slug" maxlength="100" required dir="ltr" placeholder="laptop-computer"/><span class="form-hint">حروف انگلیسی، عدد و خط تیره</span></label>
            <label class="field">ترتیب نمایش<input id="category-sort" type="number" value="0" min="0"/><span class="form-hint">عدد کمتر، نمایش بالاتر</span></label>
            <input id="category-parent" type="hidden"/>
            <div id="category-parent-summary" class="field full" hidden>جایگاه دسته<div class="category-parent-summary"><strong id="category-parent-name"></strong><span>این دسته در همین جایگاه ذخیره می‌شود.</span></div></div>
        </div></div>
        <footer class="dialog-footer"><button class="dialog-cancel" type="button" data-close>انصراف</button><button id="category-submit" class="dialog-save" type="submit">ذخیره دسته‌بندی</button></footer>
    </form>
</dialog>

@section Scripts {
<script>
(()=>{
const dialog=document.getElementById('category-dialog'),form=document.getElementById('category-form'),message=document.getElementById('category-message'),token=document.querySelector('input[name="__RequestVerificationToken"]')?.value;
const fields={id:document.getElementById('category-id'),name:document.getElementById('category-name'),slug:document.getElementById('category-slug'),parent:document.getElementById('category-parent'),sort:document.getElementById('category-sort')};
const setBranch=(toggle,open)=>{const node=toggle.closest('.category-node'),children=node.querySelector(':scope > .category-children');if(!children)return;children.classList.toggle('is-collapsed',!open);node.classList.toggle('is-open',open);toggle.setAttribute('aria-expanded',String(open));};
document.querySelectorAll('.category-toggle:not(.is-leaf)').forEach(toggle=>toggle.addEventListener('click',()=>setBranch(toggle,toggle.getAttribute('aria-expanded')!=='true')));
document.getElementById('expand-all').onclick=()=>document.querySelectorAll('.category-toggle:not(.is-leaf)').forEach(x=>setBranch(x,true));document.getElementById('collapse-all').onclick=()=>document.querySelectorAll('.category-toggle:not(.is-leaf)').forEach(x=>setBranch(x,false));
const openForm=(data={})=>{form.reset();delete fields.slug.dataset.edited;message.hidden=true;fields.id.value=data.id||'';fields.name.value=data.name||'';fields.slug.value=data.slug||'';fields.parent.value=data.parent||'';fields.sort.value=data.sort||0;const isChild=Boolean(data.parent),parentSummary=document.getElementById('category-parent-summary');document.getElementById('dialog-title').textContent=data.id?'ویرایش دسته‌بندی':isChild?'افزودن زیرمجموعه':'افزودن سر‌دسته جدید';document.getElementById('dialog-subtitle').textContent=isChild?`زیرمجموعه‌ای برای «${data.parentName||'دسته انتخاب‌شده'}» بسازید.`:'این دسته در سطح اصلی فروشگاه ساخته می‌شود.';parentSummary.hidden=!isChild;document.getElementById('category-parent-name').textContent=data.parentName||'دسته والد';dialog.showModal();setTimeout(()=>fields.name.focus(),50);};
document.getElementById('new-category').onclick=()=>openForm();document.querySelectorAll('[data-close]').forEach(x=>x.onclick=()=>dialog.close());document.querySelectorAll('.add-child-category').forEach(x=>x.onclick=()=>openForm({parent:x.dataset.parent,parentName:x.dataset.parentName}));document.querySelectorAll('.edit-category').forEach(x=>x.onclick=()=>openForm(x.dataset));
fields.name.addEventListener('input',()=>{if(fields.id.value||fields.slug.dataset.edited)return;fields.slug.value=fields.name.value.trim().toLowerCase().replace(/\s+/g,'-');});fields.slug.addEventListener('input',()=>fields.slug.dataset.edited='true');
form.onsubmit=async event=>{event.preventDefault();const id=fields.id.value,submit=document.getElementById('category-submit');submit.disabled=true;submit.textContent='در حال ذخیره...';const body=new URLSearchParams({name:fields.name.value,slug:fields.slug.value,parentId:fields.parent.value,sortOrder:fields.sort.value,__RequestVerificationToken:token});try{const response=await fetch(id?`/Admin/Categories/${id}/Edit`:'/Admin/Categories',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body});const result=await response.json();if(!response.ok)throw new Error(result.message);location.reload();}catch(error){message.textContent=error.message||'ذخیره دسته‌بندی انجام نشد.';message.hidden=false;}finally{submit.disabled=false;submit.textContent='ذخیره دسته‌بندی';}};
document.querySelectorAll('.delete-category').forEach(button=>button.onclick=async()=>{if(!confirm(`دسته «${button.dataset.name}» حذف شود؟`))return;const response=await fetch(`/Admin/Categories/${button.dataset.id}/Delete`,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({__RequestVerificationToken:token})});const result=await response.json();if(!response.ok){alert(result.message);return;}location.reload();});
document.getElementById('category-search').addEventListener('input',event=>{const term=event.target.value.trim().toLocaleLowerCase('fa-IR'),nodes=[...document.querySelectorAll('[data-category-node]')];nodes.forEach(node=>node.classList.remove('is-search-hidden'));if(term){nodes.slice().reverse().forEach(node=>{const own=`${node.dataset.name} ${node.dataset.slug}`.toLocaleLowerCase('fa-IR').includes(term),childMatch=Boolean(node.querySelector(':scope > .category-children [data-category-node]:not(.is-search-hidden)'));node.classList.toggle('is-search-hidden',!own&&!childMatch);if(own||childMatch){const toggle=node.querySelector(':scope > .category-row .category-toggle:not(.is-leaf)');if(toggle)setBranch(toggle,true);}});}document.getElementById('search-empty').hidden=nodes.some(x=>!x.classList.contains('is-search-hidden'));});
})();
</script>
}
