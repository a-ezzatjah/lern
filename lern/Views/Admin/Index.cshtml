@model lern.Models.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "پیشخوان مدیریت";
}
<div class="mb-6 flex items-center justify-between"><div><h2 class="text-2xl font-bold dark:text-white">سلام مدیر سیستم 👋</h2><p class="text-gray-600 dark:text-gray-400">آمار واقعی فروشگاه</p></div><a href="@Url.Action("CreateProductPage","Admin")" class="admin-primary-button">＋ افزودن محصول</a></div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6 mb-6">
<div class="admin-stat-card"><span class="admin-stat-icon"><svg><use href="#admin-i-wallet"/></svg></span><div><small>فروش امروز</small><strong>@Model.SalesTotal.ToString("N0") تومان</strong><small>@Model.OrderCount سفارش پرداخت‌شده</small></div></div>
<div class="admin-stat-card"><span class="admin-stat-icon green"><svg><use href="#admin-i-box"/></svg></span><div><small>محصولات فعال</small><strong>@Model.ActiveProductCount</strong><small>از @Model.ProductCount محصول</small></div></div>
<div class="admin-stat-card"><span class="admin-stat-icon purple"><svg><use href="#admin-i-grid"/></svg></span><div><small>دسته‌بندی‌ها</small><strong>@Model.CategoryCount</strong><small>ثبت‌شده در دیتابیس</small></div></div>
<div class="admin-stat-card"><span class="admin-stat-icon orange"><svg><use href="#admin-i-orders"/></svg></span><div><small>موجودی قابل فروش</small><strong>@Model.AvailableStock</strong><small>مجموع Variantها</small></div></div>
</div>
<section class="admin-card"><h3 class="font-bold text-lg mb-6 dark:text-white">نمودار فروش ماهانه</h3><div class="relative h-80"><canvas id="salesChart"></canvas></div><p class="text-sm text-gray-500 mt-3">فقط سفارش‌های لغونشده در محاسبه فروش لحاظ شده‌اند.</p></section>
@section Scripts {
<script src="~/assets/js/plugin/chart-js/chart.js"></script>
<script>
const labels=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)), values=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartValues));
new Chart(document.getElementById('salesChart'),{type:'line',data:{labels,datasets:[{label:'فروش (تومان)',data:values,borderColor:'#434ece',backgroundColor:'rgba(67,78,206,.12)',fill:true,tension:.35}]},options:{responsive:true,maintainAspectRatio:false,scales:{y:{beginAtZero:true}}}});
</script>
}
