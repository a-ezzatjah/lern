@model lern.Models.AdminUserCreateViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "افزودن کاربر جدید";
}

<style>
    .user-create-card { border: 1px solid #e8dcc7; border-radius: 1rem; background: #fffaf0; box-shadow: 0 8px 22px rgba(15,23,42,.05); overflow: hidden; }
    .user-create-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid #e8dcc7; }
    .user-create-header h2 { margin: 0; color: #1e293b; font-size: 1.05rem; font-weight: 900; }
    .user-create-form { padding: 1.5rem; }
    .user-create-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem 1.25rem; }
    .user-field { display: grid; gap: .4rem; color: #475569; font-size: .78rem; font-weight: 800; }
    .user-field input, .user-field select { width: 100%; min-height: 2.75rem; padding: .65rem .8rem; border: 1px solid #d4deea; border-radius: .7rem; color: #334155; background: #f6f8fb; font: inherit; }
    .user-field input:focus, .user-field select:focus { outline: 2px solid rgba(67,78,206,.18); border-color: #434ece; }
    .user-status { display: flex; align-items: center; gap: 1.25rem; min-height: 2.75rem; }
    .user-status label { display: flex; align-items: center; gap: .4rem; }
    .user-avatar { display: flex; align-items: center; gap: 1rem; margin-top: 1.25rem; }
    .user-avatar img { width: 4rem; height: 4rem; border-radius: 50%; object-fit: cover; border: 2px solid #e2e8f0; }
    .user-file-button { display: inline-flex; padding: .65rem 1rem; border-radius: .7rem; color: #434ece; background: #e7ebff; cursor: pointer; font-size: .78rem; font-weight: 800; }
    .user-actions { display: flex; justify-content: flex-end; gap: .75rem; padding-top: 1.5rem; margin-top: 1.5rem; border-top: 1px solid #e8dcc7; }
    .user-validation { color: #b42318; font-size: .72rem; font-weight: 600; }
    .dark .user-create-card { border-color: #334155; background: #111b2b; }
    .dark .user-create-header, .dark .user-actions { border-color: #334155; }
    .dark .user-create-header h2 { color: #f8fafc; }
    .dark .user-field { color: #cbd5e1; }
    .dark .user-field input, .dark .user-field select { border-color: #475569; color: #f8fafc; background: #172235; }
    @@media(max-width:700px) { .user-create-grid { grid-template-columns: 1fr; } .user-actions { flex-direction: column-reverse; } .user-actions a, .user-actions button { width: 100%; } }
</style>

<div class="admin-page-heading">
    <div>
        <span class="admin-eyebrow">مدیریت کاربران</span>
        <h1>افزودن کاربر جدید</h1>
        <p>اطلاعات کاربر جدید را وارد نمایید.</p>
    </div>
    <a asp-controller="Admin" asp-action="Users" class="admin-secondary-button">بازگشت به کاربران</a>
</div>

<div class="user-create-card">
    <div class="user-create-header"><h2>فرم اطلاعات کاربر</h2></div>
    <form asp-controller="Admin" asp-action="CreateUser" method="post" enctype="multipart/form-data" class="user-create-form">
        <div asp-validation-summary="ModelOnly" class="admin-alert error"></div>
        <div class="user-create-grid">
            <label class="user-field">نام
                <input asp-for="FirstName" autocomplete="given-name" />
                <span asp-validation-for="FirstName" class="user-validation"></span>
            </label>
            <label class="user-field">نام خانوادگی
                <input asp-for="LastName" autocomplete="family-name" />
                <span asp-validation-for="LastName" class="user-validation"></span>
            </label>
            <label class="user-field">آدرس ایمیل
                <input asp-for="Email" autocomplete="email" dir="ltr" />
                <span asp-validation-for="Email" class="user-validation"></span>
            </label>
            <label class="user-field">شماره موبایل
                <input asp-for="PhoneNumber" autocomplete="tel" inputmode="numeric" dir="ltr" placeholder="09123456789" />
                <span asp-validation-for="PhoneNumber" class="user-validation"></span>
            </label>
            <label class="user-field">رمز عبور
                <input asp-for="Password" autocomplete="new-password" dir="ltr" />
                <span asp-validation-for="Password" class="user-validation"></span>
            </label>
            <label class="user-field">تکرار رمز عبور
                <input asp-for="ConfirmPassword" autocomplete="new-password" dir="ltr" />
                <span asp-validation-for="ConfirmPassword" class="user-validation"></span>
            </label>
            <label class="user-field">نقش کاربر
                <select asp-for="Role">
                    <option value="Customer">کاربر عادی</option>
                    <option value="Author">نویسنده</option>
                    <option value="Admin">مدیر سیستم</option>
                </select>
                <span asp-validation-for="Role" class="user-validation"></span>
            </label>
            <div class="user-field">وضعیت حساب
                <div class="user-status">
                    <label><input type="radio" asp-for="IsActive" value="true" /> فعال</label>
                    <label><input type="radio" asp-for="IsActive" value="false" /> غیرفعال</label>
                </div>
            </div>
        </div>

        <div class="user-avatar">
            <img id="preview-avatar" src="~/assets/images/user/user.png" alt="پیش‌نمایش تصویر پروفایل" />
            <div>
                <div class="user-field">تصویر پروفایل</div>
                <label class="user-file-button" for="avatar">انتخاب تصویر</label>
                <input asp-for="Avatar" id="avatar" accept=".jpg,.jpeg,.png,.webp" hidden />
                <span asp-validation-for="Avatar" class="user-validation"></span>
            </div>
        </div>

        <div class="user-actions">
            <a asp-controller="Admin" asp-action="Users" class="admin-secondary-button">انصراف</a>
            <button type="submit" class="admin-primary-button">ذخیره کاربر</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('avatar')?.addEventListener('change', function () {
            const file = this.files && this.files[0];
            if (file) document.getElementById('preview-avatar').src = URL.createObjectURL(file);
        });
    </script>
}
