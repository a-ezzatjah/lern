@model lern.Models.AdminUserListViewModel
@{ Layout="_AdminLayout"; ViewData["Title"]="مدیریت کاربران"; var first=Model.TotalCount==0?0:(Model.Page-1)*Model.PageSize+1; var last=Math.Min(Model.Page*Model.PageSize,Model.TotalCount); }
<style>
.users-card{border:1px solid #e8dcc7;border-radius:1rem;background:#fffaf0;box-shadow:0 8px 22px rgba(15,23,42,.05);overflow:hidden}.users-toolbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:1.25rem 1.5rem;border-bottom:1px solid #e8dcc7}.users-search{display:flex;gap:.5rem;width:min(100%,30rem)}.users-search input{min-width:0;flex:1;padding:.6rem .8rem;border:1px solid #d4deea;border-radius:.65rem;background:#f6f8fb}.users-table{min-width:960px}.users-table th,.users-table td{padding:.8rem 1rem;text-align:right}.users-table thead{color:#64748b;background:#f3f6fa}.users-table tbody tr{border-top:1px solid #e2e8f0}.users-table tbody tr:hover{background:#f8fafc}.user-avatar{width:2.75rem;height:2.75rem;border-radius:50%;object-fit:cover;border:1px solid #dbe4ee}.user-badge{display:inline-flex;padding:.25rem .6rem;border-radius:999px;font-size:.7rem;font-weight:800}.role-admin,.active{color:#166534;background:#dcfce7}.role-author{color:#1e40af;background:#dbeafe}.role-customer{color:#854d0e;background:#fef9c3}.inactive{color:#991b1b;background:#fee2e2}.row-actions{display:flex;gap:.45rem}.row-action{padding:.45rem .7rem;border-radius:.55rem;font-size:.72rem;font-weight:800;transition:.18s}.edit-action{color:#434ece;border:1px solid #cdd6ff;background:#eef0ff}.edit-action:hover{color:#fff;background:#434ece}.delete-action{color:#b91c1c;border:1px solid #fecaca;background:#fff1f2}.delete-action:hover{color:#fff;background:#dc2626}.pagination{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:1rem 1.5rem;border-top:1px solid #e8dcc7}.page-links{display:flex;gap:.35rem}.page-link{padding:.4rem .7rem;border:1px solid #d4deea;border-radius:.55rem;font-size:.75rem}.page-link.current{color:#fff;background:#434ece}.dark .users-card{border-color:#334155;background:#111b2b}.dark .users-toolbar,.dark .pagination{border-color:#334155}.dark .users-search input{color:#fff;border-color:#475569;background:#172235}.dark .users-table thead{background:#172235}.dark .users-table tbody tr{border-color:#334155}.dark .users-table tbody tr:hover{background:#172235}
</style>
<div class="users-page">@Html.AntiForgeryToken()
@if(TempData["UserCreated"] is string message){<div class="admin-alert">@message</div>}
<div class="admin-page-heading"><div><span class="admin-eyebrow">مدیریت سیستم</span><h1>مدیریت کاربران</h1><p>فهرست واقعی کاربران ثبت‌شده در سایت</p></div><a asp-action="CreateUserPage" class="admin-primary-button">＋ افزودن کاربر جدید</a></div>
<section class="users-card"><div class="users-toolbar"><h2 class="font-bold text-lg dark:text-white">کاربران (@Model.TotalCount)</h2><form method="get" asp-action="Users" class="users-search"><input name="search" value="@Model.Search" placeholder="جستجو در نام، موبایل یا ایمیل..."/><button class="admin-primary-button">جستجو</button>@if(!string.IsNullOrWhiteSpace(Model.Search)){<a asp-action="Users" class="admin-secondary-button">پاک کردن</a>}</form></div>
@if(Model.Users.Count==0){<div class="py-16 text-center text-gray-500"><p>کاربری پیدا نشد.</p><a asp-action="CreateUserPage" class="mt-4 admin-primary-button">افزودن اولین کاربر</a></div>}else{
<div class="overflow-x-auto"><table class="users-table w-full"><thead><tr><th>#</th><th>کاربر</th><th>اطلاعات تماس</th><th>نقش</th><th>وضعیت</th><th>تاریخ عضویت</th><th>عملیات</th></tr></thead><tbody>
@foreach(var item in Model.Users.Select((user,index)=>(user,index))){var user=item.user;var avatar=string.IsNullOrWhiteSpace(user.ProfileImageUrl)?Url.Content("~/assets/images/user/user.png"):user.ProfileImageUrl;var roleTitle=user.Role switch{"Admin"=>"مدیر سیستم","Author"=>"نویسنده",_=>"کاربر عادی"};var roleClass=user.Role switch{"Admin"=>"role-admin","Author"=>"role-author",_=>"role-customer"};
<tr><td class="text-sm text-gray-500">@((Model.Page-1)*Model.PageSize+item.index+1)</td><td><div class="flex items-center gap-3"><img class="user-avatar" src="@avatar" alt="@user.FirstName @user.LastName"/><div><strong class="dark:text-white">@user.FirstName @user.LastName</strong><div class="text-xs text-gray-500">شناسه: @user.Id</div></div></div></td><td><div dir="ltr">@user.PhoneNumber</div><div class="text-xs text-gray-500" dir="ltr">@(user.Email??"بدون ایمیل")</div></td><td><span class="user-badge @roleClass">@roleTitle</span></td><td><span class="user-badge @(user.IsActive?"active":"inactive")">@(user.IsActive?"فعال":"غیرفعال")</span></td><td class="text-sm text-gray-500" dir="ltr">@user.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td><div class="row-actions"><a asp-action="EditUserPage" asp-route-id="@user.Id" class="row-action edit-action">ویرایش</a><button type="button" class="row-action delete-action" data-id="@user.Id" data-name="@user.FirstName @user.LastName">حذف</button></div></td></tr>}
</tbody></table></div>}
<div class="pagination"><span class="text-sm text-gray-500">نمایش @first تا @last از @Model.TotalCount کاربر</span>@if(Model.TotalPages>1){<nav class="page-links">@if(Model.Page>1){<a class="page-link" href="@Url.Action("Users",new{search=Model.Search,page=Model.Page-1})">قبلی</a>}@for(var p=1;p<=Model.TotalPages;p++){<a class="page-link @(p==Model.Page?"current":"")" href="@Url.Action("Users",new{search=Model.Search,page=p})">@p</a>}@if(Model.Page<Model.TotalPages){<a class="page-link" href="@Url.Action("Users",new{search=Model.Search,page=Model.Page+1})">بعدی</a>}</nav>}</div></section></div>
@section Scripts{<script>
document.querySelectorAll('.delete-action').forEach(button=>button.addEventListener('click',async()=>{if(!confirm(`آیا از حذف کاربر «${button.dataset.name}» مطمئن هستید؟`))return;const token=document.querySelector('input[name="__RequestVerificationToken"]').value;const response=await fetch(`/Admin/Users/${button.dataset.id}/Delete`,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'XMLHttpRequest'},body:new URLSearchParams({__RequestVerificationToken:token})});const result=await response.json();if(!response.ok||!result.success){alert(result.message||'حذف کاربر انجام نشد.');return;}window.location.reload();}));
</script>}
