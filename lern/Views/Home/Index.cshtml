@model lern.Models.HomeIndexViewModel

@{
    ViewData["Title"] ??= "صفحه اصلی";
}

<!-- ================= start slider section ================= -->
@if (Model.Banners.Count > 0)
{
<section class="py-5">
    <h2 class="sr-only">اسلایدر فروشگاه</h2>
    <div class="w-full overflow-hidden">
        <div class="swiper max-w-[1920px] mx-auto !relative default-carousel swiper-container" aria-label="اسلایدر فروشگاه">
            <div class="swiper-wrapper" style="padding-bottom:0!important">
                @foreach (var slide in Model.Banners)
                {
                    <div class="swiper-slide">
                        <div class="h-90 flex justify-center items-center">
                            @if (!string.IsNullOrWhiteSpace(slide.LinkUrl)) { <a href="@slide.LinkUrl" class="block h-full w-full"><picture class="block h-full w-full"><source media="(max-width: 640px)" srcset="@(slide.MobileImageUrl ?? slide.ImageUrl)" /><img src="@slide.ImageUrl" class="h-full w-full object-cover rounded-lg" loading="lazy" alt="@slide.AltText" /></picture></a> }
                            else { <picture class="block h-full w-full"><source media="(max-width: 640px)" srcset="@(slide.MobileImageUrl ?? slide.ImageUrl)" /><img src="@slide.ImageUrl" class="h-full w-full object-cover rounded-lg" loading="lazy" alt="@slide.AltText" /></picture> }
                        </div>
                    </div>
                }
            </div>
            <div class="swiper-button-next bg-white rounded-full border border-gray-200 !size-12 after:!text-xl after:text-primary"></div>
            <div class="swiper-button-prev bg-white rounded-full border border-gray-200 !size-12 after:!text-xl after:text-primary"></div>
            <div class="swiper-pagination !z-30 !bottom-0"></div>
            <div class="slider-pagination-bg absolute w-40 h-10 -translate-x-1/2 -mb-3 pt-1 end-1/2 bottom-0 z-10"></div>
        </div>
    </div>
</section>
}

@if (Model.DiscountedProducts.Count > 0)
{
    <section class="py-5" itemscope itemtype="http://schema.org/ItemList">
        <div class="container">
            <div class="bg-primary dark:bg-zinc-800 bg-contain bg-[url(../images/slider/patterns.png)] p-5 rounded-lg">
                <header class="flex items-center justify-between mb-4">
                    <h2 class="font-black text-2xl text-white">پیشنهادهای شگفت‌انگیز</h2>
                    <a href="/shop?discounted=true" class="text-white">مشاهده تخفیف‌های بیشتر ←</a>
                </header>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                    @foreach (var product in Model.DiscountedProducts.Take(8))
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>
            </div>
        </div>
    </section>
}

<section class="py-5">
    <div class="container">
        <header class="grid place-items-center grid-cols-6 gap-y-4 mb-5">
            <div class="ps-15 section-heading sm:col-span-4 w-full col-span-6">
                <h2 class="font-black text-2xl dark:text-white">جدیدترین <span class="text-primary">محصولات</span></h2>
                <p class="text-neutral-600 dark:text-white">محصولات تازه‌وارد فروشگاه</p>
            </div>
            <div class="sm:col-span-2 col-span-6 w-full sm:text-end">
                <a href="/shop" class="btn bg-transparent border-secondary border-2 hover:bg-secondary hover:text-white dark:text-white dark:border-white">مشاهده همه</a>
            </div>
        </header>
        @if (Model.NewestProducts.Count == 0)
        {
            <div class="storefront-empty-state">هنوز محصولی ثبت نشده است.</div>
        }
        else
        {
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                @foreach (var product in Model.NewestProducts.Take(8))
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        }
    </div>
</section>

<!-- ================= start category section ================= -->
<link rel="stylesheet" href="~/assets/css/home-categories.css" asp-append-version="true" />
<section class="py-5">
    <div class="container">
        <header class="mb-5 home-category-heading">
            <div>
            <h2 class="font-black text-2xl dark:text-white">دسته‌بندی <span class="text-primary">فروشگاه</span></h2>
            <p class="text-neutral-600 dark:text-white">دسته‌های اصلی خرازی</p>
            </div>
        </header>
        <div class="home-category-carousel">
        <div id="home-categories" class="swiper home-category-track" role="region" aria-label="دسته‌های اصلی فروشگاه">
            <div class="swiper-wrapper">
            @foreach (var category in Model.MainCategories)
            {
                <div class="swiper-slide">
                <a href="/shop?category=@category.Id" class="home-category-card group border border-gray-200 rounded-xl p-4 bg-white dark:bg-gray-800 text-center shadow-sm">
                    <img src="@CategoryImage.GetUrl(category)" width="240" height="180" class="w-full object-contain group-hover:scale-105 transition" loading="lazy" alt="@category.Name">
                    <h3 class="mt-3 font-bold dark:text-white">@category.Name</h3>
                </a>
                </div>
            }
            </div>
        </div>
        <button type="button" class="home-category-prev bg-white rounded-full border border-gray-200" aria-label="دسته‌های قبلی" aria-controls="home-categories"></button>
        <button type="button" class="home-category-next bg-white rounded-full border border-gray-200" aria-label="دسته‌های بعدی" aria-controls="home-categories"></button>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container grid md:grid-cols-2 gap-4">
        <img src="~/assets/images/slider/haberdashery-sewing-small-v2.jpg" asp-append-version="true" width="2048" height="427" style="height:auto" class="w-full rounded-xl" loading="lazy" alt="دوخت خوب، از اینجا شروع می‌شود؛ ابزار دوخت و خیاطی">
        <img src="~/assets/images/slider/haberdashery-ribbon-small-v2.jpg" asp-append-version="true" width="2560" height="533" style="height:auto" class="w-full rounded-xl" loading="lazy" alt="جزئیات کوچک، جلوه‌ای بزرگ؛ روبان، دکمه و مهره">
    </div>
</section>

<!-- ================= start blog section ================= -->
<section class="py-5">
    <div class="container">
        <header class="grid place-items-center grid-cols-6 gap-y-4 mb-5">
            <div class="ps-15 section-heading sm:col-span-4 w-full col-span-6">
                <h2 class="font-black text-2xl dark:text-white">مجله <span class="text-primary">فروشگاه</span></h2>
                <p class="text-neutral-600 dark:text-white">آخرین مقالات و مطالب آموزشی</p>
            </div>
            <div class="sm:col-span-2 col-span-6 w-full sm:text-end">
                <a href="/articles" class="btn bg-transparent border-secondary border-2 hover:bg-secondary hover:text-white dark:text-white dark:border-white">مشاهده همه</a>
            </div>
        </header>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var article in Model.Articles)
            {
                <article class="bg-white dark:bg-gray-800 rounded-xl overflow-hidden border border-gray-200 dark:border-gray-700 shadow-md hover:-translate-y-1 transition">
                    <a href="/articles/@article.Slug"><img src="@article.ImageUrl" width="915" height="580" class="w-full h-48 object-cover" loading="lazy" alt="@article.ImageAlt"></a>
                    <div class="p-4">
                        <span class="text-xs text-primary">@article.Category</span>
                        <h3 class="font-bold text-lg leading-8 mt-2 dark:text-white"><a href="/articles/@article.Slug">@article.Title</a></h3>
                        <p class="text-sm text-gray-500 dark:text-gray-300 leading-7 mt-2">@article.Summary</p>
                        <a href="/articles/@article.Slug" class="inline-flex items-center text-primary mt-3">ادامه مطلب ←</a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/home-categories.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.Swiper && !document.querySelector('.default-carousel')?.swiper) {
                new Swiper('.default-carousel', {
                    loop: true,
                    autoHeight: true,
                    autoplay: { delay: 4500 },
                    pagination: { el: '.swiper-pagination', clickable: true },
                    navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' }
                });
            }
        });
    </script>
}
