@model ArticleListViewModel
@{
    ViewData["Title"] ??= "مجله خرازی کوهستانی";
    ViewData["MetaDescription"] ??= "آموزش خیاطی، راهنمای انتخاب نخ و لوازم خرازی و ایده‌های خلاقانه در مجله خرازی کوهستانی.";
    var filtered = !string.IsNullOrEmpty(Model.Query);
    var featured = !filtered && Model.Page == 1 ? Model.Articles.FirstOrDefault() : null;
}
<link rel="stylesheet" href="~/assets/css/articles.css" asp-append-version="true">
<section class="journal" aria-label="مجله کوهستانی">
    <div class="journal-shell">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه"><a href="/">خانه</a><span aria-hidden="true">/</span><span aria-current="page">مجله کوهستانی</span></nav>
        <section class="journal-intro">
            <div><span class="journal-eyebrow"><span aria-hidden="true">✦</span> برای دست‌هایی که خلق می‌کنند</span><h1>هر دوخت، <span>یک داستان تازه.</span></h1><p>آموزش‌های کاربردی، راهنمای انتخاب و ایده‌های کوچک برای خلق چیزهای زیبا؛ به مجله خرازی کوهستانی خوش آمدید.</p></div>
            <form action="/articles" method="get" role="search" class="article-search">
                <label for="article-search">دنبال چه ایده‌ای می‌گردید؟</label>
                <div class="article-search-field"><svg width="21" height="21" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-width="1.7" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg><input id="article-search" type="search" name="q" value="@Model.Query" maxlength="100" placeholder="جستجو در مجله…"><button type="submit">جستجو</button></div>
            </form>
        </section>
        @if (featured is not null)
        {
            <article class="journal-feature" itemscope itemtype="https://schema.org/BlogPosting">
                <a href="/articles/@featured.Slug" class="journal-feature-image" tabindex="-1" aria-hidden="true"><img src="@featured.ImageUrl" alt="@featured.ImageAlt" width="915" height="580" fetchpriority="high" itemprop="image"><span class="journal-image-label">تازه در مجله</span></a>
                <div class="journal-feature-copy"><span class="journal-eyebrow">یک ایده برای شروع</span><h2 itemprop="headline"><a href="/articles/@featured.Slug" itemprop="url">@featured.Title</a></h2><p itemprop="description">@featured.Summary</p><div class="article-meta"><time datetime="@featured.PublishedAt?.ToString("yyyy-MM-dd")" itemprop="datePublished">@ArticleDisplay.Date(featured.PublishedAt)</time><span class="article-meta-dot" aria-hidden="true"></span><span>@ArticleDisplay.ReadingMinutes(featured.Content) دقیقه مطالعه</span></div><a class="journal-button" href="/articles/@featured.Slug">بخوانید و ایده بگیرید <span aria-hidden="true">↗</span></a></div>
            </article>
        }
        <section class="journal-library" aria-labelledby="journal-library-title">
            <div class="journal-section-heading"><div><span class="journal-eyebrow">یاد بگیرید، انتخاب کنید، بسازید</span><h2 id="journal-library-title">@(filtered ? "نتیجه جستجوی شما" : "در مجله بخوانید")</h2></div></div>
            @if (filtered) { <div class="journal-results"><p>@if (!string.IsNullOrEmpty(Model.Query)) { <span>جستجو برای «@Model.Query»</span> }</p><a href="/articles">پاک کردن فیلترها <span aria-hidden="true">×</span></a></div> }
            <div class="article-grid">@foreach (var article in Model.Articles) { <partial name="_Card" model="article" /> }</div>
            @if (Model.Articles.Count == 0) { <div class="journal-empty"><span aria-hidden="true">✦</span><h3>هنوز مطلبی اینجا پیدا نکردیم</h3><p>عبارت دیگری را جستجو کنید یا سری به همهٔ مطالب مجله بزنید.</p><a href="/articles" class="journal-button">مشاهده همه مطالب <span aria-hidden="true">←</span></a></div> }
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="صفحه‌بندی مقالات" class="article-pagination">
                    @if (Model.Page > 1) { <a href="@Url.Action("Index", new { q = Model.Query, page = Model.Page - 1 })" aria-label="صفحه قبل">→</a> }
                    @for (var page = Math.Max(1, Model.Page - 2); page <= Math.Min(Model.TotalPages, Model.Page + 2); page++) { <a class="@(page == Model.Page ? "is-active" : "")" aria-label="صفحه @(page)" aria-current="@(page == Model.Page ? "page" : null)" href="@Url.Action("Index", new { q = Model.Query, page })">@(page)</a> }
                    @if (Model.Page < Model.TotalPages) { <a href="@Url.Action("Index", new { q = Model.Query, page = Model.Page + 1 })" aria-label="صفحه بعد">←</a> }
                </nav>
            }
        </section>
        <section class="journal-shop"><div><span class="journal-eyebrow">از ایده تا ساختن</span><h2>وسایلش را پیدا کنید، داستانش را بسازید.</h2><p>هر پروژهٔ زیبا با انتخاب ابزار مناسب شروع می‌شود.</p></div><a href="/shop" class="journal-button">دیدن لوازم خرازی <span aria-hidden="true">←</span></a><span class="journal-shop-decoration" aria-hidden="true">✳</span></section>
    </div>
</section>
