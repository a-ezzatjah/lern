@model Entities.Article
<article class="article-card" itemscope itemtype="https://schema.org/BlogPosting">
    <a href="/articles/@Model.Slug" class="article-card-image" tabindex="-1" aria-hidden="true"><img src="@Model.ImageUrl" alt="@Model.ImageAlt" width="915" height="580" itemprop="image" loading="lazy" decoding="async"></a>
    <div class="article-card-copy">
        <h3 class="article-card-title" itemprop="headline"><a href="/articles/@Model.Slug" itemprop="url">@Model.Title</a></h3>
        <p class="article-summary" itemprop="description">@Model.Summary</p>
        <div class="article-card-footer"><div class="article-meta"><time datetime="@Model.PublishedAt?.ToString("yyyy-MM-dd")" itemprop="datePublished">@ArticleDisplay.Date(Model.PublishedAt)</time><span class="article-meta-dot" aria-hidden="true"></span><span>@ArticleDisplay.ReadingMinutes(Model.Content) دقیقه مطالعه</span></div><a href="/articles/@Model.Slug" class="article-card-arrow" aria-label="مطالعه @Model.Title"><span aria-hidden="true">↗</span></a></div>
    </div>
</article>
