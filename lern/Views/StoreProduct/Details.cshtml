@section Scripts {
    <script>
        (() => {
            const gallery = @Html.Raw(JsonSerializer.Serialize(Model.Gallery));
            const cartButton = document.getElementById('add-to-cart-button');
            const cartStatus = document.getElementById('add-to-cart-status');
            const priceElement = document.getElementById('selected-variant-price');
            const discountElement = document.getElementById('selected-variant-discount');
            const originalPriceElement = document.getElementById('selected-variant-original-price');
            const discountPercentElement = document.getElementById('selected-variant-discount-percent');

            if (gallery.length && window.Swiper) {
                const slides = gallery.map(image => `
                    <div class="swiper-slide !pe-1">
                        <img src="${image.ImageUrl}" alt="${image.AltText}" class="rounded-lg cursor-pointer border border-gray-300 p-2">
                    </div>`).join('');

                const mainWrapper = document.querySelector('#productGalleryTwo .swiper-wrapper');
                const thumbsWrapper = document.querySelector('#productGalleryOne .swiper-wrapper');
                if (mainWrapper) mainWrapper.innerHTML = slides;
                if (thumbsWrapper) thumbsWrapper.innerHTML = slides;

                window.swiperProductGalleryOne?.destroy(true, true);
                window.swiperProductGalleryTwo?.destroy(true, true);
                window.swiperProductGalleryOne = new Swiper('#productGalleryOne', {
                    spaceBetween: 10,
                    slidesPerView: 3,
                    freeMode: true,
                    watchSlidesProgress: true
                });
                window.swiperProductGalleryTwo = new Swiper('#productGalleryTwo', {
                    spaceBetween: 10,
                    thumbs: { swiper: window.swiperProductGalleryOne }
                });
            }

            const selectVariant = (button) => {
                if (!button || button.disabled) return;
                cartButton.dataset.variantId = button.dataset.variantId || '';
                cartButton.dataset.maxQuantity = button.dataset.maxQuantity || '0';
                if (priceElement && button.dataset.price) {
                    const price = Number(button.dataset.price);
                    priceElement.textContent = Number.isFinite(price)
                        ? price.toLocaleString('fa-IR')
                        : button.dataset.price;
                    priceElement.setAttribute('content', button.dataset.price);
                }
                const originalPrice = Number(button.dataset.originalPrice);
                const discountPercent = Number(button.dataset.discountPercent);
                const hasDiscount = Number.isFinite(originalPrice) &&
                    Number.isFinite(discountPercent) &&
                    discountPercent > 0 &&
                    originalPrice > Number(button.dataset.price);
                discountElement?.classList.toggle('hidden', !hasDiscount);
                if (hasDiscount) {
                    originalPriceElement.textContent = originalPrice.toLocaleString('fa-IR');
                    discountPercentElement.textContent = `${discountPercent.toLocaleString('fa-IR')}٪`;
                }
                document.querySelectorAll('.variant-choice').forEach(x => {
                    x.classList.toggle('is-selected', x === button);
                    x.classList.toggle('border-primary-500', x === button);
                    x.classList.toggle('bg-primary-50', x === button);
                    x.classList.toggle('dark:bg-gray-700', x === button);
                    x.classList.toggle('text-primary-700', x === button);
                    x.classList.toggle('dark:text-white', x === button);
                });
                const selectedSaleOption = button.closest('[data-sale-option]');
                document.querySelectorAll('.sale-option-button').forEach(x => {
                    x.classList.toggle('is-selected', x.closest('[data-sale-option]') === selectedSaleOption);
                });
                const imageUrl = button.dataset.imageUrl;
                if (imageUrl) {
                    const image = document.querySelector('#productGalleryTwo img');
                    if (image) image.src = imageUrl;
                }
                cartButton.disabled = !button.dataset.maxQuantity || Number(button.dataset.maxQuantity) <= 0;
            };

            document.querySelectorAll('.sale-option-button').forEach(button => {
                button.addEventListener('click', () => {
                    const choice = button.closest('[data-sale-option]')?.querySelector('.variant-choice:not(:disabled)');
                    selectVariant(choice || button);
                });
            });
            document.querySelectorAll('.variant-choice').forEach(button => {
                button.addEventListener('click', () => selectVariant(button));
            });

            if (!cartButton) return;

            cartButton.addEventListener('click', async () => {
                const variantId = Number(cartButton.dataset.variantId);
                const maxQuantity = Number(cartButton.dataset.maxQuantity);
                const quantityElement = document.getElementById('count1');
                const quantity = Math.min(Math.max(1, Number(quantityElement?.textContent) || 1), maxQuantity);

                if (!variantId || !maxQuantity) {
                    cartStatus.textContent = 'این محصول در حال حاضر قابل سفارش نیست.';
                    cartStatus.className = 'mt-2 text-center text-sm text-red-600';
                    return;
                }

                cartButton.disabled = true;
                cartStatus.textContent = 'در حال افزودن به سبد خرید...';
                cartStatus.className = 'mt-2 text-center text-sm text-gray-600';

                try {
                    const response = await fetch('/api/cart', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productVariantId: variantId, quantity })
                    });

                    if (!response.ok) throw new Error(await response.text());

                    cartStatus.textContent = 'محصول به سبد خرید اضافه شد.';
                    cartStatus.className = 'mt-2 text-center text-sm text-green-600';
                } catch {
                    cartStatus.textContent = 'افزودن محصول به سبد خرید انجام نشد. دوباره تلاش کنید.';
                    cartStatus.className = 'mt-2 text-center text-sm text-red-600';
                } finally {
                    cartButton.disabled = false;
                }
            });
        })();
    </script>
}
