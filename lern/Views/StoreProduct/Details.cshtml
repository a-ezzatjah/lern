@using System.Text.Json
@model lern.Models.StoreProductDetailsViewModel

<style>
    #sale-options-panel {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    #sale-options-panel [data-sale-option] {
        padding: 1rem;
        border: 1px solid #e5e7eb;
        border-radius: 1rem;
        background: linear-gradient(145deg, #ffffff, #f8fafc);
        box-shadow: 0 8px 20px rgba(15, 23, 42, .07), 0 2px 5px rgba(15, 23, 42, .04);
    }

    #sale-options-panel .sale-option-button {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 3.25rem;
        padding: .8rem 1rem;
        border: 1px solid #dbe3ef;
        border-radius: .8rem;
        background: #fff;
        color: #1e293b;
        box-shadow: 0 3px 8px rgba(15, 23, 42, .08);
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

    #sale-options-panel .sale-option-button::before {
        content: "";
        width: .3rem;
        height: 1.5rem;
        margin-left: .65rem;
        border-radius: 999px;
        background: linear-gradient(#6366f1, #06b6d4);
    }

    #sale-options-panel .sale-option-button:hover {
        transform: translateY(-2px);
        border-color: #818cf8;
        box-shadow: 0 10px 18px rgba(79, 70, 229, .16);
    }

    #sale-options-panel .sale-option-button.is-selected {
        border-color: #4f46e5;
        background: linear-gradient(135deg, #eef2ff, #f0fdfa);
        box-shadow: 0 0 0 3px rgba(79, 70, 229, .18), 0 12px 20px rgba(79, 70, 229, .16);
    }

    #sale-options-panel .variant-choice {
        min-height: 1.75rem;
        padding: .2rem .5rem;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        background: #fff;
        box-shadow: 0 2px 5px rgba(15, 23, 42, .06);
        font-size: .68rem;
        line-height: 1.1;
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }

    #sale-options-panel .variant-choice:hover:not(:disabled) {
        transform: translateY(-1px);
        border-color: #818cf8;
        box-shadow: 0 5px 10px rgba(79, 70, 229, .14);
    }

    #sale-options-panel .variant-choice.is-selected {
        border-color: #4f46e5;
        background: #eef2ff;
        color: #3730a3;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, .15), 0 6px 12px rgba(79, 70, 229, .14);
    }

    #sale-options-panel .variant-choice:disabled {
        cursor: not-allowed;
        opacity: .45;
        box-shadow: none;
    }

    #sale-options-panel .variant-choice .size-3 {
        width: .55rem;
        height: .55rem;
        box-shadow: inset 0 0 0 1px rgba(0,0,0,.12);
    }

    .dark #sale-options-panel [data-sale-option] {
        border-color: #374151;
        background: linear-gradient(145deg, #1f2937, #111827);
    }

    .dark #sale-options-panel .sale-option-button,
    .dark #sale-options-panel .variant-choice {
        border-color: #475569;
        background: #1f2937;
        color: #f8fafc;
    }

    .dark #sale-options-panel .sale-option-button.is-selected {
        border-color: #818cf8;
        background: linear-gradient(135deg, #312e81, #134e4a);
        box-shadow: 0 0 0 3px rgba(129, 140, 248, .24), 0 12px 20px rgba(15, 23, 42, .35);
    }

    .dark #sale-options-panel .variant-choice.is-selected {
        border-color: #818cf8;
        background: #3730a3;
        color: #fff;
        box-shadow: 0 0 0 3px rgba(129, 140, 248, .22), 0 6px 12px rgba(15, 23, 42, .35);
    }

    @@media (min-width: 1024px) {
        #product-gallery-column {
            align-self: start;
            min-height: 42rem;
            padding-top: 0;
        }

        #purchase-panel {
            align-self: start;
            margin-top: -4.5rem;
        }
    }
</style>

@{
    ViewData["Title"] = Model.Name;
    var selectedVariant = Model.SelectedVariant;
    var hasAvailableVariant = Model.Options.SelectMany(x => x.Choices).Any(x => x.IsAvailable);
    var categoryNames = Model.Categories.Select(x => x.Name).Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
}

