<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - پنل مدیریت</title>
    <link rel="stylesheet" href="~/assets/css/app.css" asp-append-version="true" />
</head>
<body class="admin-shell bg-light dark:bg-background-dark text-text-primary-light dark:text-text-primary-dark">
    <svg aria-hidden="true" class="admin-icon-sprite">
        <symbol id="admin-i-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10Z"/></symbol>
        <symbol id="admin-i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
        <symbol id="admin-i-box" viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Zm0 0v9m8-4.5-8 4.5m-8-4.5 8 4.5"/></symbol>
        <symbol id="admin-i-grid" viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></symbol>
        <symbol id="admin-i-orders" viewBox="0 0 24 24"><path d="M6 3h12a2 2 0 0 1 2 2v16H4V5a2 2 0 0 1 2-2Zm3 5h6m-6 4h6m-6 4h4"/></symbol>
        <symbol id="admin-i-wallet" viewBox="0 0 24 24"><path d="M4 6h16v14H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h14v4H4a2 2 0 0 0 0 4h16"/><path d="M16 12h2"/></symbol>
        <symbol id="admin-i-percent" viewBox="0 0 24 24"><path d="M7 7h.01M17 17h.01M6 18 18 6"/><circle cx="7" cy="7" r="2"/><circle cx="17" cy="17" r="2"/></symbol>
        <symbol id="admin-i-users" viewBox="0 0 24 24"><path d="M16 20v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1m6-9a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7-3a3 3 0 0 1 0 6m4 6v-1a4 4 0 0 0-3-3.87"/></symbol>
        <symbol id="admin-i-chart" viewBox="0 0 24 24"><path d="M4 19V5m0 14h16M8 16v-4m4 4V8m4 8v-7"/></symbol>
        <symbol id="admin-i-settings" viewBox="0 0 24 24"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z"/><path d="m19.4 15 .1.1a2 2 0 1 1-2.8 2.8l-.1-.1a2 2 0 0 0-3.4 1.4v.3a2 2 0 1 1-4 0v-.2a2 2 0 0 0-3.4-1.5l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A2 2 0 0 0 3.7 12H3.5a2 2 0 1 1 0-4h.2a2 2 0 0 0 1.5-3.4l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A2 2 0 0 0 11.5 3v-.2a2 2 0 1 1 4 0V3a2 2 0 0 0 3.4 1.5l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1A2 2 0 0 0 20.3 11h.2a2 2 0 1 1 0 4h-.2a2 2 0 0 0-.9 0Z"/></symbol>
        <symbol id="admin-i-backup" viewBox="0 0 24 24"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14a2 2 0 0 0 2-2v-2M3 16v2a2 2 0 0 0 2 2"/></symbol>
        <symbol id="admin-i-log" viewBox="0 0 24 24"><path d="M6 3h9l3 3v15H6V3Zm3 6h6m-6 4h6m-6 4h4"/></symbol>
        <symbol id="admin-i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></symbol>
        <symbol id="admin-i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5m0-8h.01"/></symbol>
    </svg>
    <div class="admin-frame">
        <aside class="admin-sidebar">
            <div class="admin-brand">
                <img src="~/assets/images/mountainous-logo-transparent.png" alt="خرازی کوهستانی" />
                <span>پنل مدیریت</span>
            </div>

            <nav class="admin-nav" aria-label="منوی پنل مدیریت">
                <a class="admin-nav-link active" href="@Url.Action("Index", "Admin")">
                    <span class="admin-nav-icon"><svg><use href="#admin-i-home"/></svg></span><span>پیشخوان</span>
                </a>
                <div class="admin-nav-group-title">فروشگاه</div>
                <a class="admin-nav-link" href="@Url.Action("CreateProductPage", "Admin")">
                    <span class="admin-nav-icon"><svg><use href="#admin-i-plus"/></svg></span><span>افزودن محصول</span>
                </a>
                <a class="admin-nav-link" href="#">
                    <span class="admin-nav-icon"><svg><use href="#admin-i-box"/></svg></span><span>لیست محصولات</span>
                </a>
                <a class="admin-nav-link" href="#">
                    <span class="admin-nav-icon"><svg><use href="#admin-i-grid"/></svg></span><span>دسته‌بندی‌ها</span>
                </a>
                <a class="admin-nav-link" href="#">
                    <span class="admin-nav-icon"><svg><use href="#admin-i-grid"/></svg></span><span>ویژگی‌ها و Variantها</span>
                </a>
                <div class="admin-nav-group-title">سفارش‌ها</div>
                <a class="admin-nav-link" href="#"><span class="admin-nav-icon"><svg><use href="#admin-i-orders"/></svg></span><span>لیست سفارش‌ها</span></a>
                <a class="admin-nav-link" href="#"><span class="admin-nav-icon"><svg><use href="#admin-i-wallet"/></svg></span><span>تراکنش‌ها</span></a>
                <a class="admin-nav-link" href="#"><span class="admin-nav-icon"><svg><use href="#admin-i-percent"/></svg></span><span>تخفیف‌ها و کوپن‌ها</span></a>
                <div class="admin-nav-group-title">مدیریت سیستم</div>
                <a class="admin-nav-link" href="#"><span class="admin-nav-icon"><svg><use href="#admin-i-users"/></svg></span><span>کاربران</span></a>
                <a class="admin-nav-link" href="#"><span class="admin-nav-icon"><svg><use href="#admin-i-chart"/></svg></span><span>گزارش‌ها</span></a>
                <a class="admin-nav-link" href="#"><span class="admin-nav-icon"><svg><use href="#admin-i-settings"/></svg></span><span>تنظیمات</span></a>
                <a class="admin-nav-link" href="#"><span class="admin-nav-icon"><svg><use href="#admin-i-backup"/></svg></span><span>پشتیبان‌گیری</span></a>
                <a class="admin-nav-link" href="#"><span class="admin-nav-icon"><svg><use href="#admin-i-log"/></svg></span><span>لاگ‌های سیستم</span></a>
            </nav>

            <div class="admin-sidebar-footer">
                <span class="admin-avatar">م</span>
                <div><strong>مدیر سیستم</strong><small>دسترسی کامل</small></div>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <button class="admin-mobile-toggle" type="button" aria-label="باز کردن منو" onclick="document.body.classList.toggle('admin-sidebar-open')">☰</button>
                <div class="admin-breadcrumb">@ViewData["Title"]</div>
                <div class="admin-topbar-actions">
                    <button type="button" id="dark-mode-toggle" class="admin-icon-button" aria-label="تغییر حالت نمایش">
                        <svg aria-hidden="true"><use href="#admin-i-sun"/></svg>
                    </button>
                    <a href="/" class="admin-site-link">مشاهده سایت</a>
                </div>
            </header>
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>
    <div class="admin-sidebar-overlay" onclick="document.body.classList.remove('admin-sidebar-open')"></div>
    <script src="~/assets/js/dependencies/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
