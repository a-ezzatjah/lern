@model ServiceContract.DTO.DtoProduct.ProductCardDto
@{
    var price = Model.HasMultipleOptions ? Model.MinPrice : Model.FinalPrice;
    var productUrl = $"/product/{Model.Id}";
}
<article class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-lg product-box-item h-full flex flex-col" itemscope itemtype="http://schema.org/Product">
    <div class="flex justify-between items-start min-h-7">
        @if (Model.DiscountPercent.HasValue)
        {
            <span class="bg-secondary text-white px-2 py-1 rounded-lg text-xs">@Model.DiscountPercent.Value.ToString("0.##")٪</span>
        }
        <span class="text-xs @(Model.IsAvailable ? "text-green-600" : "text-rose-600")">@(Model.IsAvailable ? "موجود" : "ناموجود")</span>
    </div>
    <a href="@productUrl" class="block" aria-label="مشاهده @Model.Name">
    <figure class="flex image justify-center my-4 h-44">
        @if (!string.IsNullOrWhiteSpace(Model.PrimaryImageUrl))
        {
            <img class="max-h-full max-w-full object-contain" src="@Model.PrimaryImageUrl" loading="lazy" alt="@Model.Name" itemprop="image">
        }
        else
        {
            <img class="max-h-full max-w-full object-contain" src="~/assets/images/logo.png" loading="lazy" alt="@Model.Name">
        }
    </figure>
    </a>
    <h3 class="text-base leading-8 line-clamp-2 mb-2 flex-1"><a href="@productUrl" class="text-gray-800 dark:text-white" itemprop="name">@Model.Name</a></h3>
    <footer itemprop="offers" itemscope itemtype="http://schema.org/Offer">
        <meta itemprop="priceCurrency" content="IRR">
        @if (price.HasValue)
        {
            <div class="flex items-center justify-between">
                <a href="@productUrl" class="bg-primary-grad text-white p-3 rounded-lg" aria-label="مشاهده محصول">←</a>
                <span class="text-xl font-bold dark:text-white" itemprop="price" content="@price.Value">@price.Value.ToString("N0") <span class="text-xs">تومان</span></span>
            </div>
        }
        else
        {
            <span class="text-sm text-gray-500">برای قیمت تماس بگیرید</span>
        }
    </footer>
</article>
