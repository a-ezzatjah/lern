@model ServiceContract.DTO.DtoProduct.ProductCardDto
@{
    var price = Model.HasMultipleOptions ? Model.MinPrice : Model.FinalPrice;
    var productUrl = Url.Action("Details", "StoreProduct", new { id = Model.Id }) ?? $"/product/{Model.Id}";
}

<article class="store-product-card product-box-item h-full" itemscope itemtype="https://schema.org/Product">
    <a href="@productUrl" class="store-product-media" aria-label="مشاهده @Model.Name">
        @if (!string.IsNullOrWhiteSpace(Model.PrimaryImageUrl))
        {
            <img class="store-product-image" src="@Model.PrimaryImageUrl" loading="lazy" alt="@Model.Name" itemprop="image">
        }
        else
        {
            <img class="store-product-image" src="~/assets/images/logo.png" loading="lazy" alt="@Model.Name">
        }
        <div class="store-product-badges">
            @if (Model.DiscountPercent.HasValue)
            {
                <span class="store-discount-badge">@Model.DiscountPercent.Value.ToString("0.##")% تخفیف</span>
            }
            @if (Model.HasMultipleOptions)
            {
                <span class="store-option-badge">چند مدل</span>
            }
        </div>
    </a>
    <div class="store-product-content">
        <h3 class="store-product-title"><a href="@productUrl" itemprop="name">@Model.Name</a></h3>
        <div class="store-product-price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
            <meta itemprop="priceCurrency" content="IRR">
            @if (price.HasValue)
            {
                <div>
                    @if (Model.HasMultipleOptions)
                    {
                        <span class="store-price-prefix">از</span>
                    }
                    <strong itemprop="price" content="@price.Value">@price.Value.ToString("N0")</strong>
                    <span class="store-price-unit">تومان</span>
                </div>
            }
            else
            {
                <span class="store-price-unavailable">برای قیمت تماس بگیرید</span>
            }
        </div>
        <footer class="store-product-footer">
            <span class="store-product-status @(Model.IsAvailable ? "is-available" : "is-unavailable")">
                <span class="store-status-dot"></span>
                @(Model.IsAvailable ? "موجود در انبار" : "ناموجود")
            </span>
            <a href="@productUrl" class="store-product-arrow" aria-label="مشاهده جزئیات @Model.Name">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12H4.5m0 0 6-6m-6 6 6 6" /></svg>
            </a>
        </footer>
    </div>
</article>
