@model Entities.Order
<section class="order-card rounded-xl border border-gray-200 bg-white p-6 shadow-md dark:border-gray-700 dark:bg-gray-800">
    <h2 class="mb-4 text-lg font-semibold dark:text-white">اطلاعات ارسال سفارش</h2>
    @if (!string.IsNullOrWhiteSpace(Model.ShippingAddress))
    {
        <address class="space-y-2 text-sm not-italic text-gray-600 dark:text-gray-300">
            <p>@Model.ShippingProvince، @Model.ShippingCity، @Model.ShippingAddress</p>
            <p>گیرنده: @Model.ShippingReceiver · <bdi>@Model.ShippingPhone</bdi></p>
            <p>کد پستی: <bdi>@Model.ShippingPostalCode</bdi></p>
        </address>
    }
    else { <p>آدرس زمان ثبت این سفارش ذخیره نشده است.</p> }
    <p class="mt-3">روش ارسال: @lern.Infrastructure.ShippingPolicy.Label(Model.ShippingMethod)</p>
    @if (Model.ShippingPayOnDelivery) { <p class="mt-2 text-sm">هزینهٔ ارسال هنگام تحویل دریافت می‌شود و در مبلغ پرداخت اینترنتی نیست.</p> }
    @if (!string.IsNullOrWhiteSpace(Model.ShippingCarrier)) { <p class="mt-2">شرکت یا سرویس ارسال: @Model.ShippingCarrier</p> }
    @if (!string.IsNullOrWhiteSpace(Model.ShippingTrackingCode)) { <p class="mt-2">کد پیگیری ارسال: <bdi>@Model.ShippingTrackingCode</bdi></p> }
</section>
