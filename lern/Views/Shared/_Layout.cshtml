<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kohestani</title>

    @* ۱. بخش CSS ها را از index.html کپی کن و اینجا بگذار *@
    @* دقت کن مسیرها باید با /assets/ شروع شوند *@

    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>@ViewData["Title"] - Kohestani</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "فروشگاه اینترنتی کوهستانی")">
    <meta name="keywords" content="@(ViewData["MetaKeywords"] ?? "فروشگاه اینترنتی")">
    <meta name="robots" content="@(ViewData["Robots"] ?? "index, follow")">
    <meta name="author" content="آرینو">
    <meta name="copyright" content="All rights belong to Arino.">
    <link rel="apple-touch-icon" sizes="180x180" href="~/assets/images/favicon_io/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/assets/images/favicon_io/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/assets/images/favicon_io/favicon-16x16.png">
    @if (ViewData["CanonicalUrl"] is string canonicalUrl && !string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <link rel="canonical" href="@canonicalUrl">
    }
    <link rel="stylesheet" href="~/assets/js/plugin/story-player/styles.css">
    <link rel="stylesheet" href="~/assets/js/plugin/swiper/swiper-bundle.min.css">
    <link rel="stylesheet" href="~/assets/css/app.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/category-menu.css" asp-append-version="true">
    <link rel="preload" href="~/assets/fonts/payda/PeydaWebFaNum-Medium.woff2" as="font" type="font/woff2" crossorigin>

</head>
<body class="bg-light dark:bg-zinc-900 text-text-primary-light dark:text-text-primary-dark transition-colors duration-200">

    @* ۲. بخش Header و Navbar را از index.html کپی کن و اینجا بگذار *@

        <!-- ================= start header ================= -->
        <header id="topHeader" class="py-3 dark:shadow-primary-600 dark:shadow dark:bg-gray-800 sticky top-0 start-0 end-0 z-20 shadow-md bg-white">
            <div class="container">
                <!-- row top header -->
                <div class="grid place-items-center gap-3 grid-cols-12">
                    <!-- respnsive menu -->
                    <div class="lg:hidden col-span-4 w-full">
                        <button type="button" class="category-mobile-trigger" aria-label="باز کردن دسته‌بندی‌ها" onclick="toggleOffcanvas('offcanvas-right')">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                 stroke="currentColor" class="size-6 dark:text-white">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M3.75 6.75h16.5M3.75 12H12m-8.25 5.25h16.5" />
                            </svg>
                        <span>دسته‌بندی‌ها</span></button>
                    </div>
                    <!-- logo -->
                    <div class="lg:col-span-2 lg:order-1 order-2 col-span-4 w-full">
                        <a href="index.html">
                            <div class="lg:text-start text-center">
                                <img class="site-logo site-logo-header" src="/assets/images/mountainous-logo-transparent.png" loading="lazy" alt="لوگوی خرازی کوهستانی">
                            </div>
                        </a>
                    </div>
                    <!-- search and filter -->
                    <div class="lg:col-span-6 lg:block lg:order-2 order-4 hidden col-span-4 w-full">
                        <div class="flex items-center w-full justify-between">
                            <!-- search -->
                            <div class="flex w-full items-center">
                                <!--Search component-->
                                <div class="relative flex items-center w-full">
                                    <input type="search"
                                           id="searchInput"
                                           class="w-full appearance-none dark:text-white rounded-3xl border border-gray-300 dark:border-gray-600 py-3 ps-16 pe-4 dark:placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 shadow-sm"
                                           placeholder="جستجوی محصولات ....">
                                    <button class="bg-primary-grad p-2 text-white rounded-3xl absolute start-1 hover:opacity-90 transition-opacity">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                                        </svg>
                                    </button>
                                    <!--Search results-->
                                    <div id="searchResults" class="bg-white absolute top-13 border border-gray-400 z-10 end-0 start-0 dark:bg-gray-700 rounded-xl shadow-lg overflow-hidden hidden">
                                        <!-- The results content will be filled by JavaScript -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- login and basket and call and darkmode -->
                    <div class="lg:col-span-4 col-span-4 order-3 w-full">
                        <div class="flex items-baseline justify-end">
                            <!-- basket and call and darkmode -->
                            <div class="flex items-baseline md:me-5 me-2">
                                <!-- call -->
                                <a href="" class="lg:block hidden">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                         stroke="currentColor" class="size-6 dark:text-white">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                                    </svg>
                                </a>
                                <!-- basket -->
                                <button id="cart-drawer-button" type="button" class="relative md:ms-5 ms-2 flex" aria-label="باز کردن سبد خرید">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                         stroke="currentColor" class="size-7 dark:text-white">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                                    </svg>
                                    <span id="cart-count" class="size-5 text-sm -top-3 -end-2 absolute bg-primary-grad dark:bg-white text-white rounded-lg text-center">۰</span>
                                </button>
                                <!-- dark mode -->
                                <div class="md:ms-5 ms-2">
                                    <button id="dark-mode-toggle">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="lg:size-8 size-6 dark:block hidden dark:text-white">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
                                        </svg>
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="lg:size-8 size-6 dark:hidden block dark:text-white">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                            <div class="lg:inline-block hidden me-3 h-10 w-px self-stretch bg-neutral-200 dark:bg-white"></div>
                            <!-- account -->
                            <a href="@(User.Identity?.IsAuthenticated == true ? "/account" : "/login")" class="bg-white dark:bg-transparent dark:text-white text-dark flex lg:py-2 lg:px-3 lg:border lg:border-gray-400 rounded-lg" aria-label="@(User.Identity?.IsAuthenticated == true ? "حساب کاربری" : "ورود یا ثبت نام")">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                     stroke="currentColor" class="lg:size-6 lg:me-2 size-7">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                </svg>
                                <span class="lg:inline-block hidden">@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "ورود / ثبت نام")</span>
                            </a>
                        </div>
                    </div>
                </div>
                <!-- mega menu -->
                <div id="megaMenu" class="category-navigation relative grid-cols-12 place-items-center">
                    <div class="col-span-10 place-self-start">
                        <nav class="flex gap-x-9 mt-10 items-center">
                            <!-- menu -->
                            <ul class="flex dark:text-white items-center space-x-8 tracking-tight">
                                <li id="category-menu-trigger" class="py-2">
                                    <button type="button" class="category-menu-button" aria-expanded="false" aria-controls="category-menu-panel">
                                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                                        دسته‌بندی‌ها
                                        <svg class="category-chevron" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="m10 4-4 4 4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                    </button>
<div id="category-menu-panel" hidden><div class="category-loading" role="status">در حال دریافت دسته‌بندی‌ها…</div></div>
</li>
                                <li class="py-2">
                                    <a href="" class="flex space-x-3 hover:text-primary transition">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                             stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                                        </svg>
                                        <span>صفحه اصلی</span>
                                    </a>
                                </li>
                                <li class="py-2">
                                    <a href="" class="flex space-x-3 hover:text-primary transition">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                             stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z" />
                                        </svg>
                                        <span>لیست کالا ها</span>
                                    </a>
                                </li>
                                <li class="py-2">
                                    <a href="" class="flex space-x-3 hover:text-primary transition">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                             stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M15.182 15.182a4.5 4.5 0 0 1-6.364 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Z" />
                                        </svg>
                                        <span>سوالی دارید</span>
                                    </a>
                                </li>
                                <li class="py-2">
                                    <a href="" class="flex space-x-3 hover:text-primary transition">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                             stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                                        </svg>
                                        <span>پیگیری سفارش</span>
                                    </a>
                                </li>
                                <li class="py-2">
                                    <a href="" class="flex space-x-3 hover:text-primary transition">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                             stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 0 1 0 3.75H5.625a1.875 1.875 0 0 1 0-3.75Z" />
                                        </svg>
                                        <span>بلاگ</span>
                                    </a>
                                </li>
                                <li class="py-2">
                                    <a href="" class="flex space-x-3 hover:text-primary transition">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                             stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
