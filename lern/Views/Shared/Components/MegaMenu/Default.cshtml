@model lern.ViewComponents.MegaMenuViewModel
@{ Layout = null; }
<div class="category-browser">
    @if (Model.Roots.Count == 0)
    {
        <p class="category-loading">هنوز دسته‌بندی‌ای ثبت نشده است.</p>
    }
    <div class="category-tree">
        @foreach (var root in Model.Roots)
        {
            var children = Model.ChildrenByParent.TryGetValue(root.Id, out var items) ? items : Array.Empty<Entities.Category>();
            var iconPath = root.Name switch
            {
                "نخ" => "M4 17c2-4 5-4 7-1s5 3 7-1M5 8c2-3 5-3 7 0s5 3 7 0M4 4h.01M20 20h.01",
                "سوزن" => "M4 20 19 5m-3-1 4 4M4 20l4-1m10-15a2 2 0 0 1 2 2",
                "زیپ و متعلقات" => "M8 3v18m8-18v18M8 6h8M8 10h8M8 14h8m-6 4h4v3h-4z",
                "قیچی و لوازم برش" => "M9 9 20 20M9 15 20 4M7 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
                "لوازم خیاطی" => "M4 7h16v12H4zM7 7V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2m-8 5h6m-3-3v6",
                "لوازم چرخ خیاطی" => "M3 16h18v4H3zM5 16V7h9l3 4v5m-9-5h5m1-8v4m-3 9v-3",
                "مروارید - سرمه - منجق - تکه دوزی" => "M12 3 4 9l8 12 8-12-8-6Zm-8 6h16M9 9l3 12 3-12",
                "لوازم لباس زیر" => "M5 4v5c0 3 2 5 5 5h4c3 0 5-2 5-5V4M5 7h14M10 14v6m4-6v6",
                "لوازم پرده" => "M4 3h16M6 3v18l3-4 3 4 3-4 3 4V3M9 4v10m6-10v10",
                "کاموا و لوازم بافتنی" => "M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm-7-8 9-7M6 16l12-8M9 19l10-7m-7 8 5 2",
                "یراق - نوار - روبان - مغزی" => "M12 12c-2-3-7-5-8-2-1 3 4 4 8 2Zm0 0c2-3 7-5 8-2 1 3-4 4-8 2Zm0 0-4 9m4-9 4 9",
                "قیطان" => "M5 4c5-3 9 1 5 5s-7 7-2 10 10-2 11-5M4 6l2-3m11 13 3-2",
                "دکمه پرسی و متعلقات" => "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-3 6h.01M15 9h.01M9 15h.01M15 15h.01M5 5l3 3",
                "دکمه" or "دکمه مانتویی - اسپرت - پالتویی" => "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-3 6h.01M15 9h.01M9 15h.01M15 15h.01",
                _ => "M4 5h16v14H4zM4 10h16m-11 4h6"
            };
            <details class="category-root" open="@(root == Model.Roots.FirstOrDefault())">
                <summary><a asp-controller="StoreCategory" asp-action="Index" asp-route-id="@root.Id"><svg class="category-root-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="@iconPath" /></svg><span>@root.Name</span></a><svg class="category-chevron" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="m10 4-4 4 4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
                <div class="category-panel">
                    <div class="category-panel-heading"><h3>@root.Name</h3><a asp-controller="StoreCategory" asp-action="Index" asp-route-id="@root.Id">همهٔ محصولات <span aria-hidden="true">←</span></a></div>
                    @if (children.Count == 0)
                    {
                        <p class="category-empty">هنوز زیرمجموعه‌ای برای این دسته ثبت نشده است.</p>
                    }
                    else
                    {
                        <div class="category-cards">
                            @foreach (var child in children)
                            {
                                var hasGrandchildren = Model.ChildrenByParent.TryGetValue(child.Id, out var grandchildren) && grandchildren.Count > 0;
                                <section class="category-card">
                                    <h4><a asp-controller="StoreCategory" asp-action="Index" asp-route-id="@child.Id">@child.Name</a></h4>
                                    @if (hasGrandchildren)
                                    {
                                        <partial name="_CategoryMenuDescendants" model="@(new lern.ViewComponents.MegaMenuViewModel(grandchildren!, Model.ChildrenByParent))" />
                                    }
                                </section>
                            }
                        </div>
                    }
                </div>
            </details>
        }
    </div>
</div>
