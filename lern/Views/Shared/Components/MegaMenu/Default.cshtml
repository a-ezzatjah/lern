@model lern.ViewComponents.MegaMenuViewModel
@{ Layout = null; }
<div class="category-browser">
    @if (Model.Roots.Count == 0)
    {
        <p class="category-loading">هنوز دسته‌بندی‌ای ثبت نشده است.</p>
    }
    <div class="category-tree">
        @foreach (var root in Model.Roots)
        {
            var children = Model.ChildrenByParent.TryGetValue(root.Id, out var items) ? items : Array.Empty<Entities.Category>();
            <details class="category-root" open="@(root == Model.Roots.FirstOrDefault())">
                <summary><a asp-controller="StoreCategory" asp-action="Index" asp-route-id="@root.Id">@root.Name</a><svg class="category-chevron" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="m10 4-4 4 4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
                <div class="category-panel">
                    <div class="category-panel-heading"><h3>@root.Name</h3><a asp-controller="StoreCategory" asp-action="Index" asp-route-id="@root.Id">همهٔ محصولات <span aria-hidden="true">←</span></a></div>
                    @if (children.Count == 0)
                    {
                        <p class="category-empty">هنوز زیرمجموعه‌ای برای این دسته ثبت نشده است.</p>
                    }
                    else
                    {
                        <div class="category-cards">
                            @foreach (var child in children)
                            {
                                var hasGrandchildren = Model.ChildrenByParent.TryGetValue(child.Id, out var grandchildren) && grandchildren.Count > 0;
                                <section class="category-card">
                                    <h4><a asp-controller="StoreCategory" asp-action="Index" asp-route-id="@child.Id">@child.Name</a></h4>
                                    @if (hasGrandchildren)
                                    {
                                        <partial name="_CategoryMenuDescendants" model="@(new lern.ViewComponents.MegaMenuViewModel(grandchildren!, Model.ChildrenByParent))" />
                                    }
                                </section>
                            }
                        </div>
                    }
                </div>
            </details>
        }
    </div>
</div>
