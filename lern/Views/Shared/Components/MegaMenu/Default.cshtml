@model lern.ViewComponents.MegaMenuViewModel
@{ Layout = null; }

<div id="mega-menu-fire-target" class="bg-white dark:bg-zinc-900 container z-50 hidden top-[90%] drop-shadow-sm absolute mt-1 me-10 shadow-md rounded-b-md">
    <div class="grid grid-cols-12">
        <div class="col-span-2 h-[400px] overflow-y-auto border-e border-gray-200 dark:border-gray-700">
            <ul class="my-2 space-y-1">
                @foreach (var root in Model.Roots)
                {
                    <li data-mega-id="@root.Id" class="px-4 w-full border-opacity-0 hover:border-opacity-100 rounded-lg mega-menu-li">
                        <a href="#" class="flex items-center justify-between py-3">
                            <span class="text-xs">@root.Name</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                        </a>
                    </li>
                }
            </ul>
        </div>
        <div class="col-span-10 bg-white dark:bg-zinc-900">
            @foreach (var root in Model.Roots)
            {
                var children = Model.ChildrenByParent.TryGetValue(root.Id, out var items) ? items : Array.Empty<Entities.Category>();
                <div data-mega-target="@root.Id" class="@(root != Model.Roots.FirstOrDefault() ? "hidden" : "") h-[400px] overflow-y-auto p-5">
                    @if (children.Count == 0)
                    {
                        <p class="text-sm text-gray-500">برای این دسته هنوز زیرمجموعه‌ای ثبت نشده است.</p>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 content-start">
                            @foreach (var child in children)
                            {
                                var hasGrandchildren = Model.ChildrenByParent.TryGetValue(child.Id, out var grandchildren) && grandchildren.Count > 0;
                                <section class="rounded-xl border border-gray-100 bg-gray-50/70 p-4 dark:border-gray-700 dark:bg-zinc-800">
                                    <a href="#" class="mb-3 block border-b border-gray-200 pb-2 text-sm font-bold text-gray-900 hover:text-primary dark:border-gray-700 dark:text-white">@child.Name</a>
                                    @if (hasGrandchildren)
                                    {
                                        <ul class="grid grid-cols-1 gap-y-2">
                                            @foreach (var grandchild in grandchildren!)
                                            {
                                                <li><a href="#" class="block text-xs leading-5 text-gray-600 hover:text-primary dark:text-gray-300">@grandchild.Name</a></li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-gray-400">مشاهدهٔ محصولات این دسته</span>
                                    }
                                </section>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
