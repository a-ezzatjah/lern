@{ Layout = null; ViewData["Title"] = "ثبت نام"; }
<!doctype html>
<html lang="fa" dir="rtl"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>ثبت نام</title><script>if(localStorage.getItem('theme')==='dark'||(!localStorage.getItem('theme')&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark');</script><link rel="stylesheet" href="~/assets/css/arino-account.css" asp-append-version="true" /><link rel="preload" href="~/assets/fonts/payda/PeydaWebFaNum-Medium.woff2" as="font" type="font/woff2" crossorigin /></head>
<body class="bg-light dark:bg-zinc-900 text-text-primary-light dark:text-text-primary-dark"><button id="theme-toggle" type="button" class="fixed top-5 left-5 z-10 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm dark:border-gray-600 dark:bg-gray-800 dark:text-white" aria-label="تغییر حالت نمایش">☾ / ☀</button><main class="min-h-screen flex flex-col lg:flex-row"><section class="lg:w-1/2 auth-bg relative hidden lg:flex items-center justify-center p-12"><div class="absolute inset-0 bg-black/30"></div><div class="relative z-10 text-white text-center max-w-md"><img src="/assets/images/mountainous-logo-transparent.png" alt="لوگوی خرازی کوهستانی" class="w-32 h-28 object-contain mx-auto mb-6 drop-shadow-lg" /><h1 class="text-3xl font-bold mb-4">عضو فروشگاه کوهستانی شوید</h1><p class="text-lg">خرید سریع‌تر و دسترسی به سفارش‌های خود را تجربه کنید.</p></div></section><section class="lg:w-1/2 flex items-center justify-center p-6"><div class="w-full max-w-md"><a href="/" class="flex items-center justify-center mb-8 text-xl font-bold text-dark dark:text-light">فروشگاه <span class="text-primary me-1">کوهستانی</span></a><div class="bg-white dark:bg-gray-800 rounded-2xl shadow-soft dark:shadow-soft-dark p-8 border border-gray-100 dark:border-gray-700"><div class="text-center mb-7"><h2 class="text-2xl font-bold mb-2">ایجاد حساب کاربری</h2><p class="text-gray-500 dark:text-gray-400">اطلاعات زیر را تکمیل کنید</p></div><form id="register-form" class="space-y-4"><div class="grid grid-cols-2 gap-3"><div><label class="block text-sm mb-2" for="first-name">نام</label><input id="first-name" class="w-full px-4 py-3 border rounded-xl dark:bg-gray-700 dark:border-gray-600 dark:text-white" required /></div><div><label class="block text-sm mb-2" for="last-name">نام خانوادگی</label><input id="last-name" class="w-full px-4 py-3 border rounded-xl dark:bg-gray-700 dark:border-gray-600 dark:text-white" required /></div></div><div><label class="block text-sm mb-2" for="phone">شماره موبایل</label><input id="phone" type="tel" inputmode="numeric" placeholder="09xxxxxxxxx" class="w-full px-4 py-3 border rounded-xl dark:bg-gray-700 dark:border-gray-600 dark:text-white" required /></div><div><label class="block text-sm mb-2" for="email">ایمیل <span class="text-gray-400">(اختیاری)</span></label><input id="email" type="email" autocomplete="email" class="w-full px-4 py-3 border rounded-xl dark:bg-gray-700 dark:border-gray-600 dark:text-white" /></div><div><label class="block text-sm mb-2" for="password">رمز عبور</label><input id="password" type="password" minlength="8" autocomplete="new-password" placeholder="حداقل ۸ کاراکتر" class="w-full px-4 py-3 border rounded-xl dark:bg-gray-700 dark:border-gray-600 dark:text-white" required /></div><div><label class="block text-sm mb-2" for="confirm-password">تکرار رمز عبور</label><input id="confirm-password" type="password" autocomplete="new-password" class="w-full px-4 py-3 border rounded-xl dark:bg-gray-700 dark:border-gray-600 dark:text-white" required /></div><p id="form-message" role="alert" class="hidden rounded-lg px-4 py-3 text-sm"></p><button id="submit-button" type="submit" class="w-full py-3 px-4 rounded-xl text-white bg-primary hover:bg-primary/90">ثبت نام و ورود</button></form><p class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400">قبلاً ثبت نام کرده‌اید؟ <a href="/login" class="font-medium text-primary hover:underline">وارد شوید</a></p></div></div></section></main><script>document.getElementById('theme-toggle').addEventListener('click',()=>{document.documentElement.classList.toggle('dark');localStorage.setItem('theme',document.documentElement.classList.contains('dark')?'dark':'light');});const message=document.getElementById('form-message'),button=document.getElementById('submit-button');document.getElementById('register-form').addEventListener('submit',async e=>{e.preventDefault();message.className='hidden';const password=document.getElementById('password').value;if(password!==document.getElementById('confirm-password').value){message.textContent='تکرار رمز عبور یکسان نیست.';message.className='block rounded-lg bg-red-50 text-red-700 px-4 py-3 text-sm';return;}button.disabled=true;button.textContent='در حال ثبت نام...';try{const r=await fetch('/api/account/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({firstName:document.getElementById('first-name').value,lastName:document.getElementById('last-name').value,phoneNumber:document.getElementById('phone').value,email:document.getElementById('email').value||null,password})});const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.message||'ثبت نام انجام نشد.');location.assign('/account');}catch(error){message.textContent=error.message;message.className='block rounded-lg bg-red-50 text-red-700 px-4 py-3 text-sm';}finally{button.disabled=false;button.textContent='ثبت نام و ورود';}});</script></body></html>
