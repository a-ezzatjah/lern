@{ Layout = null; ViewData["Title"] = "نام‌نویسی"; }
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" /><title>نام‌نویسی در فروشگاه کوهستانی</title>
    <script>if(localStorage.getItem('theme')==='dark'||(!localStorage.getItem('theme')&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark');</script>
    <link rel="stylesheet" href="~/assets/css/arino-account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/auth-pages.css" asp-append-version="true" />
</head>
<body class="auth-page has-mobile-bottom-nav">
<main class="auth-stage">
    <div class="auth-card auth-card-register">
        <div class="auth-card-top"><a href="/" class="auth-brand"><img src="/assets/images/mountainous-logo-transparent.png" alt="" /><span>فروشگاه کوهستانی</span></a><button id="theme-toggle" class="auth-theme" type="button" aria-label="تغییر حالت نمایش">☾ / ☀</button></div>
        <header class="auth-heading"><span class="auth-eyebrow">شروع یک همراهی تازه</span><h1>ایجاد حساب کاربری</h1><p>برای خرید آسان‌تر و پیگیری سفارش‌ها نام‌نویسی کنید.</p></header>
        <form id="register-form" class="auth-form">
            <div class="auth-name-row">
                <div class="auth-field"><label for="first-name">نام</label><input id="first-name" name="firstName" autocomplete="given-name" maxlength="100" required /></div>
                <div class="auth-field"><label for="last-name">نام خانوادگی</label><input id="last-name" name="lastName" autocomplete="family-name" maxlength="100" required /></div>
            </div>
            <div class="auth-field"><label for="phone">شماره موبایل</label><input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="32" placeholder="09123456789" dir="ltr" required /></div>
            <div class="auth-field"><label for="email">ایمیل <span class="auth-optional">(اختیاری)</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="256" dir="ltr" placeholder="name@example.com" /></div>
            <div class="auth-field"><label for="password">رمز عبور</label><div class="auth-password"><input id="password" name="password" type="password" autocomplete="new-password" required aria-describedby="password-help" /><button type="button" data-password-toggle="password" aria-label="نمایش رمز عبور" aria-pressed="false">نمایش</button></div><small id="password-help">یک عبارت با حداقل ۱۵ کاراکتر انتخاب کنید.</small></div>
            <div class="auth-field"><label for="confirm-password">تکرار رمز عبور</label><input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" required /></div>
            <p id="form-message" class="auth-message" role="alert" hidden></p>
            <button id="submit-button" class="auth-submit" type="submit">نام‌نویسی و ورود</button>
        </form>
        <p class="auth-footnote">قبلاً نام‌نویسی کرده‌اید؟ <a href="/login">وارد شوید</a></p>
        <a href="/" class="auth-back">بازگشت به فروشگاه ←</a>
    </div>
</main>
<script src="~/assets/js/auth-pages.js" asp-append-version="true"></script>
<partial name="_MobileBottomNav" />
</body></html>
