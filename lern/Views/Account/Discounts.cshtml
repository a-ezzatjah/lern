@model AccountDiscountsViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "تخفیف‌های من";
    var tabs = new[] { (Key: "active", Label: "تخفیف‌های فعال"), (Key: "used", Label: "استفاده‌شده"), (Key: "expired", Label: "منقضی‌شده") };
    var emptyMessage = Model.Tab switch { "used" => "کد تخفیف استفاده‌شده‌ای ندارید", "expired" => "کد تخفیف منقضی‌شده‌ای ندارید", _ => "کد تخفیف فعالی ندارید" };
}
<section class="w-full p-4 md:p-6">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-dark dark:text-light">کدهای تخفیف من</h1>
        <p class="text-gray-600 dark:text-gray-400">کدهای تخفیف فعال و استفاده‌شده شما</p>
    </div>
    <nav class="mb-6 overflow-x-auto border-b border-gray-200 dark:border-gray-700" aria-label="وضعیت کدهای تخفیف">
        <div class="flex min-w-max">
            @foreach (var tab in tabs)
            {
                <a asp-action="Discounts" asp-route-tab="@tab.Key" aria-current="@(Model.Tab == tab.Key ? "page" : null)" class="ms-2 rounded-t-lg border-b-2 p-4 @(Model.Tab == tab.Key ? "border-primary text-primary" : "border-transparent text-gray-600 hover:border-gray-300 dark:text-gray-300")">@tab.Label</a>
            }
        </div>
    </nav>
    <div class="rounded-lg border border-gray-100 bg-white p-4 shadow-soft dark:border-gray-700 dark:bg-card-dark dark:shadow-soft-dark">
        @if (Model.Coupons.Count > 0)
        {
            <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                @foreach (var coupon in Model.Coupons)
                {
                    <partial name="_DiscountCard" model="@(new AccountDiscountCardViewModel { Coupon = coupon, IsUsed = Model.Tab == "used" })" />
                }
            </div>
        }
        else
        {
            <p class="py-10 text-center text-gray-600 dark:text-gray-400">@emptyMessage</p>
        }
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="صفحات تخفیف‌ها" class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-gray-200 pt-4 text-sm dark:border-gray-700">
                <span class="text-gray-500 dark:text-gray-400">صفحه @Model.Page از @Model.TotalPages — @Model.TotalCount تخفیف</span>
                <div class="flex flex-wrap gap-2">
                    @if (Model.Page > 1) { <a asp-action="Discounts" asp-route-tab="@Model.Tab" asp-route-page="@(Model.Page - 1)" class="rounded-lg border px-3 py-2 dark:border-gray-600 dark:text-white">قبلی</a> }
                    @for (var number = Math.Max(1, Model.Page - 2); number <= Math.Min(Model.TotalPages, Model.Page + 2); number++)
                    {
                        <a asp-action="Discounts" asp-route-tab="@Model.Tab" asp-route-page="@number" aria-current="@(number == Model.Page ? "page" : null)" class="rounded-lg border px-3 py-2 @(number == Model.Page ? "bg-primary text-white" : "dark:text-white") dark:border-gray-600">@number</a>
                    }
                    @if (Model.Page < Model.TotalPages) { <a asp-action="Discounts" asp-route-tab="@Model.Tab" asp-route-page="@(Model.Page + 1)" class="rounded-lg border px-3 py-2 dark:border-gray-600 dark:text-white">بعدی</a> }
                </div>
            </nav>
        }
    </div>
</section>
