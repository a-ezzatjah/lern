@model IReadOnlyList<Entities.Address>
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "آدرس‌های من";
}
<section class="w-full p-4 md:p-6">
    <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-dark dark:text-light">آدرس‌های من</h1>
            <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">مدیریت آدرس‌های تحویل سفارش</p>
        </div>
        @if (Model.Count < 3)
        {
            <a href="/address?new=1&amp;from=account" class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary/90">
                <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M10 3a1 1 0 0 1 1 1v5h5a1 1 0 1 1 0 2h-5v5a1 1 0 1 1-2 0v-5H4a1 1 0 1 1 0-2h5V4a1 1 0 0 1 1-1Z" /></svg>
                افزودن آدرس جدید
            </a>
        }
    </div>
    @if (Model.Count == 0)
    {
        <div class="rounded-xl border border-gray-200 bg-white p-8 text-center text-gray-500 shadow-soft dark:border-gray-700 dark:bg-card-dark dark:text-gray-400">هنوز آدرسی ثبت نکرده‌اید.</div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            @foreach (var address in Model)
            {
                <article class="relative rounded-xl border-2 bg-white p-6 shadow-soft dark:bg-card-dark @(address.IsDefault ? "border-primary dark:border-primary-dark" : "border-gray-200 dark:border-gray-700")">
                    <div class="mb-4 flex items-start justify-between gap-3">
                        <div>
                            <h2 class="text-lg font-medium text-dark dark:text-light">@address.Title</h2>
                            @if (address.IsDefault) { <span class="mt-2 inline-block rounded-full bg-primary px-2 py-1 text-xs text-white">پیش‌فرض</span> }
                        </div>
                        <div class="flex shrink-0 items-center gap-3">
                            <a href="/address?id=@address.Id&amp;from=account" aria-label="ویرایش @address.Title" title="ویرایش" class="text-primary hover:opacity-70 dark:text-primary-dark">
                                <svg aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-5m-1.414-9.414a2 2 0 0 1 2.828 2.828L11.828 15H9v-2.828l8.586-8.586Z" /></svg>
                            </a>
                            <form asp-action="DeleteAddress" asp-route-id="@address.Id" method="post" onsubmit="return confirm('این آدرس حذف شود؟')">
                                @Html.AntiForgeryToken()
                                <button type="submit" aria-label="حذف @address.Title" title="حذف" class="text-danger hover:opacity-70 dark:text-danger-dark"><svg aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 1 1-1h-4a1 1 0 0 1-1 1v3M4 7h16" /></svg></button>
                            </form>
                        </div>
                    </div>
                    <div class="space-y-1 text-sm text-gray-600 dark:text-gray-400">
                        <p>@address.Province، @address.City، @address.Details</p>
                        <p>کد پستی: @address.PostalCode</p>
                        <p>@address.ReceiverName - @address.Phone</p>
                    </div>
                    @if (!address.IsDefault)
                    {
                        <form asp-action="SetDefaultAddress" asp-route-id="@address.Id" method="post" class="mt-4 border-t border-gray-200 pt-4 dark:border-gray-700">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-sm text-primary hover:underline dark:text-primary-dark">تنظیم به عنوان پیش‌فرض</button>
                        </form>
                    }
                </article>
            }
        </div>
    }
</section>
