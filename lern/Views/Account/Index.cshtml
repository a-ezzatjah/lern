                                var successful = transaction.Status == Entities.PaymentStatus.Successful;
                                var date = transaction.CreatedAt.ToLocalTime();
                                var calendar = new System.Globalization.PersianCalendar();
                                var dateLabel = $"{calendar.GetYear(date):0000}/{calendar.GetMonth(date):00}/{calendar.GetDayOfMonth(date):00} - {date:HH:mm}";
                                <div class="flex flex-wrap items-center gap-3 p-4">
                                    <span class="rounded-full px-3 py-2 text-sm @(successful ? "bg-green-50 text-green-700 dark:bg-green-900/30 dark:text-green-300" : "bg-red-50 text-red-700 dark:bg-red-900/30 dark:text-red-300")">@(successful ? "موفق" : "ناموفق")</span>
