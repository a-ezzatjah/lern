                            var calendar = new System.Globalization.PersianCalendar();
                            var dateLabel = $"{calendar.GetYear(local):0000}/{calendar.GetMonth(local):00}/{calendar.GetDayOfMonth(local):00}";
                            var statusLabel = order.Status switch
                            {
                                Entities.OrderStatus.Pending => "در انتظار پرداخت",
                                Entities.OrderStatus.Paid => "پرداخت شده",
