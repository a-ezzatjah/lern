<!-- chart -->
<script>
    const activityCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityCounts));
    const chartCanvas = document.getElementById('userActivityChart');
    const activityLabelFont = getComputedStyle(document.body).fontFamily;
    const activityLabelColor = () => document.documentElement.classList.contains('dark') ? '#e2e8f0' : '#475569';
    const chart = chartCanvas && typeof Chart !== 'undefined' ? new Chart(chartCanvas, {
        type: 'bar',
        data: {
            labels: ['بازدید محصول', 'اقلام سبد', 'سفارش', 'علاقه‌مندی', 'نظر'],
            datasets: [{ label: 'تعداد فعالیت', data: activityCounts.week,
                backgroundColor: ['#434ece', '#3fbd50', '#606fd8', '#e25b79', '#7d89e8'], borderRadius: 6 }]
        },
        options: { responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false }, tooltip: { titleFont: { family: activityLabelFont, size: 14 }, bodyFont: { family: activityLabelFont, size: 14 } } },
            scales: {
                x: { ticks: { font: { family: activityLabelFont, size: 14, weight: 'normal' }, color: activityLabelColor(), maxRotation: 35, minRotation: 0 } },
                y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0, font: { family: activityLabelFont, size: 14 }, color: activityLabelColor() } }
            } }
    }) : null;
    if (chart) new MutationObserver(() => {
        chart.options.scales.x.ticks.color = activityLabelColor();
        chart.options.scales.y.ticks.color = activityLabelColor();
        chart.update();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    function showActivity(period) {
        const values = activityCounts[period] || [];
        document.querySelectorAll('.activity-period').forEach(button => {
            const active = button.dataset.period === period;
            button.setAttribute('aria-selected', String(active));
            button.classList.toggle('bg-primary', active);
            button.classList.toggle('text-white', active);
            button.classList.toggle('bg-gray-100', !active);
            button.classList.toggle('dark:bg-gray-700', !active);
        });
        document.getElementById('activity-empty').classList.toggle('hidden', values.some(value => value > 0));
        document.getElementById('activity-chart-wrap').classList.toggle('hidden', !values.some(value => value > 0));
        if (chart) { chart.data.datasets[0].data = values; chart.update(); }
    }
    document.querySelectorAll('.activity-period').forEach(button => button.addEventListener('click', () => showActivity(button.dataset.period)));
    showActivity('week');

    async function loadAccountData() {
        const profileResponse = await fetch('/api/account/me', { credentials: 'same-origin', cache: 'no-store' });
        if (!profileResponse.ok) {
            location.assign('/login');
            return;
        }

        const user = await profileResponse.json();
        const fullName = `${user.firstName || ''} ${user.lastName || ''}`.trim() || 'کاربر';
        document.querySelectorAll('[data-user-name]').forEach(element => element.textContent = fullName);
        const profileImage = user.profileImageUrl || '/assets/images/user/user.jpg';
        document.querySelectorAll('[data-profile-image]').forEach(image => image.src = `${profileImage}${profileImage.includes('?') ? '&' : '?'}v=${Date.now()}`);

        const dashboardResponse = await fetch('/api/account/dashboard', { credentials: 'same-origin' });
        if (dashboardResponse.ok) {
            const dashboard = await dashboardResponse.json();
            const purchaseTotal = Number(dashboard.purchaseTotal || 0);
            const rating = Math.max(0, Math.min(100, Number(dashboard.ratingOutOf100 || 0)));
            const purchaseTotalElement = document.getElementById('purchase-total');
            const ratingElement = document.getElementById('rating-out-of-100');
            const ratingProgress = document.getElementById('rating-progress');
            const ratingPercentage = document.getElementById('rating-percentage');
            if (purchaseTotalElement) purchaseTotalElement.innerHTML = `${purchaseTotal.toLocaleString('fa-IR')} <span class="text-sm">تومان</span>`;
            if (ratingElement) ratingElement.innerHTML = `${rating.toLocaleString('fa-IR')} <span class="text-sm">از 100</span>`;
            if (ratingProgress) ratingProgress.style.width = `${rating}%`;
            if (ratingPercentage) ratingPercentage.textContent = `${rating.toLocaleString('fa-IR')}%`;
        }
    }

    document.querySelectorAll('[data-logout]').forEach(element => element.addEventListener('click', async event => {
        event.preventDefault();
        await fetch('/api/account/logout', { method: 'POST', credentials: 'same-origin' });
        location.assign('/');
    }));

    loadAccountData().catch(() => location.assign('/login'));

</script>


