@{ Layout = null; ViewData["Title"] = "ورود"; }
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ورود به حساب کاربری</title>
    <script>if(localStorage.getItem('theme')==='dark'||(!localStorage.getItem('theme')&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark');</script>
    <link rel="stylesheet" href="~/assets/css/arino-account.css" asp-append-version="true" />
    <link rel="preload" href="~/assets/fonts/payda/PeydaWebFaNum-Medium.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body class="bg-light dark:bg-zinc-900 text-text-primary-light dark:text-text-primary-dark">
<main class="min-h-screen flex flex-col lg:flex-row">
    <section class="lg:w-1/2 auth-bg relative hidden lg:flex items-center justify-center p-12"><div class="absolute inset-0 bg-black/30"></div><div class="relative z-10 text-white text-center max-w-md"><div class="w-20 h-20 rounded-xl bg-primary-grad flex items-center justify-center mx-auto mb-6 text-4xl">🛍</div><h1 class="text-3xl font-bold mb-4">به فروشگاه ما خوش آمدید</h1><p class="text-lg">برای مدیریت سفارش‌ها، آدرس‌ها و اطلاعات حساب وارد شوید.</p></div></section>
    <section class="lg:w-1/2 flex items-center justify-center p-6"><div class="w-full max-w-md"><div class="flex items-center justify-between mb-8"><a href="/" class="text-xl font-bold text-dark dark:text-light">فروشگاه <span class="text-primary me-1">کوهستانی</span></a><button id="theme-toggle" type="button" class="rounded-lg border border-gray-200 dark:border-gray-600 px-3 py-2 text-sm dark:text-white" aria-label="تغییر حالت نمایش">☾ / ☀</button></div><div class="bg-white dark:bg-gray-800 rounded-2xl shadow-soft dark:shadow-soft-dark p-8 border border-gray-100 dark:border-gray-700"><div class="text-center mb-8"><h2 class="text-2xl font-bold text-dark dark:text-light mb-2">ورود به حساب کاربری</h2><p class="text-gray-500 dark:text-gray-400">شماره موبایل و رمز عبور خود را وارد کنید</p></div><form id="login-form" class="space-y-5"><div><label for="phone" class="block text-sm font-medium mb-2">شماره موبایل</label><input id="phone" type="tel" inputmode="numeric" autocomplete="tel" placeholder="09xxxxxxxxx" class="w-full px-4 py-3 border rounded-xl focus:outline-none focus:ring-2 focus:ring-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" required /></div><div><label for="password" class="block text-sm font-medium mb-2">رمز عبور</label><div class="relative"><input id="password" type="password" autocomplete="current-password" placeholder="رمز عبور خود را وارد کنید" class="w-full px-4 py-3 border rounded-xl focus:outline-none focus:ring-2 focus:ring-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" required /><button type="button" class="absolute left-3 top-3 text-gray-400" onclick="togglePassword()">نمایش</button></div></div><label class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-300"><input id="remember-me" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary" />مرا به خاطر بسپار <span class="text-xs text-gray-400">(تا ۱۴ روز)</span></label><p id="form-message" role="alert" class="hidden rounded-lg px-4 py-3 text-sm"></p><button id="submit-button" type="submit" class="w-full py-3 px-4 rounded-xl text-white bg-primary hover:bg-primary/90 transition-colors">ورود به حساب</button></form><p class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400">حساب کاربری ندارید؟ <a href="/register" class="font-medium text-primary hover:underline">ثبت نام کنید</a></p></div></div></section>
</main>
<script>
const message=document.getElementById('form-message'), button=document.getElementById('submit-button');
function togglePassword(){const input=document.getElementById('password'); input.type=input.type==='password'?'text':'password';}
document.getElementById('theme-toggle').addEventListener('click',()=>{document.documentElement.classList.toggle('dark');localStorage.setItem('theme',document.documentElement.classList.contains('dark')?'dark':'light');});
document.getElementById('login-form').addEventListener('submit',async e=>{e.preventDefault();message.className='hidden';button.disabled=true;button.textContent='در حال ورود...';try{const r=await fetch('/api/account/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({phoneNumber:document.getElementById('phone').value,password:document.getElementById('password').value,rememberMe:document.getElementById('remember-me').checked})});const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.message||'ورود انجام نشد.');location.assign('/account');}catch(error){message.textContent=error.message;message.className='block rounded-lg bg-red-50 text-red-700 px-4 py-3 text-sm';}finally{button.disabled=false;button.textContent='ورود به حساب';}});
</script>
</body></html>
