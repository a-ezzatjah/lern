@{ Layout = null; ViewData["Title"] = "ورود"; }
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" /><title>ورود به فروشگاه کوهستانی</title>
    <script>if(localStorage.getItem('theme')==='dark'||(!localStorage.getItem('theme')&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark');</script>
    <link rel="stylesheet" href="~/assets/css/arino-account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/auth-pages.css" asp-append-version="true" />
</head>
<body class="auth-page has-mobile-bottom-nav">
<main class="auth-stage">
    <div class="auth-card">
        <div class="auth-card-top"><a href="/" class="auth-brand"><img src="/assets/images/mountainous-logo-transparent.png" alt="" /><span>فروشگاه کوهستانی</span></a><button id="theme-toggle" class="auth-theme" type="button" aria-label="تغییر حالت نمایش">☾ / ☀</button></div>
        <header class="auth-heading"><span class="auth-eyebrow">دوباره خوش آمدید</span><h1>ورود به حساب کاربری</h1><p>سفارش‌ها و خریدهای خود را دنبال کنید.</p></header>
        @if (TempData["AuthenticationMessage"] is string notice) { <p role="status" class="auth-notice">@notice</p> }
        <div class="auth-tabs" role="tablist" aria-label="روش ورود">
            <button id="password-tab" type="button" role="tab" aria-selected="true" aria-controls="password-panel" tabindex="0">ورود با رمز عبور</button>
            <button id="phone-tab" type="button" role="tab" aria-selected="false" aria-controls="phone-panel" tabindex="-1">ورود با کد یک‌بارمصرف</button>
        </div>
        <section id="password-panel" role="tabpanel" aria-labelledby="password-tab">
            <form id="login-form" class="auth-form" data-return-url="@(ViewData["ReturnUrl"] as string ?? "/account")">
                <div class="auth-field"><label for="phone">شماره موبایل</label><input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="username" maxlength="32" placeholder="09123456789" dir="ltr" required /></div>
                <div class="auth-field"><label for="password">رمز عبور</label><div class="auth-password"><input id="password" name="password" type="password" autocomplete="current-password" required /><button type="button" data-password-toggle="password" aria-label="نمایش رمز عبور" aria-pressed="false">نمایش</button></div></div>
                <div class="auth-options"><label class="auth-check"><input id="remember-me" type="checkbox" />مرا به خاطر بسپار</label><a href="/forgot-password">فراموشی رمز عبور</a></div>
                <p id="form-message" class="auth-message" role="alert" hidden></p>
                <button id="submit-button" class="auth-submit" type="submit">ورود به حساب</button>
            </form>
        </section>
        <section id="phone-panel" role="tabpanel" aria-labelledby="phone-tab" hidden>
            <p class="auth-help">کد تأیید به شمارهٔ ثبت‌شده در حساب شما ارسال می‌شود.</p>
            <p class="auth-notice" data-sms-status role="status">در حال بررسی سرویس پیامک…</p>
            <form id="phone-form" class="auth-form" data-purpose="login" data-return-url="@(ViewData["ReturnUrl"] as string ?? "/account")">
                <div class="auth-field"><label for="otp-phone">شماره موبایل</label><input id="otp-phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="32" placeholder="09123456789" dir="ltr" required /></div>
                <button id="send-code" class="auth-secondary" type="button">دریافت کد تأیید</button>
                <div id="code-fields" hidden>
                    <div class="auth-field"><label for="otp-code">کد تأیید پیامکی</label><input id="otp-code" type="text" inputmode="numeric" autocomplete="one-time-code" minlength="6" maxlength="6" dir="ltr" class="auth-code" placeholder="کد ۶ رقمی" /></div>
                    <label class="auth-check"><input id="otp-remember" type="checkbox" />مرا به خاطر بسپار</label>
                    <button id="verify-code" class="auth-submit" type="submit">تأیید و ورود</button>
                </div>
                <p id="phone-message" class="auth-message" role="alert" hidden></p>
            </form>
        </section>
        <p class="auth-footnote">حساب کاربری ندارید؟ <a href="/register">نام‌نویسی کنید</a></p>
        <a href="/" class="auth-back">بازگشت به فروشگاه ←</a>
    </div>
</main>
<script src="~/assets/js/auth-pages.js" asp-append-version="true"></script>
<partial name="_MobileBottomNav" />
</body></html>
