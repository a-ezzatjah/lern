@model lern.Models.AccountCommentsViewModel
@using System.Globalization
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "نظرات من";
    var calendar = new PersianCalendar();
    string DateLabel(DateTime date) { var local = date.ToLocalTime(); return $"{calendar.GetYear(local):0000}/{calendar.GetMonth(local):00}/{calendar.GetDayOfMonth(local):00}"; }
}
<section class="w-full p-4 md:p-6">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-dark dark:text-light">نظرات من</h1>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">مشاهده نظرهایی که برای محصولات ثبت کرده‌اید</p>
    </div>

    <form method="get" action="/account/comments" class="mb-6 rounded-xl border border-gray-100 bg-white p-5 shadow-soft dark:border-gray-700 dark:bg-card-dark dark:shadow-soft-dark">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <label class="text-sm font-medium text-gray-700 dark:text-gray-300">وضعیت نظر
                <select name="status" class="mt-2 w-full rounded-lg border border-gray-300 bg-white px-4 py-2 dark:border-gray-600 dark:bg-gray-700 dark:text-white">
                    <option value="">همه وضعیت‌ها</option>
                    <option value="approved" selected="@(Model.Status == "approved")">تأیید شده</option>
                    <option value="pending" selected="@(Model.Status == "pending")">در انتظار تأیید</option>
                </select>
            </label>
            <label class="text-sm font-medium text-gray-700 dark:text-gray-300">امتیاز محصول
                <select name="rating" class="mt-2 w-full rounded-lg border border-gray-300 bg-white px-4 py-2 dark:border-gray-600 dark:bg-gray-700 dark:text-white">
                    <option value="">همه امتیازها</option>
                    @for (var score = 5; score >= 1; score--) { <option value="@score" selected="@(Model.Rating == score)">@score ستاره</option> }
                </select>
            </label>
            <label class="text-sm font-medium text-gray-700 dark:text-gray-300">تاریخ ارسال
                <select name="period" class="mt-2 w-full rounded-lg border border-gray-300 bg-white px-4 py-2 dark:border-gray-600 dark:bg-gray-700 dark:text-white">
                    <option value="">همه تاریخ‌ها</option>
                    <option value="today" selected="@(Model.Period == "today")">۲۴ ساعت گذشته</option>
                    <option value="week" selected="@(Model.Period == "week")">۷ روز گذشته</option>
                    <option value="month" selected="@(Model.Period == "month")">۳۰ روز گذشته</option>
                    <option value="year" selected="@(Model.Period == "year")">یک سال گذشته</option>
                </select>
            </label>
            <div class="flex items-end"><button type="submit" class="w-full rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary/90">اعمال فیلتر</button></div>
        </div>
    </form>

    <div class="rounded-xl border border-gray-100 bg-white p-5 shadow-soft dark:border-gray-700 dark:bg-card-dark dark:shadow-soft-dark md:p-6">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-bold text-dark dark:text-light">نظرات ارسال شده <span class="text-sm font-normal text-gray-500">(@Model.TotalCount)</span></h2>
            <form method="get" action="/account/comments" class="flex items-center gap-2 text-sm">
                <input type="hidden" name="status" value="@Model.Status" /><input type="hidden" name="rating" value="@Model.Rating" /><input type="hidden" name="period" value="@Model.Period" />
                <label for="comment-sort" class="text-gray-500 dark:text-gray-400">مرتب‌سازی:</label>
                <select id="comment-sort" name="sort" onchange="this.form.submit()" class="rounded-lg border border-gray-200 bg-white px-2 py-1 text-primary dark:border-gray-600 dark:bg-gray-700 dark:text-white">
                    <option value="newest" selected="@(Model.Sort == "newest")">جدیدترین</option>
                    <option value="oldest" selected="@(Model.Sort == "oldest")">قدیمی‌ترین</option>
                    <option value="highest" selected="@(Model.Sort == "highest")">بیشترین امتیاز</option>
                    <option value="lowest" selected="@(Model.Sort == "lowest")">کمترین امتیاز</option>
                </select>
            </form>
        </div>
        @if (Model.Comments.Count == 0)
        {
            <p class="py-10 text-center text-sm text-gray-500 dark:text-gray-400">نظری با این شرایط پیدا نشد.</p>
        }
        else
        {
            @foreach (var comment in Model.Comments)
            {
                <article class="mb-6 border-b border-gray-200 pb-6 last:mb-0 last:border-0 last:pb-0 dark:border-gray-700">
                    <div class="flex items-start gap-4">
                        <div aria-hidden="true" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary dark:bg-primary/20">★</div>
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div>
                                    <h3 class="font-medium text-dark dark:text-light">@comment.AuthorName</h3>
                                    @if (comment.Score.HasValue)
                                    {
                                        <div class="mt-1 flex items-center gap-2" aria-label="امتیاز فعلی این محصول: @comment.Score از ۵">
                                            <span class="text-yellow-400">@string.Concat(Enumerable.Repeat("★", comment.Score.Value))<span class="text-gray-300 dark:text-gray-600">@string.Concat(Enumerable.Repeat("★", 5 - comment.Score.Value))</span></span>
                                            <span class="text-xs text-gray-500">@comment.Score/۵</span>
                                        </div>
                                    }
                                </div>
                                <div class="flex items-center gap-3 text-xs"><time class="text-gray-500 dark:text-gray-400">@DateLabel(comment.CreatedAt)</time><span class="rounded-full px-2 py-1 @(comment.IsApproved ? "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300" : "bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-200")">@(comment.IsApproved ? "تأیید شده" : "در انتظار تأیید")</span></div>
                            </div>
                            <div class="mt-3">
                                <a asp-controller="StoreProduct" asp-action="Details" asp-route-id="@comment.ProductId" class="text-sm font-medium text-primary hover:underline dark:text-primary-dark">@comment.ProductName</a>
                                @if (!string.IsNullOrWhiteSpace(comment.Title)) { <h4 class="mt-2 font-medium dark:text-white">@comment.Title</h4> }
                                <p class="mt-2 whitespace-pre-line break-words text-sm text-gray-600 dark:text-gray-400">@comment.Body</p>
                                <a asp-action="EditComment" asp-route-id="@comment.Id" class="mt-4 inline-flex items-center gap-1 text-sm text-primary hover:underline dark:text-primary-dark">ویرایش نظر ←</a>
                            </div>
                        </div>
                    </div>
                </article>
            }
        }
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="صفحات نظرات" class="mt-6 flex items-center justify-between border-t border-gray-200 pt-4 text-sm dark:border-gray-700">
                <span class="text-gray-500 dark:text-gray-400">صفحه @Model.Page از @Model.TotalPages</span>
                <div class="flex gap-2">
                    @if (Model.Page > 1) { <a asp-action="Comments" asp-route-page="@(Model.Page - 1)" asp-route-status="@Model.Status" asp-route-rating="@Model.Rating" asp-route-period="@Model.Period" asp-route-sort="@Model.Sort" class="rounded-lg border px-3 py-1 dark:border-gray-600 dark:text-white">قبلی</a> }
                    @if (Model.Page < Model.TotalPages) { <a asp-action="Comments" asp-route-page="@(Model.Page + 1)" asp-route-status="@Model.Status" asp-route-rating="@Model.Rating" asp-route-period="@Model.Period" asp-route-sort="@Model.Sort" class="rounded-lg border px-3 py-1 dark:border-gray-600 dark:text-white">بعدی</a> }
                </div>
            </nav>
        }
    </div>
</section>
