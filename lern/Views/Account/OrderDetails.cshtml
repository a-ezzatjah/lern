@model Entities.Order
@using Entities
@using System.Globalization
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "جزئیات سفارش";
    var date = Model.CreatedAt.ToLocalTime();
    var calendar = new PersianCalendar();
    var dateLabel = $"{calendar.GetYear(date):0000}/{calendar.GetMonth(date):00}/{calendar.GetDayOfMonth(date):00}";
    var status = Model.Status switch
    {
        OrderStatus.PaymentReview => "نیازمند بررسی پرداخت", OrderStatus.Pending => "در انتظار پرداخت", OrderStatus.Paid => "پرداخت شده",
        OrderStatus.Processing => "در حال پردازش", OrderStatus.Shipped => "ارسال شده",
        OrderStatus.Completed => "تحویل شده", OrderStatus.Cancelled => "لغو شده", _ => "نامشخص"
    };
}
<section class="w-full p-4 md:p-6">
    <a asp-action="Orders" class="mb-5 inline-block text-sm text-primary hover:underline">→ بازگشت به سفارش‌ها</a>
    <div class="rounded-xl border border-gray-100 bg-white p-5 shadow-soft dark:border-gray-700 dark:bg-card-dark dark:shadow-soft-dark">
        <h1 class="mb-5 text-xl font-bold dark:text-white">جزئیات سفارش #@Model.Id</h1>
        <div class="mb-6 grid gap-3 text-sm text-gray-600 sm:grid-cols-2 dark:text-gray-300">
            <p>تاریخ: @dateLabel</p><p>وضعیت: @status</p>
            <p>تحویل‌گیرنده: @Model.CustomerFirstName @Model.CustomerLastName</p><p>شماره تماس: @Model.CustomerPhone</p>
        </div>
        <div class="overflow-x-auto"><table class="min-w-full divide-y divide-gray-200 text-sm dark:divide-gray-700">
            <thead class="bg-gray-50 text-gray-500 dark:bg-gray-800"><tr><th class="px-4 py-3 text-start">کالا</th><th class="px-4 py-3 text-start">تعداد</th><th class="px-4 py-3 text-start">قیمت واحد</th><th class="px-4 py-3 text-start">جمع</th></tr></thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">@foreach (var item in Model.Items) { <tr class="dark:text-white"><td class="px-4 py-3">@item.ProductName</td><td class="px-4 py-3">@item.Quantity</td><td class="px-4 py-3">@item.UnitPrice.ToString("N0") تومان</td><td class="px-4 py-3">@item.LineTotal.ToString("N0") تومان</td></tr> }</tbody>
        </table></div>
        @if (Model.Status == OrderStatus.Pending && Model.ReservationExpiresAt.HasValue) { <a href="/orders/@Model.Id" class="mt-5 inline-block text-primary">مشاهده وضعیت و پرداخت سفارش</a> }
        <div class="mt-5 space-y-2 border-t pt-4 text-sm dark:border-gray-700 dark:text-white"><p>جمع کالاها: @Model.Subtotal.ToString("N0") تومان</p><p class="font-bold">مبلغ نهایی: @Model.Total.ToString("N0") تومان</p></div>
    </div>
    <div class="mt-6"><partial name="_OrderShipping" model="Model" /></div>
</section>
