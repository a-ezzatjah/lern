@{ ViewData["Title"] = "تکمیل سفارش"; }

<!-- قالب این صفحه مستقیماً از checkout.html قالب آرینو گرفته شده است. -->
<section class="py-5">
    <div class="container">
        <ol class="flex items-center w-full bg-white rounded-lg drop-shadow-lg border border-gray-300 mb-4 p-3 space-x-2 text-sm font-medium text-center text-gray-500 dark:text-gray-400 sm:text-base dark:bg-gray-800 sm:p-4 sm:space-x-4 rtl:space-x-reverse">
            <li class="flex items-center"><span class="flex items-center justify-center w-5 h-5 me-2 text-xs border rounded-full shrink-0">1</span>جزئیات <span class="hidden sm:inline-flex sm:ms-2">سبد خرید</span><svg class="w-3 h-3 ms-2 sm:ms-4 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 12 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m7 9 4-4-4-4M1 9l4-4-4-4"/></svg></li>
            <li class="flex font-bold text-primary items-center"><span class="flex items-center justify-center w-5 h-5 me-2 text-xs border rounded-full shrink-0 dark:border-gray-400">2</span>جزئیات <span class="hidden sm:inline-flex sm:ms-2">سفارش</span><svg class="w-3 h-3 ms-2 sm:ms-4 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 12 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m7 9 4-4-4-4M1 9l4-4-4-4"/></svg></li>
            <li class="flex items-center"><span class="flex me-2 items-center justify-center w-5 h-5 ms-2 text-xs border rounded-full shrink-0 dark:border-gray-400">3</span>جزئیات <span class="hidden sm:inline-flex sm:ms-2">پرداخت</span></li>
        </ol>
        <div class="flex drop-shadow-sm border border-gray-200 space-x-3 items-center p-6 mb-4 text-sm text-yellow-800 rounded-lg bg-orange-50 dark:bg-gray-800 dark:text-white" role="alert"><svg class="shrink-0 block size-8 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20"><path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/></svg><div class="flex items-center space-x-3"><span class="block">اگه کد تخفیف داری همین الان واردش کن</span><a href="#" data-modal-target="discountModal" class="modal-trigger bg-primary-grad text-white py-1 px-5 ms-3 cursor-pointer rounded-lg flex items-center">وارد کردن</a></div></div>
        <p id="checkout-message" class="mb-3 text-sm" role="status" aria-live="polite"></p>
        <div id="checkout-content" class="grid gap-4 grid-cols-4 relative">
            <div class="xl:col-span-3 col-span-4 w-full"><div class="space-y-4">
                <div class="dark:bg-gray-800 dark:text-white bg-white rounded-lg drop-shadow-lg border-gray-300 border-1 p-4"><h1 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:start-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:start-4 after:bg-primary after:rounded-lg">تکمیل اطلاعات ارسال</h1><div class="border-b border-gray-200 pb-4 mb-4"><div class="flex justify-between items-center mb-2"><h2 class="text-gray-700 dark:text-white">آدرس تحویل سفارش</h2><button type="button" class="text-primary-600 dark:text-white hover:text-primary-800 dark:hover:text-white text-sm flex items-center">تغییر آدرس<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/></svg></button></div><p class="text-gray-600 dark:text-white flex flex-col space-y-3 mt-3 text-sm"><span>آدرس تحویل پس از تکمیل پروفایل انتخاب می‌شود.</span><span>کد پستی: —</span></p></div><div><h2 class="text-gray-700 mb-2 dark:text-white">اطلاعات کاربر</h2><p class="text-gray-600 text-sm dark:text-white">مهمان</p></div></div>
                <div class="dark:bg-gray-800 dark:text-white bg-white rounded-lg drop-shadow-lg border-gray-300 border-1 p-4"><h2 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:start-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:start-4 after:bg-primary after:rounded-lg">روش ارسال را انتخاب کنید</h2><div class="space-y-4"><div class="border border-gray-200 rounded-lg p-4 hover:border-primary-500 transition-all"><div class="flex justify-between items-center"><div><h3 class="font-medium text-gray-700 dark:text-white">ارسال عادی</h3><p class="text-sm text-gray-500 mt-1 dark:text-white">تحویل درب منزل یا محل کار</p></div><div class="flex items-center"><span class="text-green-500 text-sm me-2 dark:text-white">موجود</span><input type="radio" name="delivery" checked class="h-5 dark:text-white w-5 text-primary-600 delivery-method" data-type="normal"></div></div><div class="mt-3 pt-3 border-t border-gray-100"><p class="text-sm text-gray-600 dark:text-white">هزینه ارسال: <span class="delivery-cost">۳۵,۰۰۰</span> تومان</p></div></div><div class="border border-gray-200 rounded-lg p-4 hover:border-primary-500 transition-all"><div class="flex justify-between items-center"><div><h3 class="font-medium text-gray-700 dark:text-white">دریافت حضوری</h3><p class="text-sm text-gray-500 mt-1 dark:text-white">مراجعه به مراکز منتخب</p></div><div class="flex items-center"><span class="text-green-500 text-sm me-2 dark:text-white">موجود</span><input type="radio" name="delivery" class="h-5 w-5 text-primary-600 delivery-method" data-type="pickup"></div></div><div class="mt-3 pt-3 border-t border-gray-100 pickup-location" style="display:none;"><select class="w-full focus:border-primary outline-0 px-3 py-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-white focus:ring-2 focus:ring-primary-500"><option>مرکز خرید ملت - شعبه مرکزی</option><option>مرکز خرید ایران مال - طبقه دوم</option><option>مرکز خرید کوروش - واحد ۱۲۳</option></select></div></div></div></div>
                <div class="dark:bg-gray-800 dark:text-white bg-white rounded-lg drop-shadow-lg border-gray-300 border-1 p-4"><h2 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:start-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:start-4 after:bg-primary after:rounded-lg">محصولات قابل ارسال</h2><div id="checkout-items" class="space-y-4"><div class="flex items-center border-b border-gray-100 pb-4" style="display:none;"><img src="/assets/images/product/wach-1.png" alt="محصول" class="w-16 h-16 object-cover rounded-md"><div class="ms-3 flex-1"><h3 class="font-medium text-gray-700 dark:text-white">کفش ورزشی نایک مدل Air Max</h3><p class="text-sm text-gray-500 dark:text-white">رنگ: مشکی - سایز: ۴۱</p></div><span class="text-green-500 text-sm">موجود</span></div></div></div>
                <div class="dark:bg-gray-800 dark:text-white bg-white rounded-lg drop-shadow-lg border-gray-300 border-1 p-4"><h2 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:start-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:start-4 after:bg-primary after:rounded-lg">زمان تحویل را انتخاب کنید</h2><div class="mb-6"><div class="flex overflow-x-auto pb-2 space-x-2" id="day-selector"></div></div><h3 class="font-medium text-gray-700 mb-3 dark:text-white">بازه زمانی تحویل</h3><div class="grid grid-cols-2 gap-3" id="time-slots"></div></div>
                <div class="dark:bg-gray-800 dark:text-white bg-white rounded-lg drop-shadow-lg border-gray-300 border-1 p-4"><div class="flex justify-between items-center mb-4"><span class="text-gray-600 dark:text-white">هزینه ارسال:</span><span class="font-medium delivery-cost-summary dark:text-white">۳۵,۰۰۰ تومان</span></div><div class="flex justify-between items-center mb-4"><span class="text-gray-600 dark:text-white">زمان تحویل:</span><span class="font-medium delivery-time-summary dark:text-white">فردا - جمعه ۹ صبح تا ۱۲ ظهر</span></div></div>
            </div></div>
            <div class="xl:col-span-1 col-span-4 w-full"><div class="dark:bg-gray-800 sticky top-0 dark:text-white bg-white rounded-lg drop-shadow-lg border-gray-300 border-1 p-4"><ul class="space-y-5"><li class="flex justify-between item-center dark:text-white"><h6 class="font-bold">قیمت کالاها</h6><p id="checkout-subtotal">۰ تومان</p></li><li class="flex justify-between item-center dark:text-white"><h6 class="font-bold">تخفیف کالاها</h6><p class="text-primary font-bold">۰ تومان</p></li><li class="flex justify-between item-center dark:text-white"><h6 class="font-bold">مجموع</h6><p id="checkout-total">۰ تومان</p></li><li><button id="checkout-submit" type="button" class="p-2 bg-primary-grad w-full block text-center rounded-lg text-white">تسویه حساب</button></li></ul></div></div>
        </div>
    </div>
</section>
<script>
(() => { const cartApi='/api/cart', checkoutApi='/api/orders/checkout', shipping=35000, price=v=>`${Number(v||0).toLocaleString('fa-IR')} تومان`; let items=[],template;
const message=(t,b=false)=>{const e=document.getElementById('checkout-message');e.textContent=t||'';e.className=b?'mb-3 text-sm text-red-600':'mb-3 text-sm text-green-600'};
const cost=()=>document.querySelector('.delivery-method:checked')?.dataset.type==='pickup'?0:shipping;
const totals=()=>{const s=items.reduce((a,x)=>a+Number(x.price)*x.quantity,0);document.getElementById('checkout-subtotal').textContent=price(s);document.getElementById('checkout-total').textContent=price(s+cost());document.querySelectorAll('.delivery-cost').forEach(e=>e.textContent=cost()?Number(cost()).toLocaleString('fa-IR'):'رایگان');document.querySelector('.delivery-cost-summary').textContent=cost()?price(cost()):'رایگان'};
const render=()=>{const list=document.getElementById('checkout-items');list.replaceChildren();items.forEach(x=>{const row=template.cloneNode(true),img=row.querySelector('img');row.style.removeProperty('display');img.src=x.imageUrl||'/assets/images/logo.png';img.alt=x.productName;img.onerror=()=>img.src='/assets/images/logo.png';row.querySelector('h3').textContent=x.productName;row.querySelector('p').textContent=`تعداد: ${x.quantity.toLocaleString('fa-IR')} عدد`;list.append(row)})};
const time=()=>{const days=['امروز','فردا','شنبه','یکشنبه','دوشنبه'],slots=['۹ صبح تا ۱۲ ظهر','۱۲ ظهر تا ۴ بعدازظهر','۴ بعدازظهر تا ۸ شب','۸ شب تا ۱۲ شب'],d=document.getElementById('day-selector'),s=document.getElementById('time-slots'),update=()=>{const a=d.querySelector('.bg-primary-100')?.textContent,b=s.querySelector('.bg-primary-50 span')?.textContent;if(a&&b)document.querySelector('.delivery-time-summary').textContent=`${a} - ${b}`};days.forEach((x,i)=>{const b=document.createElement('button');b.type='button';b.className=`flex-shrink-0 px-4 py-2 rounded-lg font-medium day-option border border-gray-300 hover:bg-gray-50${i===1?' bg-primary-100 text-primary-700':''}`;b.textContent=x;b.onclick=()=>{d.querySelectorAll('button').forEach(q=>q.classList.remove('bg-primary-100','text-primary-700'));b.classList.add('bg-primary-100','text-primary-700');update()};d.append(b)});slots.forEach((x,i)=>{const b=document.createElement('button');b.type='button';b.className=`py-3 px-4 border rounded-lg time-slot border-gray-300 hover:border-primary-500 hover:bg-primary-50${i===2?' border-primary-500 bg-primary-50':''}`;b.innerHTML=`<span class="block font-medium">${x}</span><span class="block text-sm mt-1">هزینه معمولی</span>`;b.onclick=()=>{s.querySelectorAll('button').forEach(q=>q.classList.remove('border-primary-500','bg-primary-50'));b.classList.add('border-primary-500','bg-primary-50');update()};s.append(b)});update()};
document.addEventListener('DOMContentLoaded',async()=>{const list=document.getElementById('checkout-items');template=list.firstElementChild.cloneNode(true);list.replaceChildren();time();document.querySelectorAll('.delivery-method').forEach(x=>x.onchange=()=>{document.querySelector('.pickup-location').style.display=x.checked&&x.dataset.type==='pickup'?'block':'none';totals()});try{const r=await fetch(cartApi,{credentials:'same-origin'});if(!r.ok)throw new Error((await r.text())||'دریافت سبد خرید انجام نشد.');items=await r.json();if(!items.length)throw new Error('سبد خرید شما خالی است.');render();totals();document.getElementById('checkout-content').style.removeProperty('display');document.getElementById('checkout-submit').onclick=async e=>{const b=e.currentTarget;b.disabled=true;b.textContent='در حال ثبت سفارش...';try{const q=await fetch(checkoutApi,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({shippingCost:cost()})});if(!q.ok)throw new Error((await q.text())||'ثبت سفارش انجام نشد.');const o=await q.json();message(`سفارش شماره ${o.id} با موفقیت ثبت شد.`);b.textContent='سفارش ثبت شد'}catch(err){message(err.message,true);b.disabled=false;b.textContent='تسویه حساب'}}}catch(err){message(err.message,true)}}) })();
</script>
