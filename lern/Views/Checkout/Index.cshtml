@{ ViewData["Title"] = "تکمیل سفارش"; }

<!-- قالب این صفحه مستقیماً از checkout.html قالب آرینو گرفته شده است. -->
<section class="py-5">
    <div class="container">
        <ol class="flex items-center w-full bg-white rounded-lg drop-shadow-lg border border-gray-300 mb-4 p-3 space-x-2 text-sm font-medium text-center text-gray-500 dark:text-gray-400 sm:text-base dark:bg-gray-800 sm:p-4 sm:space-x-4 rtl:space-x-reverse">
            <li class="flex items-center"><span class="flex items-center justify-center w-5 h-5 me-2 text-xs border rounded-full shrink-0">1</span>جزئیات <span class="hidden sm:inline-flex sm:ms-2">سبد خرید</span><svg class="w-3 h-3 ms-2 sm:ms-4 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 12 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m7 9 4-4-4-4M1 9l4-4-4-4"/></svg></li>
            <li class="flex font-bold text-primary items-center"><span class="flex items-center justify-center w-5 h-5 me-2 text-xs border rounded-full shrink-0 dark:border-gray-400">2</span>جزئیات <span class="hidden sm:inline-flex sm:ms-2">سفارش</span><svg class="w-3 h-3 ms-2 sm:ms-4 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 12 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m7 9 4-4-4-4M1 9l4-4-4-4"/></svg></li>
            <li class="flex items-center"><span class="flex me-2 items-center justify-center w-5 h-5 ms-2 text-xs border rounded-full shrink-0 dark:border-gray-400">3</span>جزئیات <span class="hidden sm:inline-flex sm:ms-2">پرداخت</span></li>
        </ol>
        <div class="flex drop-shadow-sm border border-gray-200 space-x-3 items-center p-6 mb-4 text-sm text-yellow-800 rounded-lg bg-orange-50 dark:bg-gray-800 dark:text-white" role="alert"><svg class="shrink-0 block size-8 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20"><path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/></svg><div class="flex items-center space-x-3"><span class="block">اگه کد تخفیف داری همین الان واردش کن</span><a href="#" data-modal-target="discountModal" class="modal-trigger bg-primary-grad text-white py-1 px-5 ms-3 cursor-pointer rounded-lg flex items-center">وارد کردن</a></div></div>
        <p id="checkout-message" class="mb-3 text-sm" role="status" aria-live="polite"></p>
        <div id="checkout-customer-form" class="dark:bg-gray-800 bg-white rounded-lg p-4 mb-4"><h2 class="font-bold text-lg mb-4">اطلاعات شخصی</h2><div class="grid grid-cols-1 md:grid-cols-3 gap-4"><div><label for="checkout-first-name" class="block mb-2">نام</label><input id="checkout-first-name" class="w-full border rounded-lg px-3 py-2 dark:bg-gray-700 dark:text-white" required></div><div><label for="checkout-last-name" class="block mb-2">نام خانوادگی</label><input id="checkout-last-name" class="w-full border rounded-lg px-3 py-2 dark:bg-gray-700 dark:text-white" required></div><div><label for="checkout-phone" class="block mb-2">شماره تماس</label><input id="checkout-phone" type="tel" class="w-full border rounded-lg px-3 py-2 dark:bg-gray-700 dark:text-white" required></div></div></div>
        <div id="checkout-content" class="grid gap-4 grid-cols-4 relative">
            <div class="xl:col-span-3 col-span-4 w-full"><div class="space-y-4">
                <div class="dark:bg-gray-800 dark:text-white bg-white rounded-lg drop-shadow-lg border-gray-300 border-1 p-4"><h1 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:start-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:start-4 after:bg-primary after:rounded-lg">تکمیل اطلاعات ارسال</h1><div class="border-b border-gray-200 pb-4 mb-4"><div class="flex justify-between items-center mb-2"><h2 class="text-gray-700 dark:text-white">آدرس تحویل سفارش</h2><a href="/address" class="text-primary-600 dark:text-white hover:text-primary-800 dark:hover:text-white text-sm flex items-center">تغییر آدرس<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/></svg></a></div><p id="checkout-address" class="text-gray-600 dark:text-white flex flex-col space-y-3 mt-3 text-sm"><span>آدرس تحویل پس از تکمیل پروفایل انتخاب می‌شود.</span><span>کد پستی: —</span></p></div><div><h2 class="text-gray-700 mb-2 dark:text-white">اطلاعات کاربر</h2><p class="text-gray-600 text-sm dark:text-white">مهمان</p></div></div>
                <div class="dark:bg-gray-800 dark:text-white bg-white rounded-lg drop-shadow-lg border-gray-300 border-1 p-4"><h2 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:start-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:start-4 after:bg-primary after:rounded-lg">روش ارسال</h2><div class="space-y-4"><div class="border border-gray-200 rounded-lg p-4"><div class="flex justify-between items-center"><div><h3 class="font-medium text-gray-700 dark:text-white">ارسال عادی</h3><p class="text-sm text-gray-500 mt-1 dark:text-white">تحویل درب منزل یا محل کار</p></div><div class="flex items-center"><span class="text-green-500 text-sm me-2 dark:text-white">موجود</span><input type="radio" name="delivery" checked class="h-5 dark:text-white w-5 text-primary-600" aria-label="ارسال عادی"></div></div><div class="mt-3 pt-3 border-t border-gray-100"><p class="text-sm text-gray-600 dark:text-white">هزینه ارسال: <span class="delivery-cost">۳۰۰٬۰۰۰</span> تومان</p></div></div></div></div>
                <div class="dark:bg-gray-800 dark:text-white bg-white rounded-lg drop-shadow-lg border-gray-300 border-1 p-4"><h2 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:start-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:start-4 after:bg-primary after:rounded-lg">محصولات قابل ارسال</h2><div id="checkout-items" class="space-y-4"><div class="flex items-center border-b border-gray-100 pb-4" style="display:none;"><img src="/assets/images/product/wach-1.png" alt="محصول" class="w-16 h-16 object-cover rounded-md"><div class="ms-3 flex-1"><h3 class="font-medium text-gray-700 dark:text-white">کفش ورزشی نایک مدل Air Max</h3><p class="text-sm text-gray-500 dark:text-white">رنگ: مشکی - سایز: ۴۱</p></div><span class="text-green-500 text-sm">موجود</span></div></div></div>
                <div class="dark:bg-gray-800 dark:text-white bg-white rounded-lg drop-shadow-lg border-gray-300 border-1 p-4"><div class="flex justify-between items-center"><span class="text-gray-600 dark:text-white">هزینه ارسال:</span><span class="font-medium delivery-cost-summary dark:text-white">۳۰۰٬۰۰۰ تومان</span></div></div>
            </div></div>
            <div class="xl:col-span-1 col-span-4 w-full"><div class="dark:bg-gray-800 sticky top-0 dark:text-white bg-white rounded-lg drop-shadow-lg border-gray-300 border-1 p-4"><ul class="space-y-5"><li class="flex justify-between item-center dark:text-white"><h6 class="font-bold">قیمت کالاها</h6><p id="checkout-subtotal">۰ تومان</p></li><li class="flex justify-between item-center dark:text-white"><h6 class="font-bold">تخفیف کالاها</h6><p class="text-primary font-bold">۰ تومان</p></li><li class="flex justify-between item-center dark:text-white"><h6 class="font-bold">هزینه ارسال</h6><p id="checkout-shipping">۳۰۰٬۰۰۰ تومان</p></li><li class="flex justify-between item-center dark:text-white"><h6 class="font-bold">مجموع</h6><p id="checkout-total">۰ تومان</p></li><li><button id="checkout-submit" type="button" class="p-2 bg-primary-grad w-full block text-center rounded-lg text-white">تسویه حساب</button></li></ul></div></div>
        </div>
    </div>
</section>
<style>.dark [class*="dark:bg-gray-700"][class*="text-green-700"]{background:#22c55e!important;color:#fff!important}</style>
<script>
(() => { const cartApi='/api/cart', checkoutApi='/api/orders/checkout', shipping=300000, price=v=>`${Number(v||0).toLocaleString('fa-IR')} تومان`; let items=[],template;
const originalFetch=window.fetch; window.fetch=(input,init)=>{if(input===checkoutApi&&init?.body){const body=JSON.parse(init.body); body.firstName=document.getElementById('checkout-first-name')?.value||''; body.lastName=document.getElementById('checkout-last-name')?.value||''; body.phone=document.getElementById('checkout-phone')?.value||''; init={...init,body:JSON.stringify(body)};} return originalFetch(input,init);};
document.addEventListener('click',e=>{if(e.target.closest('#checkout-submit')){const f=['checkout-first-name','checkout-last-name','checkout-phone']; if(f.some(id=>!document.getElementById(id)?.value.trim())){e.preventDefault();e.stopImmediatePropagation();message('لطفاً نام، نام خانوادگی و شماره تماس را وارد کنید.',true);}},true);
document.querySelector('a[href="/address"]')?.remove();
const addressBox=document.getElementById('checkout-address'); if(addressBox){const add=document.createElement('a'); add.href='/address?new=1'; add.textContent='افزودن آدرس جدید'; add.className='inline-block mt-3 px-4 py-2 rounded-lg bg-primary text-white text-sm'; addressBox.parentElement.insertBefore(add,addressBox);}
const moveCustomerForm=()=>{const customerForm=document.getElementById('checkout-customer-form'); const addressText=document.getElementById('checkout-address'); const addressCard=addressText?.closest('div.rounded-lg'); if(!customerForm||!addressCard)return; const holder=addressCard.parentElement; if(holder) holder.insertBefore(customerForm,addressCard.nextElementSibling);}; setTimeout(moveCustomerForm,50); window.addEventListener('load',moveCustomerForm);
const showAddresses=list=>{const box=document.getElementById('checkout-address'); if(!box)return; const addresses=Array.isArray(list)?list:(list?[list]:[]); box.innerHTML=''; if(!addresses.length){box.innerHTML='<span>هنوز آدرسی ثبت نشده است.</span>';return;} addresses.forEach(a=>{const card=document.createElement('div'); card.className='border rounded-xl p-4 mb-3 cursor-pointer '+(a.isDefault?'border-gray-600 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white':'border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-100'); card.style.cssText=a.isDefault?'box-shadow:0 8px 20px rgba(96,165,250,.28);':'box-shadow:0 2px 6px rgba(0,0,0,.08);'; card.innerHTML=`<div class="flex justify-between items-center"><strong class="text-gray-800 dark:text-white">${a.title||'آدرس'}</strong><span class="flex items-center gap-2">${a.isDefault?'<span class="px-2 py-1 rounded-full bg-green-100 dark:bg-gray-700 text-green-700 dark:text-gray-200 text-xs font-medium shadow-sm">پیش‌فرض</span>':''}<a href="/address?id=${a.id}" class="inline-flex items-center px-3 py-1 rounded-full bg-white dark:bg-gray-700 text-primary dark:text-blue-300 border border-primary/30 dark:border-gray-500 shadow-sm hover:bg-primary hover:text-white text-xs transition-colors">ویرایش</a></span></div><div class="mt-3 text-gray-700 dark:text-gray-100">${a.province}، ${a.city}، ${a.details}</div><div class="mt-1 text-gray-500 dark:text-gray-300">کد پستی: ${a.postalCode}</div>`; card.addEventListener('click',async e=>{if(e.target.closest('a')||a.isDefault)return; const r=await fetch(`/api/address/${a.id}/default`,{method:'POST'}); if(r.ok){const updated=addresses.map(x=>({...x,isDefault:x.id===a.id})); showAddresses(updated);}}); box.appendChild(card);});};
fetch('/api/address/list').then(r=>r.ok?r.json():[]).then(showAddresses).catch(()=>{});
const message=(t,b=false)=>{const e=document.getElementById('checkout-message');e.textContent=t||'';e.className=b?'mb-3 text-sm text-red-600':'mb-3 text-sm text-green-600'};
const cost=()=>shipping;
const totals=()=>{const s=items.reduce((a,x)=>a+Number(x.price)*x.quantity,0);document.getElementById('checkout-subtotal').textContent=price(s);document.getElementById('checkout-shipping').textContent=price(cost());document.getElementById('checkout-total').textContent=price(s+cost());document.querySelectorAll('.delivery-cost').forEach(e=>e.textContent=Number(cost()).toLocaleString('fa-IR'));document.querySelector('.delivery-cost-summary').textContent=price(cost())};
const render=()=>{const list=document.getElementById('checkout-items');list.replaceChildren();items.forEach(x=>{const row=template.cloneNode(true),img=row.querySelector('img');row.style.removeProperty('display');img.src=x.imageUrl||'/assets/images/logo.png';img.alt=x.productName;img.onerror=()=>img.src='/assets/images/logo.png';row.querySelector('h3').textContent=x.productName;row.querySelector('p').textContent=`تعداد: ${x.quantity.toLocaleString('fa-IR')} عدد`;list.append(row)})};
document.addEventListener('DOMContentLoaded',async()=>{const list=document.getElementById('checkout-items');template=list.firstElementChild.cloneNode(true);list.replaceChildren();try{const r=await fetch(cartApi,{credentials:'same-origin'});if(!r.ok)throw new Error((await r.text())||'دریافت سبد خرید انجام نشد.');items=await r.json();if(!items.length)throw new Error('سبد خرید شما خالی است.');render();totals();document.getElementById('checkout-submit').onclick=async e=>{const b=e.currentTarget;b.disabled=true;b.textContent='در حال ثبت سفارش...';try{const q=await fetch(checkoutApi,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({shippingCost:cost()})});if(!q.ok)throw new Error((await q.text())||'ثبت سفارش انجام نشد.');const o=await q.json();message(`سفارش شماره ${o.id} با موفقیت ثبت شد.`);b.textContent='سفارش ثبت شد'}catch(err){message(err.message,true);b.disabled=false;b.textContent='تسویه حساب'}}}catch(err){message(err.message,true)}}) })();
</script>
