@{ ViewData["Title"] = "تکمیل سفارش"; }
<link rel="stylesheet" href="~/assets/css/checkout.css" asp-append-version="true" />
<section class="container checkout-page">
    <h1>تکمیل سفارش</h1>
    <p class="checkout-intro">خرید بدون ثبت‌نام هم امکان‌پذیر است. مبلغ کالاها و کرایهٔ ارسال جداگانه پرداخت می‌شوند.</p>
    <p id="checkout-message" role="status" aria-live="polite"></p>
    <div class="checkout-grid">
        <div class="checkout-sections">
            <section class="checkout-card"><header><h2>آدرس تحویل سفارش</h2><a href="/address?new=1">افزودن آدرس</a></header><div id="checkout-address"><p>در حال دریافت آدرس‌ها…</p></div><a href="/address">مدیریت آدرس‌ها</a></section>
            <section class="checkout-card"><h2>اطلاعات خریدار</h2><div class="checkout-contact"><label for="checkout-first-name">نام<input id="checkout-first-name" maxlength="100" autocomplete="given-name" required /></label><label for="checkout-last-name">نام خانوادگی<input id="checkout-last-name" maxlength="100" autocomplete="family-name" required /></label><label for="checkout-phone">شماره موبایل<input id="checkout-phone" type="tel" maxlength="20" autocomplete="tel" inputmode="tel" required /></label></div></section>
            <section class="checkout-card"><h2>روش ارسال</h2><p id="checkout-shipping-method">پس از انتخاب استان: تهران با پیک، شهرستان با باربری و روش‌های ارسال دیگر</p><p class="checkout-collect">پرداخت هزینهٔ ارسال در محل</p><p>کرایه با توجه به حمل‌کننده تعیین می‌شود و در مبلغ پرداخت اینترنتی محاسبه نمی‌شود.</p></section>
            <section class="checkout-card"><h2>کالاهای سفارش</h2><div id="checkout-items"></div></section>
        </div>
        <aside class="checkout-card checkout-summary"><h2>خلاصهٔ سفارش</h2><dl><div><dt>قیمت کالاها</dt><dd id="checkout-subtotal">۰ تومان</dd></div><div><dt>تخفیف کالاها</dt><dd id="checkout-product-discount">۰ تومان</dd></div><div><dt>تخفیف کوپن</dt><dd id="checkout-coupon-discount">۰ تومان</dd></div><div><dt>کرایهٔ ارسال</dt><dd>پرداخت در محل</dd></div><div class="checkout-total"><dt>مبلغ کالاها</dt><dd id="checkout-total">۰ تومان</dd></div></dl>
            <label for="checkout-coupon-code">کد تخفیف <span>(برای اعضا)</span></label><div class="checkout-coupon"><input id="checkout-coupon-code" maxlength="40" autocomplete="off" /><button id="checkout-apply-coupon" type="button">اعمال</button></div>
            <p id="checkout-payment-notice" class="checkout-payment-notice">در حال بررسی امکان پرداخت…</p>
            <button id="checkout-submit" type="button" disabled>ثبت سفارش</button>
            <p class="checkout-note">ثبت سفارش به معنی پرداخت نیست. موجودی کالاها پس از ثبت، ۳۰ دقیقه رزرو می‌شود.</p>
            <a id="checkout-receipt" hidden>مشاهدهٔ سفارش ثبت‌شده</a>
        </aside>
    </div>
</section>
<script src="~/assets/js/checkout.js" asp-append-version="true" defer></script>
