@model IReadOnlyList<Entities.StoreComplaint>
@using lern.Infrastructure
@{ Layout = "_AdminLayout"; ViewData["Title"] = "شکایت‌ها و درخواست‌های رسیدگی"; var currentPage = (int)(ViewData["Page"] ?? 1); var totalPages = (int)(ViewData["TotalPages"] ?? 1); var reviewed = ViewData["Reviewed"] as bool?; }
<link rel="stylesheet" href="~/assets/css/store-support.css" asp-append-version="true" />
<div class="ks-support-page ks-admin-complaints"><header class="admin-page-heading"><div><span class="admin-eyebrow">ارتباط خصوصی با مشتریان</span><h1>شکایت‌ها و درخواست‌های رسیدگی</h1><p>@ViewData["Count"] درخواست · اطلاعات این بخش فقط برای مدیران قابل مشاهده است.</p></div></header><nav class="ks-admin-filters" aria-label="فیلتر درخواست‌ها"><a href="/Admin/Complaints" aria-current="@(reviewed is null ? "page" : null)">همه</a><a href="/Admin/Complaints?reviewed=false" aria-current="@(reviewed == false ? "page" : null)">بررسی نشده</a><a href="/Admin/Complaints?reviewed=true" aria-current="@(reviewed == true ? "page" : null)">بررسی شده</a></nav>
@if (Model.Count == 0) { <div class="ks-panel">درخواستی در این بخش وجود ندارد.</div> }
@foreach (var item in Model) { <article class="ks-panel ks-admin-request"><header><h2>@StoreSupportContent.Subject(item.Subject)</h2><span class="ks-request-status">@(item.IsReviewed ? "بررسی شده" : "بررسی نشده")</span></header><dl><div><dt>نام</dt><dd>@item.FullName</dd></div><div><dt>تماس</dt><dd><a href="tel:@item.Phone"><bdi dir="ltr">@item.Phone</bdi></a></dd></div><div><dt>سفارش</dt><dd>@(item.OrderNumber ?? "—")</dd></div><div><dt>تاریخ ثبت (UTC)</dt><dd><bdi dir="ltr">@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</bdi></dd></div></dl><p class="ks-request-body">@item.Message</p><p class="ks-request-reference">کد پیگیری: <bdi dir="ltr">@item.Reference</bdi></p>@if (!item.IsReviewed) { <form asp-controller="AdminComplaints" asp-action="Review" asp-route-id="@item.Id" method="post"><button class="ks-button ks-button-outline" type="submit">علامت‌گذاری به عنوان بررسی شده</button></form> }</article> }
@if (totalPages > 1) { <nav class="ks-admin-filters" aria-label="صفحه‌بندی درخواست‌ها">@if (currentPage > 1) { <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-reviewed="@reviewed">صفحه قبل</a> }<span>@(currentPage) / @totalPages</span>@if (currentPage < totalPages) { <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-reviewed="@reviewed">صفحه بعد</a> }</nav> }
</div>
