@model lern.Models.ComplaintViewModel
@using Entities
@using lern.Infrastructure
@{ ViewData["SupportIntro"] = "صدای شما برای ما مهم است. مسئله را با جزئیات بنویسید تا امکان رسیدگی فراهم شود."; }
@section Head { <partial name="_StructuredData" /> }
<div class="ks-support-page"><partial name="_Hero" />
    @if (TempData["ComplaintReference"] is string reference) { <section class="ks-success ks-panel" role="status"><span class="ks-feature-icon ks-green"><svg aria-hidden="true"><use href="#ks-i-check" /></svg></span><div><h2>درخواست شما ثبت شد</h2><p>کد زیر را برای پیگیری تلفنی نزد خود نگه دارید. مدیریت فروشگاه به اطلاعات درخواست دسترسی دارد.</p><strong class="ks-tracking-code"><bdi dir="ltr">@reference</bdi></strong></div></section> }
    <div class="ks-complaint-layout"><section class="ks-panel ks-form-panel"><span class="ks-eyebrow">ثبت شکایت و درخواست رسیدگی</span><h2>از موضوع برایمان بگویید</h2><p class="ks-muted">فیلدهای ستاره‌دار الزامی هستند.</p>
        <form asp-controller="StoreSupport" asp-action="SubmitComplaint" method="post" class="ks-complaint-form">
            <div asp-validation-summary="ModelOnly" class="ks-form-error" role="alert"></div>
            <div class="ks-form-grid"><div class="ks-field"><label asp-for="FullName">نام و نام خانوادگی <span aria-hidden="true">*</span></label><input asp-for="FullName" class="ks-input" autocomplete="name" required minlength="3" maxlength="100" /><span asp-validation-for="FullName" class="ks-field-error"></span></div><div class="ks-field"><label asp-for="Phone">شماره موبایل <span aria-hidden="true">*</span></label><input asp-for="Phone" class="ks-input" type="tel" inputmode="tel" autocomplete="tel" required maxlength="11" placeholder="۰۹۱۲۳۴۵۶۷۸۹" /><span asp-validation-for="Phone" class="ks-field-error"></span></div><div class="ks-field"><label asp-for="Subject">موضوع درخواست <span aria-hidden="true">*</span></label><select asp-for="Subject" class="ks-input" required><option value="">انتخاب موضوع</option>@foreach (var value in Enum.GetValues<ComplaintSubject>()) { <option value="@((int)value)">@StoreSupportContent.Subject(value)</option> }</select><span asp-validation-for="Subject" class="ks-field-error"></span></div><div class="ks-field"><label asp-for="OrderNumber">شماره سفارش <small>اختیاری</small></label><input asp-for="OrderNumber" class="ks-input" inputmode="numeric" maxlength="12" placeholder="اگر درخواست مربوط به سفارش است" /><span asp-validation-for="OrderNumber" class="ks-field-error"></span></div></div>
            <div class="ks-field"><label asp-for="Message">شرح درخواست <span aria-hidden="true">*</span></label><textarea asp-for="Message" class="ks-input" rows="6" required minlength="15" maxlength="3000" placeholder="چه اتفاقی افتاده و برای حل آن چه درخواستی دارید؟" aria-describedby="ks-message-help"></textarea><span asp-validation-for="Message" class="ks-field-error"></span><small id="ks-message-help">بین ۱۵ تا ۳۰۰۰ نویسه. رمز عبور یا اطلاعات کارت بانکی را در این بخش ننویسید.</small></div>
            <div class="ks-form-trap" aria-hidden="true"><label asp-for="Website">وب‌سایت</label><input asp-for="Website" tabindex="-1" autocomplete="off" /></div>
            <div class="ks-form-submit"><p>اطلاعات شما در سایت نمایش عمومی ندارد و برای رسیدگی در اختیار مدیریت فروشگاه قرار می‌گیرد.</p><button type="submit" class="ks-button ks-button-primary">ثبت درخواست <svg aria-hidden="true"><use href="#ks-i-arrow" /></svg></button></div>
        </form></section>
        <aside class="ks-complaint-aside"><section class="ks-panel"><h2>مسیر رسیدگی</h2><ol class="ks-process"><li><span>۱</span><div><strong>ثبت موضوع و جزئیات</strong><p>اطلاعات روشن، بررسی درخواست را آسان‌تر می‌کند.</p></div></li><li><span>۲</span><div><strong>دریافت کد پیگیری</strong><p>پس از ثبت موفق، کد درخواست نمایش داده می‌شود.</p></div></li><li><span>۳</span><div><strong>بررسی توسط مدیریت</strong><p>برای پیگیری تلفنی، کد درخواست را همراه داشته باشید.</p></div></li></ol></section><section class="ks-panel ks-quick-call"><span class="ks-feature-icon ks-green"><svg aria-hidden="true"><use href="#ks-i-phone" /></svg></span><h2>ترجیح می‌دهید صحبت کنید؟</h2><p>برای پیگیری مستقیم با فروشگاه تماس بگیرید.</p><a href="tel:09305219144" class="ks-text-link"><bdi dir="ltr">۰۹۳۰۵۲۱۹۱۴۴</bdi><svg aria-hidden="true"><use href="#ks-i-arrow" /></svg></a></section></aside></div>
</div>
