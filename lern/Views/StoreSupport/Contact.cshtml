@using lern.Infrastructure
@{ ViewData["SupportIntro"] = "برای انتخاب محصول، خرید عمده یا پیگیری سفارش، مستقیم با ما در ارتباط باشید."; }
@section Head { <partial name="_StructuredData" /> }
<div class="ks-support-page"><partial name="_Hero" />
    <div class="ks-contact-grid"><section class="ks-panel ks-contact-numbers"><span class="ks-eyebrow">گفت‌وگو از همین‌جا شروع می‌شود</span><h2>با ما تماس بگیرید</h2><p>شماره موردنظر را انتخاب کنید تا تماس برقرار شود.</p><div class="ks-contact-cards">@foreach (var person in StoreSupportContent.Contacts) { <a href="tel:@person.Phone" class="ks-contact-card" aria-label="تماس با @person.Name، @person.Display"><span class="ks-feature-icon"><svg aria-hidden="true"><use href="#ks-i-phone" /></svg></span><span><strong>@person.Name</strong><bdi dir="ltr">@person.Display</bdi></span><svg class="ks-contact-arrow" aria-hidden="true"><use href="#ks-i-arrow" /></svg></a> }</div></section>
    <section class="ks-panel ks-visit-card"><span class="ks-feature-icon ks-green"><svg aria-hidden="true"><use href="#ks-i-pin" /></svg></span><h2>در قلب بازار بزرگ تهران</h2><address>@StoreSupportContent.Address</address><div class="ks-visit-note"><strong>پیش از مراجعه هماهنگ کنید</strong><p>برای اطلاع از ساعت فعالیت و موجودی محصول موردنیازتان، پیش از مراجعه حضوری با فروشگاه تماس بگیرید.</p></div><div class="ks-socials"><span><img src="/assets/images/social/eitta.png" alt="ایتا" width="24" height="24" /></span><span><img src="/assets/images/logo/telegram.png" alt="تلگرام" width="24" height="24" /></span><span><img src="/assets/images/social/whatsapp.svg" alt="واتس‌اپ" width="24" height="24" /></span></div><p class="ks-muted">برای دریافت نشانی حساب‌های فروشگاه در ایتا، تلگرام و واتس‌اپ با ما تماس بگیرید.</p></section></div>
    <aside class="ks-help-strip"><div><h2>درخواست رسیدگی به سفارش دارید؟</h2><p>موضوع را همراه جزئیات ثبت کنید تا مدیریت فروشگاه آن را بررسی کند.</p></div><a href="/complaints" class="ks-button ks-button-outline">ثبت درخواست رسیدگی <svg aria-hidden="true"><use href="#ks-i-arrow" /></svg></a></aside>
</div>
