@using lern.Infrastructure
@{ ViewData["SupportIntro"] = "برای ما، زیبایی لباس از انتخاب درست جزئیات شروع می‌شود."; }
@section Head { <partial name="_StructuredData" /> }
<div class="ks-support-page"><partial name="_Hero" />
    <section class="ks-about-story ks-panel"><div class="ks-story-copy"><span class="ks-eyebrow">درباره خرازی کوهستانی</span><h2>همراه ایده‌هایی که<br /><span>به لباس تبدیل می‌شوند.</span></h2><p>خرازی کوهستانی در بازار بزرگ تهران، در زمینه عرضه لوازم خیاطی، خرج کار لباس و یراق‌آلات فعالیت می‌کند. فروش عمده و خرده، امکان انتخاب محصول را برای خیاطان، مزون‌ها، تولیدی‌های پوشاک و علاقه‌مندان به دوخت فراهم می‌کند.</p><p>چه برای یک لباس خاص به دنبال جزئیات باشید و چه برای تولید به تعداد بیشتری نیاز داشته باشید، می‌توانید محصولات فروشگاه را بررسی کنید و برای انتخاب و هماهنگی خرید با ما تماس بگیرید.</p><a href="/shop" class="ks-text-link">انتخاب جزئیات لباس شما <svg aria-hidden="true"><use href="#ks-i-arrow" /></svg></a></div><figure class="ks-story-art"><img class="ks-bazaar-image" src="/assets/images/about/tehran-bazaar-shop.png" alt="تصویر کارتونی یک مغازه خرازی با نخ‌ها و روبان‌های رنگی در دالان آجری بازار بزرگ تهران" width="1536" height="1024" decoding="async" /><figcaption class="ks-bazaar-caption"><svg aria-hidden="true"><use href="#ks-i-pin" /></svg><span>از دل بازار بزرگ تهران<small>خرازی کوهستانی؛ همراه هنر شما</small></span></figcaption></figure></section>
    <div class="ks-feature-grid"><article class="ks-panel"><span class="ks-feature-icon"><svg aria-hidden="true"><use href="#ks-i-thread" /></svg></span><h2>جزئیات برای هر دوخت</h2><p>لوازم خیاطی، خرج کار لباس و یراق‌آلات برای تکمیل ایده‌های شما.</p></article><article class="ks-panel"><span class="ks-feature-icon ks-green"><svg aria-hidden="true"><use href="#ks-i-bag" /></svg></span><h2>خرید عمده و خرده</h2><p>از نیاز یک پروژه شخصی تا خرید برای مزون و تولیدی پوشاک.</p></article><article class="ks-panel"><span class="ks-feature-icon"><svg aria-hidden="true"><use href="#ks-i-chat" /></svg></span><h2>ارتباط مستقیم</h2><p>برای پرسیدن سوال و هماهنگی خرید، مستقیم با فروشگاه ارتباط بگیرید.</p></article></div>
    <aside class="ks-help-strip"><div><h2>برای انتخاب محصول سوال دارید؟</h2><p>درباره جنس، رنگ، اندازه و کاربرد محصول از ما بپرسید.</p></div><a href="/contact" class="ks-button ks-button-primary">تماس با فروشگاه <svg aria-hidden="true"><use href="#ks-i-phone" /></svg></a></aside>
</div>
